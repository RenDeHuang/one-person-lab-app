{
  "schema_version": 1,
  "owner": "one-person-lab-app",
  "purpose": "active_shell_adapter",
  "state": "active",
  "app_repo": "gaofeng21cn/one-person-lab-app",
  "active_shell": "aionui",
  "shell_root": "shells/aionui",
  "runtime_bridge_contract": "contracts/app-runtime-bridge.json",
  "upstream_family": "AionUI",
  "shell_source": {
    "owner_repo": "gaofeng21cn/opl-aion-shell",
    "default_ref": "main",
    "checkout_path": "shells/aionui",
    "history_policy": "external_checkout_not_merged_into_app_default_branch",
    "upstream_ref": "70974c59a275e565e8fc2bd7ecaf2dcac74227f0"
  },
  "app_remote": {
    "name": "origin",
    "url": "git@github.com:gaofeng21cn/one-person-lab-app.git",
    "main_branch": "main"
  },
  "upstream_remote": {
    "url": "https://github.com/iOfficeAI/AionUi",
    "main_branch": "main"
  },
  "release_role": "stable_app_shell",
  "gui_authority": {
    "source_of_truth": "one-person-lab-app",
    "implementation_role": "active_shell_implementation_carrier",
    "product_contracts": [
      "contracts/app-gui-product-contract.json",
      "contracts/app-runtime-bridge.json",
      "contracts/app-product-profile.json",
      "contracts/app-install-exposure-policy.json",
      "contracts/app-page-state-matrix.json",
      "contracts/app-first-run-test-matrix.json",
      "contracts/app-release-channel.json"
    ],
    "shell_may_own": [
      "concrete renderer implementation",
      "process and preload implementation",
      "shell package metadata",
      "shell tests and release hooks",
      "upstream AionUI intake",
      "shell-local implementation details",
      "shell-local tests that prove App contracts are implemented"
    ],
    "shell_must_not_own": [
      "App GUI product truth",
      "App user-facing page-state authority",
      "App model-selection policy",
      "App onboarding policy",
      "App release/user documentation authority",
      "App release gate policy",
      "OPL runtime truth",
      "domain truth",
      "provider implementation"
    ],
    "upstream_intake_policy": "check_against_app_owned_gui_contracts_before_acceptance"
  },
  "shell_replacement_policy": {
    "candidate_root_pattern": "shells/<candidate>",
    "candidate_state": "candidate_until_contracts_and_tests_complete",
    "authority_transfer_allowed": false,
    "adoption_gate": [
      "declare candidate in contracts/app-shell-candidates.json",
      "implement contracts/app-gui-product-contract.json",
      "sync App product profile into the candidate shell target",
      "pass App page-state and first-run matrices",
      "pass App-root active shell validation",
      "pass GUI package compile through App wrapper",
      "preserve external checkout history policy"
    ]
  },
  "shell_contract": {
    "layout_id": "aionui_v2_workspace",
    "source_topology": "root_workspace_with_desktop_package",
    "paths": {
      "package_manifest": "package.json",
      "agents_guide": "AGENTS.md",
      "vitest_config": "vitest.config.ts",
      "electron_builder_config": "packages/desktop/electron-builder.yml",
      "build_output_dir": "out",
      "product_profile_target": "packages/desktop/src/common/config/oplProductProfile/oplProductProfile.generated.json",
      "packaged_runtime_root": "packaged-runtimes/opl-full-runtime",
      "packaged_runtime_validator": "scripts/validate-packaged-runtime.js",
      "release_prepare_script": "scripts/prepare-release-assets.sh",
      "release_verify_script": "scripts/verify-release-assets.sh"
    },
    "capabilities": [
      "app_product_profile_generated_config",
      "electron_builder_release_packaging",
      "opl_packaged_runtime_extra_resource",
      "standard_release_asset_normalization",
      "standard_release_asset_verification",
      "app_managed_host_tool_bootstrap",
      "bundled_runtime_core_ready_without_host_node",
      "app_owned_gui_product_contract",
      "app_owned_runtime_bridge_contract",
      "opl_app_state_bridge",
      "opl_app_action_bridge",
      "app_gui_release_channel_gating"
    ]
  },
  "framework_boundary": {
    "framework_repo": "gaofeng21cn/one-person-lab",
    "app_consumes": [
      "OPL CLI JSON outputs",
      "framework contracts",
      "runtime snapshots",
      "provider receipts",
      "domain-owned projections"
    ],
    "app_does_not_own": [
      "runtime truth",
      "domain truth",
      "provider implementation",
      "domain artifact authority"
    ]
  },
  "validation_commands": [
    {
      "id": "install",
      "cwd": "shells/aionui",
      "command": "bun install --frozen-lockfile"
    },
    {
      "id": "i18n_types",
      "cwd": "shells/aionui",
      "command": "bun run i18n:types"
    },
    {
      "id": "i18n_check",
      "cwd": "shells/aionui",
      "command": "node scripts/check-i18n.js"
    },
    {
      "id": "typecheck",
      "cwd": "shells/aionui",
      "command": "bunx tsc --noEmit"
    },
    {
      "id": "test",
      "cwd": ".",
      "command": "bun run test"
    },
    {
      "id": "lint",
      "cwd": "shells/aionui",
      "command": "bun run lint"
    },
    {
      "id": "packaged_runtime_validation",
      "cwd": "shells/aionui",
      "command": "node scripts/validate-packaged-runtime.js --scan-all"
    }
  ],
  "gui_product_contract": "contracts/app-gui-product-contract.json",
  "gui_product_contract_policy": {
    "must_implement": true,
    "source_of_truth": "one-person-lab-app",
    "upstream_override_allowed": false,
    "upstream_family_role": "implementation_material_only",
    "aionui_upstream_must_not_override_app_truth": true
  },
  "state_surface_contract": {
    "primary_read_command": "opl app state --profile fast --json",
    "refresh_read_command": "opl app state --profile fast --json",
    "full_state_read_command": "opl app state --profile full --json",
    "full_state_policy": "diagnostic_or_release_evidence_only",
    "action_command": "opl app action execute --action <action_id> [--payload json] [--dry-run] --json",
    "full_drilldown_exception": "opl runtime app-operator-drilldown --detail full --json",
    "forbidden_gui_truth_sources": [
      "direct opl connect modules --json page aggregation",
      "direct opl system developer-supervisor page aggregation",
      "direct opl family-runtime worker status page aggregation",
      "application.systemInfo as OPL path truth",
      "application.appVersions as OPL release truth",
      "direct reads of OPL internal state files"
    ]
  },
  "upstream_intake": {
    "classification_policy": "classify_each_upstream_feature_before_app_release",
    "allowed_classifications": [
      "accepted",
      "rejected",
      "redirected",
      "requires_app_contract"
    ],
    "required_feature_record_fields": [
      "id",
      "upstream_surface",
      "classification",
      "app_contract_ref",
      "release_gate"
    ],
    "feature_classifications": [
      {
        "id": "aionui_team",
        "upstream_surface": "Team mode, /team routes, Team sidebar, Team-created redirects, and Team MCP snapshots",
        "classification": "rejected",
        "ordinary_surface": "forbidden",
        "app_contract_ref": "contracts/app-gui-product-contract.json#settings_navigation.team_surface_policy",
        "release_gate": "implementation_probes.aionui_team_disabled_surface"
      }
    ]
  },
  "implementation_probes": {
    "aionui_team_disabled_surface": {
      "source": "app_shell_upgrade_architecture_hardening",
      "policy": "fail_closed_required_for_active_shell_upgrade",
      "probes": [
        {
          "id": "team_mode_disabled",
          "source_ref": "contracts/app-gui-product-contract.json#settings_navigation.team_surface_policy",
          "required": true,
          "required_evidence": [
            "Team mode flag is false for ordinary App builds",
            "Team mode cannot be enabled from ordinary Settings"
          ]
        },
        {
          "id": "team_route_redirect",
          "source_ref": "contracts/app-gui-product-contract.json#settings_navigation.team_surface_policy",
          "required": true,
          "required_evidence": [
            "/team and /team/* routes redirect to the App-owned home path",
            "redirect does not create a Team conversation or Team workspace state"
          ]
        },
        {
          "id": "team_sidebar_gate",
          "source_ref": "contracts/app-gui-product-contract.json#settings_navigation.team_surface_policy",
          "required": true,
          "required_evidence": [
            "Team sidebar entry is not rendered for ordinary App users",
            "Team navigation cannot be reached through the ordinary sidebar model"
          ]
        },
        {
          "id": "team_created_redirect_noop",
          "source_ref": "contracts/app-gui-product-contract.json#settings_navigation.team_surface_policy",
          "required": true,
          "required_evidence": [
            "Team-created redirect events are no-ops in ordinary App mode",
            "Team-created redirects do not mutate the current conversation route"
          ]
        },
        {
          "id": "ordinary_conversation_team_snapshot_scrub",
          "source_ref": "contracts/app-gui-product-contract.json#settings_navigation.team_surface_policy",
          "required": true,
          "required_evidence": [
            "disabled Team MCP state is removed before ordinary conversation rendering",
            "disabled Team MCP state is removed before ordinary conversation inheritance"
          ]
        },
        {
          "id": "agent_switching_drops_team_mcp",
          "source_ref": "contracts/app-gui-product-contract.json#settings_navigation.team_surface_policy",
          "required": true,
          "required_evidence": [
            "agent switching keeps App profile MCP allowlist empty unless explicitly whitelisted",
            "agent switching does not inherit Team MCP from prior snapshots"
          ]
        },
        {
          "id": "team_deep_link_not_whitelisted",
          "source_ref": "contracts/app-gui-product-contract.json#settings_navigation.team_surface_policy",
          "required": true,
          "required_evidence": [
            "Team deep links are absent from App route whitelist",
            "Team deep links resolve through disabled-or-redirect handling"
          ]
        },
        {
          "id": "team_bridge_mutation_gate",
          "source_ref": "contracts/app-gui-product-contract.json#settings_navigation.team_surface_policy",
          "required": true,
          "required_evidence": [
            "Team create/add/remove/session mutations are rejected before HTTP when Team mode is disabled",
            "ordinary App mode cannot create or rebuild Team sessions through the IPC bridge"
          ]
        }
      ]
    }
  },
  "disabled_feature_policy": {
    "aionui_team": {
      "state": "disabled",
      "ordinary_surface": "rejected",
      "route_policy": "redirect_to_app_home",
      "mutation_policy": "team_created_redirect_noop",
      "deep_link_policy": "not_whitelisted",
      "capability_snapshot_policy": "scrub_before_render_or_inherit",
      "agent_switching_policy": "must_not_inherit_team_mcp"
    }
  }
}
