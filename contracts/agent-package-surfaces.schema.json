{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://onepersonlab.dev/contracts/agent-package-surfaces.schema.json",
  "title": "OPL App generic Package consumer surfaces",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "localized_text": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "zh-CN": { "type": "string", "minLength": 1 },
        "en-US": { "type": "string", "minLength": 1 }
      },
      "minProperties": 1
    },
    "home_shortcut": {
      "type": "object",
      "additionalProperties": true,
      "required": ["shortcut_id", "label_i18n", "default_visible", "user_configurable", "route"],
      "properties": {
        "shortcut_id": { "type": "string", "minLength": 1 },
        "label_i18n": { "$ref": "#/$defs/localized_text" },
        "default_visible": { "type": "boolean" },
        "user_configurable": { "type": "boolean" },
        "route": {
          "type": "object",
          "additionalProperties": true,
          "required": ["route_kind", "executor", "codex_visible_entry"],
          "properties": {
            "route_kind": { "const": "agent_package_shortcut" },
            "executor": { "type": "string", "minLength": 1 },
            "codex_visible_entry": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "projected_action": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action_id",
        "action_ref",
        "semantic",
        "surface",
        "payload",
        "required_payload_fields",
        "confirmation_required"
      ],
      "properties": {
        "action_id": { "type": "string", "minLength": 1 },
        "action_ref": { "type": "string", "pattern": "^app_state\\.actions#" },
        "semantic": { "type": "string", "minLength": 1 },
        "surface": { "type": "string", "minLength": 1 },
        "payload": { "type": "object" },
        "required_payload_fields": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "confirmation_required": { "type": "boolean" }
      }
    },
    "directory_entry": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "package_id",
        "package_kind",
        "package_role",
        "display_name",
        "description",
        "installed",
        "readiness",
        "available_actions"
      ],
      "properties": {
        "package_id": { "type": "string", "minLength": 1 },
        "package_kind": { "type": "string", "minLength": 1 },
        "package_role": { "type": "string", "minLength": 1 },
        "display_name": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "display_name_i18n": { "$ref": "#/$defs/localized_text" },
        "description_i18n": { "$ref": "#/$defs/localized_text" },
        "installed": { "type": "boolean" },
        "readiness": { "type": "object" },
        "home_shortcuts": {
          "type": "array",
          "items": { "$ref": "#/$defs/home_shortcut" }
        },
        "available_actions": {
          "type": "array",
          "items": { "$ref": "#/$defs/projected_action" }
        }
      }
    },
    "agent_package_activation_result": {
      "type": "object",
      "additionalProperties": true,
      "required": ["launch_state", "launch_allowed", "package_id", "launch_state_reason"],
      "properties": {
        "launch_state": { "enum": ["ready", "degraded", "package_unavailable"] },
        "launch_allowed": { "type": "boolean" },
        "package_id": { "type": "string", "minLength": 1 },
        "launch_state_reason": { "type": ["string", "null"] },
        "launch_blocked_reason": { "type": ["string", "null"] },
        "route_ready": { "type": "boolean" }
      }
    }
  }
}
