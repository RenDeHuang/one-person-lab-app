    "opl_package_manifest": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "package_id",
        "package_kind",
        "display_name",
        "publisher",
        "version",
        "source",
        "codex_surface",
        "skill_packs",
        "entrypoints",
        "health_check",
        "permissions",
        "update_channel",
        "rollback_ref"
      ],
      "properties": {
        "package_id": {
          "type": "string",
          "minLength": 1
        },
        "package_kind": {
          "enum": [
            "domain_agent_package",
            "framework_capability_package",
            "workflow_plugin_package"
          ]
        },
        "agent_id": {
          "type": "string",
          "minLength": 1
        },
        "display_name": {
          "type": "string",
          "minLength": 1
        },
        "publisher": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "distribution_payload": {
          "type": "object",
          "additionalProperties": true,
          "required": [
            "payload_kind",
            "payload_ref",
            "payload_digest_ref",
            "required_skill_pack_lock_refs",
            "proof_status",
            "live_download_proof",
            "installed_reload_proof",
            "oci_ref",
            "oci_media_type",
            "immutable_tag",
            "moving_tag",
            "promotion_policy",
            "install_truth"
          ],
          "properties": {
            "payload_kind": {
              "type": "string",
              "minLength": 1
            },
            "payload_ref": {
              "type": "string",
              "minLength": 1
            },
            "payload_digest_ref": {
              "type": "string",
              "pattern": "^oci-digest-lock://.+@sha256:[0-9a-f]{64}$"
            },
            "required_skill_pack_lock_refs": {
              "$ref": "#/$defs/string_array"
            },
            "proof_status": {
              "type": "string",
              "minLength": 1
            },
            "live_download_proof": {
              "const": false
            },
            "installed_reload_proof": {
              "const": false
            },
            "oci_ref": {
              "type": "string",
              "minLength": 1
            },
            "oci_media_type": {
              "type": "string",
              "minLength": 1
            },
            "immutable_tag": {
              "type": "string",
              "minLength": 1
            },
            "moving_tag": {
              "const": "latest-stable"
            },
            "promotion_policy": {
              "const": "daily_candidate_gates_then_promote_latest_stable"
            },
            "install_truth": {
              "const": "resolved_digest_lock"
            }
          }
        },
        "codex_surface": {
          "type": "object",
          "additionalProperties": true,
          "required": [
            "plugin_ids",
            "required_skill_ids"
          ],
          "properties": {
            "plugin_ids": {
              "$ref": "#/$defs/string_array"
            },
            "required_skill_ids": {
              "$ref": "#/$defs/string_array"
            },
            "optional_skill_ids": {
              "$ref": "#/$defs/string_array"
            },
            "plugin_source_path": {
              "type": "string",
              "minLength": 1
            },
            "plugin_source_ref": {
              "type": "string",
              "minLength": 1
            },
            "plugin_payload_manifest_url": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "skill_packs": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true,
            "required": [
              "id",
              "source_kind",
              "source",
              "version",
              "lock_ref",
              "install_mode"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "source_kind": {
                "enum": [
                  "repo_plugin_skill",
                  "opl_generated_plugin_surface"
                ]
              },
              "source": {
                "type": "string",
                "minLength": 1
              },
              "semantic_pack_root": {
                "type": "string",
                "minLength": 1
              },
              "generated_surface_owner": {
                "const": "one-person-lab"
              },
              "version": {
                "type": "string",
                "minLength": 1
              },
              "lock_ref": {
                "type": "string",
                "pattern": "^oci-digest-lock://.+@sha256:[0-9a-f]{64}(?:/.+)?$",
                "not": {
                  "const": "registry.version_source_ref"
                }
              },
              "install_mode": {
                "enum": [
                  "bundled_required",
                  "optional_ref"
                ]
              }
            }
          }
        },
        "entrypoints": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true,
            "required": [
              "shortcut_id",
              "label",
              "required_skill_ids",
              "shortcut_eligible"
            ],
            "properties": {
              "shortcut_id": {
                "type": "string",
                "minLength": 1
              },
              "label": {
                "type": "string",
                "minLength": 1
              },
              "required_skill_ids": {
                "$ref": "#/$defs/string_array"
              },
              "shortcut_eligible": {
                "type": "boolean"
              }
            }
          }
        },
        "health_check": {
          "type": "object",
          "additionalProperties": true,
          "required": [
            "kind",
            "required_surfaces"
          ],
          "properties": {
            "kind": {
              "const": "opl_package_receipt"
            },
            "required_surfaces": {
              "$ref": "#/$defs/string_array"
            }
          }
        },
        "permissions": {
          "type": "array"
        },
        "update_channel": {
          "type": "string",
          "minLength": 1
        },
        "rollback_ref": {
          "type": "string",
          "minLength": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "package_kind": {
                "const": "domain_agent_package"
              }
            }
          },
          "then": {
            "required": [
              "agent_id"
            ]
          },
          "else": {
            "not": {
              "required": [
                "agent_id"
              ]
            }
          }
        }
      ],
      "not": {
        "anyOf": [
          {
            "required": [
              "session_contract_ref"
            ]
          },
          {
            "required": [
              "domain_workflow_schema"
            ]
          },
          {
            "required": [
              "prompt_body"
            ]
          },
          {
            "required": [
              "artifact_schema"
            ]
          },
          {
            "required": [
              "readiness_verdict_rule"
            ]
          },
          {
            "required": [
              "quality_verdict_rule"
            ]
          },
          {
            "required": [
              "owner_receipt_authority"
            ]
          }
        ]
      }
    },
