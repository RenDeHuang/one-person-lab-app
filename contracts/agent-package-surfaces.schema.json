{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://onepersonlab.dev/contracts/agent-package-surfaces.schema.json",
  "title": "OPL Package Surfaces",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "opl_package_manifest": {
      "$ref": "#/$defs/opl_package_manifest"
    },
    "home_shortcut_metadata": {
      "$ref": "#/$defs/home_shortcut_metadata"
    },
    "invocation_receipt": {
      "$ref": "#/$defs/invocation_receipt"
    },
    "package_lock_receipt": {
      "$ref": "#/$defs/package_lock_receipt"
    },
    "agent_package_activation_request": {
      "$ref": "#/$defs/agent_package_activation_request"
    },
    "agent_package_activation_result": {
      "$ref": "#/$defs/agent_package_activation_result"
    },
    "agent_package_activation_action": {
      "$ref": "#/$defs/agent_package_activation_action"
    }
  },
  "$defs": {
    "string_array": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "agent_package_activation_request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "package_id",
        "scope",
        "use_boundary_id"
      ],
      "properties": {
        "package_id": {
          "type": "string",
          "minLength": 1
        },
        "scope": {
          "type": "string",
          "enum": ["workspace", "quest"]
        },
        "target_workspace": {
          "type": "string",
          "minLength": 1
        },
        "target_quest": {
          "type": "string",
          "minLength": 1
        },
        "use_boundary_id": {
          "type": "string",
          "minLength": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "scope": {"const": "workspace"}
            },
            "required": ["scope"]
          },
          "then": {
            "required": ["target_workspace"],
            "not": {"required": ["target_quest"]}
          }
        },
        {
          "if": {
            "properties": {
              "scope": {"const": "quest"}
            },
            "required": ["scope"]
          },
          "then": {
            "required": ["target_quest"],
            "not": {"required": ["target_workspace"]}
          }
        }
      ]
    },
    "agent_package_activation_result": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "launch_allowed",
        "use_receipt_ref",
        "use_binding"
      ],
      "properties": {
        "launch_allowed": {
          "type": "boolean"
        },
        "use_receipt_ref": {
          "type": "string",
          "minLength": 1
        },
        "use_binding": {
          "type": "object",
          "minProperties": 1
        }
      }
    },
    "agent_package_activation_action": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "action_id",
        "command_ref",
        "enabled",
        "preparation_status",
        "reason_code"
      ],
      "properties": {
        "action_id": {
          "const": "agent_package_activate"
        },
        "command_ref": {
          "const": "opl app action execute --action agent_package_activate --payload <json> --json"
        },
        "enabled": {
          "type": "boolean"
        },
        "preparation_status": {
          "type": "string",
          "enum": ["not_installed", "prepare_required", "ready"]
        },
        "reason_code": {
          "type": "string",
          "minLength": 1
        }
      },
      "oneOf": [
        {
          "properties": {
            "enabled": {"const": false},
            "preparation_status": {"const": "not_installed"},
            "reason_code": {"const": "package_not_installed"}
          }
        },
        {
          "properties": {
            "enabled": {"const": true},
            "preparation_status": {"const": "prepare_required"},
            "reason_code": {"const": "scope_reconciliation_required"}
          }
        },
        {
          "properties": {
            "enabled": {"const": true},
            "preparation_status": {"const": "ready"},
            "reason_code": {"const": "use_boundary_reconciliation_ready"}
          }
        }
      ]
    },
    "opl_package_manifest": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "package_id",
        "package_kind",
        "display_name",
        "publisher",
        "version",
        "source",
        "codex_surface",
        "skill_packs",
        "entrypoints",
        "health_check",
        "permissions",
        "update_channel",
        "rollback_ref"
      ],
      "properties": {
        "package_id": {
          "type": "string",
          "minLength": 1
        },
        "package_kind": {
          "enum": [
            "domain_agent_package",
            "framework_capability_package",
            "workflow_plugin_package"
          ]
        },
        "agent_id": {
          "type": "string",
          "minLength": 1
        },
        "display_name": {
          "type": "string",
          "minLength": 1
        },
        "publisher": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "distribution_payload": {
          "type": "object",
          "additionalProperties": true,
          "required": [
            "payload_kind",
            "payload_ref",
            "payload_digest_ref",
            "required_skill_pack_lock_refs",
            "proof_status",
            "live_download_proof",
            "installed_reload_proof",
            "oci_ref",
            "oci_media_type",
            "immutable_tag",
            "moving_tag",
            "promotion_policy",
            "install_truth"
          ],
          "properties": {
            "payload_kind": {
              "type": "string",
              "minLength": 1
            },
            "payload_ref": {
              "type": "string",
              "minLength": 1
            },
            "payload_digest_ref": {
              "type": "string",
              "pattern": "^oci-digest-lock://.+@sha256:[0-9a-f]{64}$"
            },
            "required_skill_pack_lock_refs": {
              "$ref": "#/$defs/string_array"
            },
            "proof_status": {
              "type": "string",
              "minLength": 1
            },
            "live_download_proof": {
              "const": false
            },
            "installed_reload_proof": {
              "const": false
            },
            "oci_ref": {
              "type": "string",
              "minLength": 1
            },
            "oci_media_type": {
              "type": "string",
              "minLength": 1
            },
            "immutable_tag": {
              "type": "string",
              "minLength": 1
            },
            "moving_tag": {
              "const": "latest-stable"
            },
            "promotion_policy": {
              "const": "daily_candidate_gates_then_promote_latest_stable"
            },
            "install_truth": {
              "const": "resolved_digest_lock"
            }
          }
        },
        "codex_surface": {
          "type": "object",
          "additionalProperties": true,
          "required": [
            "plugin_ids",
            "required_skill_ids"
          ],
          "properties": {
            "plugin_ids": {
              "$ref": "#/$defs/string_array"
            },
            "required_skill_ids": {
              "$ref": "#/$defs/string_array"
            },
            "optional_skill_ids": {
              "$ref": "#/$defs/string_array"
            },
            "plugin_source_path": {
              "type": "string",
              "minLength": 1
            },
            "plugin_source_ref": {
              "type": "string",
              "minLength": 1
            },
            "plugin_payload_manifest_url": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "skill_packs": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true,
            "required": [
              "id",
              "source_kind",
              "source",
              "version",
              "lock_ref",
              "install_mode"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "source_kind": {
                "enum": [
                  "repo_plugin_skill",
                  "opl_generated_plugin_surface"
                ]
              },
              "source": {
                "type": "string",
                "minLength": 1
              },
              "semantic_pack_root": {
                "type": "string",
                "minLength": 1
              },
              "generated_surface_owner": {
                "const": "one-person-lab"
              },
              "version": {
                "type": "string",
                "minLength": 1
              },
              "lock_ref": {
                "type": "string",
                "pattern": "^oci-digest-lock://.+@sha256:[0-9a-f]{64}(?:/.+)?$",
                "not": {
                  "const": "registry.version_source_ref"
                }
              },
              "install_mode": {
                "enum": [
                  "bundled_required",
                  "optional_ref"
                ]
              }
            }
          }
        },
        "entrypoints": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true,
            "required": [
              "shortcut_id",
              "label",
              "required_skill_ids",
              "shortcut_eligible"
            ],
            "properties": {
              "shortcut_id": {
                "type": "string",
                "minLength": 1
              },
              "label": {
                "type": "string",
                "minLength": 1
              },
              "required_skill_ids": {
                "$ref": "#/$defs/string_array"
              },
              "shortcut_eligible": {
                "type": "boolean"
              }
            }
          }
        },
        "health_check": {
          "type": "object",
          "additionalProperties": true,
          "required": [
            "kind",
            "required_surfaces"
          ],
          "properties": {
            "kind": {
              "const": "opl_package_receipt"
            },
            "required_surfaces": {
              "$ref": "#/$defs/string_array"
            }
          }
        },
        "permissions": {
          "type": "array"
        },
        "update_channel": {
          "type": "string",
          "minLength": 1
        },
        "rollback_ref": {
          "type": "string",
          "minLength": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "package_kind": {
                "const": "domain_agent_package"
              }
            }
          },
          "then": {
            "required": [
              "agent_id"
            ]
          },
          "else": {
            "not": {
              "required": [
                "agent_id"
              ]
            }
          }
        }
      ],
      "not": {
        "anyOf": [
          {
            "required": [
              "session_contract_ref"
            ]
          },
          {
            "required": [
              "domain_workflow_schema"
            ]
          },
          {
            "required": [
              "prompt_body"
            ]
          },
          {
            "required": [
              "artifact_schema"
            ]
          },
          {
            "required": [
              "readiness_verdict_rule"
            ]
          },
          {
            "required": [
              "quality_verdict_rule"
            ]
          },
          {
            "required": [
              "owner_receipt_authority"
            ]
          }
        ]
      }
    },
    "home_shortcut_metadata": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "shortcut_id",
        "package_id",
        "primary_label",
        "codex_visible_entry",
        "required_skill_ids",
        "source",
        "executor",
        "display_policy",
        "default_visible",
        "user_configurable"
      ],
      "properties": {
        "shortcut_id": {
          "type": "string",
          "minLength": 1
        },
        "package_id": {
          "type": "string",
          "minLength": 1
        },
        "primary_label": {
          "type": "string",
          "minLength": 1
        },
        "codex_visible_entry": {
          "type": "string",
          "minLength": 1
        },
        "required_skill_ids": {
          "$ref": "#/$defs/string_array"
        },
        "source": {
          "const": "opl_app_home"
        },
        "executor": {
          "const": "codex_cli"
        },
        "display_policy": {
          "type": "string",
          "minLength": 1
        },
        "default_visible": {
          "type": "boolean"
        },
        "user_configurable": {
          "type": "boolean"
        }
      }
    },
    "invocation_receipt": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "receipt_type",
        "executor",
        "package_id",
        "agent_id",
        "skill_ids",
        "source",
        "launched_from",
        "display_policy"
      ],
      "properties": {
        "receipt_type": {
          "const": "capability_invocation"
        },
        "executor": {
          "const": "codex_cli"
        },
        "package_id": {
          "type": "string",
          "minLength": 1
        },
        "agent_id": {
          "type": "string",
          "minLength": 1
        },
        "skill_ids": {
          "$ref": "#/$defs/string_array"
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "launched_from": {
          "type": "string",
          "minLength": 1
        },
        "display_policy": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "package_lock_receipt": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "package_id",
        "version_or_source_digest",
        "installed_at",
        "updated_at",
        "codex_visible_entry",
        "bundled_required_skill_ids",
        "optional_skill_refs",
        "source_kind",
        "trust_tier",
        "action_receipt_id",
        "rollback_ref",
        "physical_surface"
      ],
      "properties": {
        "package_id": {
          "type": "string",
          "minLength": 1
        },
        "version_or_source_digest": {
          "type": "string",
          "minLength": 1
        },
        "installed_at": {
          "type": "string",
          "minLength": 1
        },
        "updated_at": {
          "type": "string",
          "minLength": 1
        },
        "codex_visible_entry": {
          "type": "string",
          "minLength": 1
        },
        "bundled_required_skill_ids": {
          "$ref": "#/$defs/string_array"
        },
        "optional_skill_refs": {
          "$ref": "#/$defs/string_array"
        },
        "source_kind": {
          "type": "string",
          "minLength": 1
        },
        "trust_tier": {
          "type": "string",
          "minLength": 1
        },
        "action_receipt_id": {
          "type": "string",
          "minLength": 1
        },
        "rollback_ref": {
          "type": "string",
          "minLength": 1
        },
        "physical_surface": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "status": {
              "type": "string",
              "minLength": 1
            },
            "materialized_required_skill_ids": {
              "$ref": "#/$defs/string_array"
            },
            "materialized_required_skill_paths": {
              "$ref": "#/$defs/string_array"
            },
            "plugin_payload_manifest_url": {
              "type": "string",
              "minLength": 1
            },
            "plugin_payload_manifest_sha256": {
              "type": "string",
              "minLength": 1
            },
            "plugin_payload_cache_path": {
              "type": "string",
              "minLength": 1
            },
            "reload_required": {
              "type": "boolean"
            }
          }
        },
        "oci_ref": {
          "type": "string",
          "minLength": 1
        },
        "resolved_digest": {
          "type": "string",
          "minLength": 1
        },
        "moving_tag": {
          "const": "latest-stable"
        }
      }
    }
  }
}
