{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://onepersonlab.dev/contracts/agent-package-surfaces.schema.json",
  "title": "OPL Package Surfaces",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "external_agent_package_registry": {
      "$ref": "#/$defs/external_agent_package_registry"
    },
    "agent_package_registry_entry": {
      "$ref": "#/$defs/agent_package_registry_entry"
    },
    "opl_package_manifest": {
      "$ref": "#/$defs/opl_package_manifest"
    },
    "home_shortcut_metadata": {
      "$ref": "#/$defs/home_shortcut_metadata"
    },
    "invocation_receipt": {
      "$ref": "#/$defs/invocation_receipt"
    },
    "package_lock_receipt": {
      "$ref": "#/$defs/package_lock_receipt"
    },
    "agent_package_activation_request": {
      "$ref": "#/$defs/agent_package_activation_request"
    },
    "agent_package_activation_result": {
      "$ref": "#/$defs/agent_package_activation_result"
    },
    "agent_package_recovery_readback": {
      "$ref": "#/$defs/agent_package_recovery_readback"
    },
    "agent_package_use_binding": {
      "$ref": "#/$defs/agent_package_use_binding"
    },
    "agent_package_activation_action": {
      "$ref": "#/$defs/agent_package_activation_action"
    },
    "agent_package_use_boundary_action": {
      "$ref": "#/$defs/agent_package_use_boundary_action"
    },
    "agent_package_session_launch_projection": {
      "$ref": "#/$defs/agent_package_session_launch_projection"
    }
  },
  "$defs": {
    "string_array": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "external_agent_package_registry": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "owner",
        "purpose",
        "state",
        "version",
        "registry_id",
        "registry_name",
        "registry_source_kind",
        "registry_url",
        "discovery_only",
        "install_authority_allowed",
        "empty_registry_allowed",
        "canonical_first_party_entries_allowed",
        "first_party_trust_claims_allowed",
        "reserved_identity_source_ref",
        "reserved_identity_collision_failure_code",
        "entries"
      ],
      "properties": {
        "owner": {"const": "one-person-lab-app"},
        "purpose": {"const": "external_agent_package_registry_catalog_contract"},
        "state": {"const": "active_external_discovery_contract"},
        "version": {"const": 2},
        "registry_id": {"const": "opl-default-external-agent-registry"},
        "registry_name": {"type": "string", "minLength": 1},
        "registry_source_kind": {"const": "default_external_registry"},
        "registry_url": {"type": "string", "minLength": 1},
        "discovery_only": {"const": true},
        "install_authority_allowed": {"const": false},
        "empty_registry_allowed": {"const": true},
        "canonical_first_party_entries_allowed": {"const": false},
        "first_party_trust_claims_allowed": {"const": false},
        "reserved_identity_source_ref": {
          "const": "contracts/app-product-profile.json#gui.agent_package_registry.canonical_first_party_package_ids"
        },
        "reserved_identity_collision_failure_code": {
          "const": "agent_package_registry_first_party_identity_collision"
        },
        "entries": {
          "type": "array",
          "items": {"$ref": "#/$defs/agent_package_registry_entry"}
        }
      }
    },
    "agent_package_registry_entry": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "package_id",
        "package_kind",
        "display_name",
        "publisher",
        "description",
        "tags",
        "package_role",
        "source",
        "manifest_url",
        "version_source_ref",
        "selected_version",
        "stable_version",
        "manifest_validation",
        "trust_tier"
      ],
      "properties": {
        "package_id": {
          "type": "string",
          "minLength": 1,
          "not": {
            "enum": [
              "mas",
              "mag",
              "rca",
              "oma",
              "obf",
              "mas-scholar-skills",
              "opl-flow"
            ]
          }
        },
        "package_kind": {
          "type": "string",
          "minLength": 1
        },
        "display_name": {
          "type": "string",
          "minLength": 1
        },
        "publisher": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "tags": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        },
        "package_role": {
          "type": "string",
          "enum": [
            "standard_agent",
            "framework_capability_package",
            "workflow_profile"
          ]
        },
        "source": {
          "type": "string",
          "minLength": 1,
          "not": {
            "pattern": "^\\s*[Ff][Ii][Rr][Ss][Tt][^A-Za-z0-9]*[Pp][Aa][Rr][Tt][Yy]"
          }
        },
        "manifest_url": {
          "type": "string",
          "minLength": 1
        },
        "version_source_ref": {
          "type": "string",
          "minLength": 1,
          "pattern": "#/version$"
        },
        "selected_version": {
          "type": ["string", "null"],
          "minLength": 1,
          "pattern": "\\S"
        },
        "stable_version": {
          "type": ["string", "null"],
          "minLength": 1,
          "pattern": "\\S"
        },
        "manifest_validation": {
          "type": "string",
          "enum": ["deferred", "fetched_manifest", "catalog_inline_manifest"]
        },
        "trust_tier": {
          "type": "string",
          "minLength": 1,
          "not": {"pattern": "^\\s*[Ff][Ii][Rr][Ss][Tt][^A-Za-z0-9]*[Pp][Aa][Rr][Tt][Yy]"}
        }
      },
      "oneOf": [
        {
          "properties": {
            "manifest_validation": {"const": "deferred"},
            "selected_version": {"type": "null"},
            "stable_version": {"type": "null"}
          }
        },
        {
          "properties": {
            "manifest_validation": {
              "enum": ["fetched_manifest", "catalog_inline_manifest"]
            },
            "selected_version": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "stable_version": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          }
        }
      ]
    },
    "agent_package_activation_request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "package_id",
        "scope",
        "use_boundary_id"
      ],
      "properties": {
        "package_id": {
          "type": "string",
          "minLength": 1
        },
        "scope": {
          "type": "string",
          "enum": ["workspace", "quest"]
        },
        "target_workspace": {
          "type": "string",
          "minLength": 1
        },
        "target_quest": {
          "type": "string",
          "minLength": 1
        },
        "use_boundary_id": {
          "type": "string",
          "minLength": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "scope": {"const": "workspace"}
            },
            "required": ["scope"]
          },
          "then": {
            "required": ["target_workspace"],
            "not": {"required": ["target_quest"]}
          }
        },
        {
          "if": {
            "properties": {
              "scope": {"const": "quest"}
            },
            "required": ["scope"]
          },
          "then": {
            "required": ["target_quest"],
            "not": {"required": ["target_workspace"]}
          }
        }
      ]
    },
    "agent_package_owner_language_version": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scheme", "value"],
      "properties": {
        "scheme": {"const": "pep440"},
        "value": {"type": "string", "minLength": 1}
      }
    },
    "agent_package_carrier_authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "surface_kind",
        "status",
        "catalog_ref",
        "catalog_sha256",
        "catalog_owner_source_commit",
        "manifest_carrier_source_commit",
        "payload_source_commit",
        "verified_source_commit"
      ],
      "properties": {
        "surface_kind": {"const": "opl_agent_package_carrier_authority.v1"},
        "status": {"const": "verified"},
        "catalog_ref": {"type": "string", "minLength": 1},
        "catalog_sha256": {"type": "string", "minLength": 1},
        "catalog_owner_source_commit": {"type": "string", "minLength": 1},
        "manifest_carrier_source_commit": {"type": "string", "minLength": 1},
        "payload_source_commit": {"type": "string", "minLength": 1},
        "verified_source_commit": {"type": "string", "minLength": 1}
      }
    },
    "agent_package_use_binding_package": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "package_id",
        "package_version",
        "owner_language_version",
        "package_lock_ref",
        "manifest_sha256",
        "content_digest",
        "source_artifact_ref",
        "artifact_digest",
        "owner_source_commit",
        "carrier_authority"
      ],
      "properties": {
        "package_id": {"type": "string", "minLength": 1},
        "package_version": {"type": "string", "minLength": 1},
        "owner_language_version": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/agent_package_owner_language_version"}
          ]
        },
        "package_lock_ref": {"type": "string", "minLength": 1},
        "manifest_sha256": {"type": "string", "minLength": 1},
        "content_digest": {"type": "string", "minLength": 1},
        "source_artifact_ref": {"type": ["string", "null"], "minLength": 1},
        "artifact_digest": {"type": ["string", "null"], "minLength": 1},
        "owner_source_commit": {"type": ["string", "null"], "minLength": 1},
        "carrier_authority": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/agent_package_carrier_authority"}
          ]
        }
      }
    },
    "agent_package_use_binding_core_readiness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "required_skill_ids", "materialized_skill_ids"],
      "properties": {
        "status": {"enum": ["not_required", "missing", "current", "incompatible"]},
        "required_skill_ids": {"$ref": "#/$defs/string_array"},
        "materialized_skill_ids": {"$ref": "#/$defs/string_array"}
      }
    },
    "agent_package_use_binding_specialty_exposure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "declared_skill_ids", "materialized_skill_ids", "missing_skill_ids"],
      "properties": {
        "status": {"enum": ["not_required", "current", "degraded"]},
        "declared_skill_ids": {"$ref": "#/$defs/string_array"},
        "materialized_skill_ids": {"$ref": "#/$defs/string_array"},
        "missing_skill_ids": {"$ref": "#/$defs/string_array"}
      }
    },
    "agent_package_use_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "surface_kind",
        "use_boundary_id",
        "use_receipt_ref",
        "root_package",
        "provider_packages",
        "dependency_closure_digest",
        "freshness_mode",
        "latest_verified",
        "checked_at",
        "refresh_outcome",
        "channel_ref",
        "channel_digest",
        "scope",
        "target_root",
        "core_skill_tree_digest",
        "skill_tree_digest",
        "core_readiness",
        "specialty_exposure"
      ],
      "properties": {
        "surface_kind": {"const": "opl_agent_package_use_binding.v1"},
        "use_boundary_id": {"type": "string", "minLength": 1},
        "use_receipt_ref": {"type": "string", "minLength": 1},
        "root_package": {"$ref": "#/$defs/agent_package_use_binding_package"},
        "provider_packages": {
          "type": "array",
          "items": {"$ref": "#/$defs/agent_package_use_binding_package"}
        },
        "dependency_closure_digest": {"type": "string", "minLength": 1},
        "freshness_mode": {"enum": ["channel_verified", "offline_lkg"]},
        "latest_verified": {"type": "boolean"},
        "checked_at": {"type": "string", "minLength": 1},
        "refresh_outcome": {"enum": ["updated", "current", "recovered_last_known_good"]},
        "channel_ref": {"type": ["string", "null"], "minLength": 1},
        "channel_digest": {"type": ["string", "null"], "minLength": 1},
        "scope": {"enum": ["workspace", "quest"]},
        "target_root": {"type": "string", "minLength": 1},
        "core_skill_tree_digest": {"type": ["string", "null"], "minLength": 1},
        "skill_tree_digest": {"type": ["string", "null"], "minLength": 1},
        "core_readiness": {"$ref": "#/$defs/agent_package_use_binding_core_readiness"},
        "specialty_exposure": {"$ref": "#/$defs/agent_package_use_binding_specialty_exposure"}
      }
    },
    "agent_package_recovery_readback": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "surface_kind",
        "vocabulary_version",
        "status",
        "launch_blocked_reason",
        "managed_update_lock",
        "recovery_action",
        "recovery_action_state",
        "recovery_action_executable",
        "recovery_action_ref"
      ],
      "properties": {
        "surface_kind": {"const": "opl_agent_package_recovery_readback"},
        "vocabulary_version": {"const": "opl-agent-package-recovery.v1"},
        "status": {
          "enum": ["not_required", "recovery_in_progress", "recovery_required", "recovered"]
        },
        "launch_blocked_reason": {
          "type": ["string", "null"],
          "enum": [null, "package_recovery_in_progress", "package_recovery_required"]
        },
        "managed_update_lock": {
          "type": "object",
          "additionalProperties": true,
          "required": ["status"],
          "properties": {
            "status": {"type": "string", "minLength": 1}
          }
        },
        "recovery_action": {"type": ["string", "null"]},
        "recovery_action_state": {
          "enum": ["not_required", "wait_only", "executable", "manual_owner_intervention_required"]
        },
        "recovery_action_executable": {"type": "boolean"},
        "recovery_action_ref": {"type": ["string", "null"], "minLength": 1}
      },
      "oneOf": [
        {
          "properties": {
            "status": {"const": "recovery_in_progress"},
            "launch_blocked_reason": {"const": "package_recovery_in_progress"},
            "recovery_action_state": {"const": "wait_only"},
            "recovery_action_executable": {"const": false},
            "recovery_action_ref": {"type": "null"}
          }
        },
        {
          "properties": {
            "status": {"const": "recovery_required"},
            "launch_blocked_reason": {"const": "package_recovery_required"},
            "recovery_action_state": {"const": "executable"},
            "recovery_action_executable": {"const": true},
            "recovery_action_ref": {"const": "app_state.actions#agent_package_repair"}
          }
        },
        {
          "properties": {
            "status": {"const": "recovery_required"},
            "launch_blocked_reason": {"const": "package_recovery_required"},
            "recovery_action_state": {"const": "manual_owner_intervention_required"},
            "recovery_action_executable": {"const": false},
            "recovery_action_ref": {"type": "null"}
          }
        },
        {
          "properties": {
            "status": {"enum": ["not_required", "recovered"]},
            "launch_blocked_reason": {"type": "null"},
            "recovery_action_state": {"const": "not_required"},
            "recovery_action_executable": {"const": false},
            "recovery_action_ref": {"type": "null"}
          }
        }
      ]
    },
    "agent_package_activation_result": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "launch_allowed",
        "use_boundary_id"
      ],
      "properties": {
        "launch_allowed": {
          "type": "boolean"
        },
        "use_boundary_id": {
          "type": "string",
          "minLength": 1
        },
        "launch_blocked_reason": {
          "type": ["string", "null"],
          "minLength": 1,
          "not": {"enum": ["recovery_in_progress", "recovery_required"]}
        },
        "use_receipt_ref": {
          "type": ["string", "null"],
          "minLength": 1
        },
        "use_binding": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/agent_package_use_binding"}
          ]
        },
        "package_use_binding": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/agent_package_use_binding"}
          ]
        }
      },
      "dependentRequired": {
        "package_use_binding": ["use_binding"]
      },
      "oneOf": [
        {
          "properties": {
            "launch_allowed": {"const": true},
            "launch_blocked_reason": {"type": "null"},
            "use_receipt_ref": {"type": "string", "minLength": 1},
            "use_binding": {"$ref": "#/$defs/agent_package_use_binding"}
          },
          "required": ["use_receipt_ref", "use_binding"]
        },
        {
          "properties": {
            "launch_allowed": {"const": false},
            "launch_blocked_reason": {"type": "string", "minLength": 1},
            "use_receipt_ref": {"type": "null"},
            "use_binding": {"type": "null"},
            "package_use_binding": {"type": "null"}
          },
          "required": ["launch_blocked_reason"]
        }
      ]
    },
    "agent_package_activation_action": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "action_id",
        "command_ref",
        "enabled",
        "preparation_status",
        "reason_code"
      ],
      "properties": {
        "action_id": {
          "const": "agent_package_activate"
        },
        "command_ref": {
          "const": "opl app action execute --action agent_package_activate --payload <json> --json"
        },
        "enabled": {
          "type": "boolean"
        },
        "preparation_status": {
          "type": "string",
          "enum": ["not_installed", "prepare_required", "ready"]
        },
        "reason_code": {
          "type": "string",
          "minLength": 1
        }
      },
      "oneOf": [
        {
          "properties": {
            "enabled": {"const": false},
            "preparation_status": {"const": "not_installed"},
            "reason_code": {"const": "package_not_installed"}
          }
        },
        {
          "properties": {
            "enabled": {"const": true},
            "preparation_status": {"const": "prepare_required"},
            "reason_code": {"const": "scope_reconciliation_required"}
          }
        },
        {
          "properties": {
            "enabled": {"const": true},
            "preparation_status": {"const": "ready"},
            "reason_code": {"const": "use_boundary_reconciliation_ready"}
          }
        },
        {
          "properties": {
            "enabled": {"const": false},
            "preparation_status": {"enum": ["prepare_required", "ready"]},
            "reason_code": {
              "enum": [
                "package_disabled",
                "recovery_in_progress",
                "recovery_required",
                "recovery_owner_intervention_required",
                "status_unavailable"
              ]
            }
          }
        }
      ]
    },
    "agent_package_use_boundary_action": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "surface_kind",
        "action_id",
        "action_ref",
        "payload",
        "required_payload_fields",
        "confirmation_required",
        "use_boundary_id",
        "directory_entry_ref",
        "readiness_ref",
        "enabled",
        "preparation_status",
        "reason_code",
        "blocker"
      ],
      "properties": {
        "surface_kind": {
          "const": "opl_agent_package_use_boundary_action.v1"
        },
        "action_id": {
          "const": "agent_package_activate"
        },
        "action_ref": {
          "const": "app_state.actions#agent_package_activate"
        },
        "payload": {
          "$ref": "#/$defs/agent_package_activation_request"
        },
        "required_payload_fields": {
          "const": [
            "package_id",
            "scope",
            "target_workspace or target_quest",
            "use_boundary_id"
          ]
        },
        "confirmation_required": {
          "const": false
        },
        "use_boundary_id": {
          "type": "string",
          "minLength": 1
        },
        "directory_entry_ref": {
          "type": "string",
          "minLength": 1
        },
        "readiness_ref": {
          "type": "string",
          "minLength": 1
        },
        "enabled": {
          "type": "boolean"
        },
        "preparation_status": {
          "type": "string",
          "enum": ["activation_required", "verification_deferred", "ready", "blocked"]
        },
        "reason_code": {
          "type": "string",
          "minLength": 1,
          "not": {"enum": ["recovery_in_progress", "recovery_required"]}
        },
        "blocker": {
          "oneOf": [
            {"type": "null"},
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["code", "source_ref", "reason", "recovery_action_ref"],
              "properties": {
                "code": {
                  "type": "string",
                  "minLength": 1,
                  "not": {"enum": ["recovery_in_progress", "recovery_required"]}
                },
                "source_ref": {"type": "string", "minLength": 1},
                "reason": {"type": "string", "minLength": 1},
                "recovery_action_state": {
                  "enum": ["wait_only", "executable", "manual_owner_intervention_required"]
                },
                "recovery_action_executable": {"type": "boolean"},
                "recovery_action_ref": {"type": ["string", "null"], "minLength": 1}
              },
              "allOf": [
                {
                  "if": {
                    "properties": {
                      "code": {"const": "package_recovery_in_progress"}
                    },
                    "required": ["code"]
                  },
                  "then": {
                    "required": ["recovery_action_state", "recovery_action_executable"],
                    "properties": {
                      "recovery_action_state": {"const": "wait_only"},
                      "recovery_action_executable": {"const": false},
                      "recovery_action_ref": {"type": "null"}
                    }
                  }
                },
                {
                  "if": {
                    "properties": {
                      "code": {"const": "package_recovery_required"}
                    },
                    "required": ["code"]
                  },
                  "then": {
                    "required": ["recovery_action_state", "recovery_action_executable"],
                    "oneOf": [
                      {
                        "properties": {
                          "recovery_action_state": {"const": "executable"},
                          "recovery_action_executable": {"const": true},
                          "recovery_action_ref": {"const": "app_state.actions#agent_package_repair"}
                        }
                      },
                      {
                        "properties": {
                          "recovery_action_state": {"const": "manual_owner_intervention_required"},
                          "recovery_action_executable": {"const": false},
                          "recovery_action_ref": {"type": "null"}
                        }
                      }
                    ]
                  }
                }
              ]
            }
          ]
        }
      },
      "oneOf": [
        {
          "properties": {
            "enabled": {"const": true},
            "preparation_status": {
              "enum": ["activation_required", "verification_deferred", "ready"]
            },
            "blocker": {"type": "null"}
          }
        },
        {
          "properties": {
            "enabled": {"const": false},
            "preparation_status": {"const": "blocked"},
            "blocker": {"type": "object"}
          }
        }
