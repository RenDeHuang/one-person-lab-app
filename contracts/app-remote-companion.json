{
  "schema": "opl_app_remote_companion.v1",
  "owner": "one-person-lab-app",
  "purpose": "app_owned_ios_remote_companion_product_and_transport_contract",
  "state": "approved_product_plan_source_not_implemented",
  "contract_boundary": "This contract defines the iOS companion surface and its transport boundary. It does not own Codex runtime, thread history, provider state, domain state, cloud workspace state, or Ably service implementation.",
  "product_identity": {
    "app_store_name": "One Person Lab: AI Companion",
    "home_screen_name": "OPL",
    "in_app_brand_name": "One Person Lab",
    "subtitle_en": "Your AI workbench, anywhere",
    "subtitle_zh_cn": "随时连接你的桌面 AI 工作台",
    "internal_surface_id": "remote_companion",
    "product_role": "remote_companion_channel_not_a_runtime_or_third_workbench",
    "full_workbench_surfaces": [
      "desktop_app",
      "desktop_webui"
    ],
    "local_ios_runtime": false,
    "local_ios_task_history_authority": false,
    "local_ios_provider_or_model_authority": false,
    "local_ios_agent_package_authority": false
  },
  "surface_boundary": {
    "primary_user_outcomes": [
      "pair_one_phone_with_one_running_desktop_installation",
      "see_canonical_task_list_and_current_task_state",
      "read_streaming_task_output",
      "send_text_to_the_bound_canonical_task",
      "start_a_new_canonical_task_with_desktop_defaults",
      "stop_an_active_turn",
      "respond_to_an_owner_projected_approval_request",
      "receive_a_generic_task_update_notification"
    ],
    "deferred_outcomes": [
      "arbitrary_shell_or_terminal_commands",
      "remote_file_upload_or_file_system_mutation",
      "provider_model_reasoning_or_permission_policy_editing",
      "package_install_update_or_uninstall",
      "offline_command_queueing",
      "multi_user_shared_workspace_or_cloud_task_migration"
    ],
    "forbidden_claims": [
      "codex_runtime_is_running_on_the_iphone",
      "the_phone_is_a_second_codex_client_or_session_store",
      "an_ably_message_is_the_canonical_task_history",
      "a_connected_transport_proves_task_or_provider_readiness",
      "a_push_notification_contains_or_confirms_sensitive_task_content"
    ],
    "desktop_default_following_policy": "ios_follows_the_bound_desktop_canonical_thread_host_model_permission_and_agent_configuration_without_exposing_editors_in_mvp"
  },
  "transport": {
    "provider": "ably",
    "selection_status": "approved_for_mvp",
    "replacement_boundary": "opl_remote_transport.v1",
    "token_broker_runtime": "cloudflare_workers",
    "pairing_registry": "cloudflare_d1",
    "cloudflare_plan": "free_until_measured_limits_require_upgrade",
    "connection_model": "desktop_and_ios_each_initiate_outbound_wss_443_connections",
    "public_desktop_address_required": false,
    "lan_or_vpn_configuration_required": false,
    "client_api_key_embedded": false,
    "authentication": {
      "mode": "short_lived_token_auth",
      "token_issuer": "opl_cloud_remote_companion_token_broker",
      "client_authentication": "pair_id_device_id_and_random_256_bit_device_credential_with_only_sha256_hash_stored_by_the_broker",
      "token_ttl_minutes": 15,
      "automatic_refresh": true,
      "requested_capabilities": {
        "ios": {
          "opl:v1:pair:<opaque_pair_id>:command": [
            "publish"
          ],
          "opl:v1:pair:<opaque_pair_id>:event": [
            "subscribe"
          ],
          "opl:v1:pair:<opaque_pair_id>:presence": [
            "presence",
            "subscribe"
          ]
        },
        "desktop": {
          "opl:v1:pair:<opaque_pair_id>:command": [
            "subscribe"
          ],
          "opl:v1:pair:<opaque_pair_id>:event": [
            "publish"
          ],
          "opl:v1:pair:<opaque_pair_id>:presence": [
            "presence",
            "subscribe"
          ]
        },
        "ios_notifications_optional": {
          "opl:v1:pair:<opaque_pair_id>:event": [
            "push-subscribe"
          ]
        }
      },
      "history_capability": false,
      "stats_capability": false,
      "channel_metadata_capability": false,
      "push_admin_capability": false,
      "token_reuse_across_pairs": false
    },
    "channel_policy": {
      "namespace": "opl:v1:pair:<opaque_pair_id>",
      "ios_command_channel": "opl:v1:pair:<opaque_pair_id>:command",
      "desktop_event_channel": "opl:v1:pair:<opaque_pair_id>:event",
      "presence_channel": "opl:v1:pair:<opaque_pair_id>:presence",
      "wildcard_segments_use_ably_colon_delimiter": true,
      "client_token_wildcard_capability": false,
      "directional_publish_roles_enforced": true,
      "ids_must_be_opaque": true,
      "user_text_or_workspace_path_in_channel_name": false,
      "presence": "pair_presence_only",
      "history": "disabled_for_business_reads",
      "cloud_queueing_of_commands": false,
      "transport_message_envelope": "encrypted_event_with_request_id_and_protocol_version",
      "stream_batching": "coalesce_output_deltas_by_100_to_250_ms_or_4_kib_whichever_occurs_first_and_flush_on_terminal_state"
    },
    "payload_confidentiality": {
      "required": true,
      "scheme": "x25519_key_agreement_hkdf_sha256_two_directional_aes_256_gcm_keys",
      "key_authority": "desktop_and_ios_pair_only",
      "ably_plaintext_task_content": false,
      "cloud_plaintext_task_content": false,
      "key_rotation": "new_pair_specific_device_keypairs_on_repair_or_explicit_repair_pairing",
      "aead_associated_data": "protocol_version_pair_id_device_id_key_epoch_and_channel_direction",
      "nonce_policy": "cryptographically_random_96_bit_nonce_with_duplicate_rejection_per_directional_key",
      "replay_protection": "pair_key_epoch_plus_per_sender_monotonic_sequence_and_request_id"
    },
    "usage_guardrails": {
      "plan": "free",
      "limits_reference": "https://ably.com/pricing",
      "snapshot_checked_on": "2026-08-16",
      "concurrent_connections": 200,
      "messages_per_month": 6000000,
      "messages_per_second": 500,
      "monitoring_warning_percent": 70,
      "plan_review_percent": 85,
      "new_pairing_gate_percent": 95,
      "existing_pair_fail_open_during_quota_warning": true,
      "limits_must_be_rechecked_before_public_release": true
    }
  },
  "pairing": {
    "user_flow": "desktop_start_pairing_then_ios_scan_one_time_qr_then_desktop_confirm_then_ios_enters_companion",
    "account_required": false,
    "primary_method": "one_time_qr",
    "fallback_method": "short_lived_manual_pairing_code",
    "manual_code_policy": "12_character_crockford_base32_random_code_server_keyed_hmac_sha256_storage_5_minute_expiry_max_5_attempts_then_atomic_pairing_invalidation",
    "qr_payload": [
      "broker_route",
      "opaque_pairing_id",
      "one_time_random_256_bit_qr_claim_secret",
      "desktop_pair_specific_public_key",
      "short_lived_pairing_expiry"
    ],
    "qr_payload_must_not_include": [
      "ably_api_key",
      "desktop_public_ip_or_port",
      "workspace_path",
      "task_text",
      "long_lived_access_token",
      "plaintext_pair_master_key"
    ],
    "claim_protocol": [
      "desktop_creates_single_use_pairing_record_random_256_bit_qr_claim_secret_and_pair_specific_x25519_keypair",
      "broker_stores_only_the_salted_hash_of_the_qr_claim_secret_and_the_qr_carries_the_plaintext_secret_once",
      "ios_creates_a_pair_specific_x25519_keypair_and_submits_pairing_id_claim_secret_and_public_key_to_the_broker",
      "desktop_reads_the_claim_and_both_devices_display_the_same_short_authentication_string_derived_from_pairing_id_and_both_public_keys",
      "desktop_requires_local_confirmation_after_the_user_compares_the_short_authentication_string",
      "desktop_and_ios_derive_the_pair_master_key_locally_with_x25519_and_hkdf_without_transmitting_it",
      "broker_atomically_marks_pairing_claimed_and_returns_one_time_random_device_credentials_whose_hashes_are_persisted",
      "both_clients_request_pair_scoped_ably_tokens_with_their_device_credentials"
    ],
    "broker_persistence": {
      "allowed": [
        "opaque_pairing_id",
        "salted_single_use_claim_secret_or_manual_code_hash",
        "pair_specific_public_keys",
        "expiry_and_claim_state",
        "device_credential_sha256_hashes",
        "revoked_device_hash"
      ],
      "forbidden": [
        "task_history",
        "task_content",
        "workspace_files",
        "ably_api_keys",
        "plaintext_pair_master_key",
        "plaintext_device_credential"
      ],
      "atomic_claim_required": true,
      "retention": "delete_unclaimed_records_after_expiry_and_delete_claim_metadata_after_pair_revocation_plus_bounded_retention"
    },
    "device_lifecycle": {
      "mvp_max_companion_devices_per_desktop_installation": 3,
      "device_label_user_editable": true,
      "revoke_action": "desktop_or_ios_explicit_revoke_pair",
      "revoke_effect": "atomically_mark_pair_revoked_deny_future_tokens_detach_desktop_from_pair_channels_delete_desktop_pair_key_and_require_new_qr_pairing",
      "existing_token_policy": "an_already_issued_token_may_remain_transport_valid_until_its_15_minute_expiry_but_the_desktop_must_no_longer_publish_subscribe_or_execute_for_that_pair_after_terminal_revoke_readback",
      "provider_token_revocation": "optional_defense_in_depth_not_required_for_application_level_revocation",
      "revoke_does_not_delete_canonical_tasks": true
    }
  },
  "action_policy": {
    "action_authority": "desktop_canonical_app_action_bridge",
    "request_required_fields": [
      "protocol_version",
      "pair_id",
      "device_id",
      "key_epoch",
      "nonce",
      "encrypted_payload"
    ],
    "encrypted_request_fields": [
      "request_id",
      "canonical_thread_id_or_new_task_intent",
      "client_sequence",
      "action_id",
      "action_payload"
    ],
    "mvp_allowed_actions": [
      "canonical_task.list",
      "canonical_task.read",
      "canonical_task.refresh",
      "canonical_task.start",
      "canonical_task.send_text",
      "canonical_turn.stop",
      "canonical_approval.respond",
      "pair.revoke"
    ],
    "action_requirements": {
      "canonical_task.send_text": "desktop_validates_bound_thread_and_deduplicates_request_id_before_turn_start",
      "canonical_task.start": "desktop_uses_current_default_workspace_model_permission_and_agent_projection",
      "canonical_turn.stop": "desktop_routes_to_the_current_canonical_turn_only",
      "canonical_approval.respond": "allow_only_owner_projected_low_or_medium_impact_approvals_with_explicit_confirmation_and_route_through_the_existing_app_action_bridge; high_impact_approvals_remain_desktop_only",
      "pair.revoke": "invalidate_pair_and_confirm_terminal_revoked_readback"
    },
    "forbidden_actions": [
      "shell.exec",
      "arbitrary_file.read",
      "arbitrary_file.write",
      "provider.update",
      "model.update",
      "permission_policy.update",
      "package.install",
      "package.remove",
      "cloud_workspace.create",
      "cloud_workspace.migrate"
    ],
    "idempotency": {
      "send_and_start_requests_require_request_id": true,
      "desktop_deduplicates_within_pair_key_epoch": true,
      "ios_must_not_retry_a_command_after_unknown_terminal_result_without_refresh": true,
      "offline_command_queue": false
    }
  },
  "state_sync": {
    "canonical_state_owner": "codex_core_app_server_and_desktop_opl_app_projection",
    "initial_read": "desktop_projects_bound_task_summaries_and_current_thread_state_after_pair_authentication",
    "streaming": "foreground_ios_subscribes_to_encrypted_task_events_and_renders_partial_output",
    "resume": "on_foreground_or_reconnect_ios_reauthenticates_then_reads_canonical_thread_before_accepting_new_input",
    "local_cache": "encrypted_read_only_projection_and_user_draft_only",
    "draft_policy": "preserve_unsent_text_locally; never_send_a_draft_automatically",
    "stale_projection": "show_stale_state_and_refresh_action; do_not_infer_running_or_completed",
    "conflict_policy": "canonical_thread_and_request_id_are_authoritative; no_last_writer_merge_for_commands",
    "history_policy": "do_not_use_ably_history_as_business_truth"
  },
  "notifications": {
    "foreground_transport": "ably_realtime",
    "background_transport": "apns_via_ably_push_registration",
    "push_is_optional": true,
    "push_payload": "generic_pair_scoped_task_update_signal_without_task_text_or_secrets",
    "background_behavior": "reconnect_and_resync_on_next_foreground; do_not_keep_a_permanent_background_websocket",
    "notification_permission_denied": "foreground_use_remains_available_and_settings_explain_optional_notifications"
  },
  "ownership": {
    "app_contract_and_product_identity": "one-person-lab-app",
    "desktop_connector_and_canonical_action_consumer": "opl-aion-shell_or_successor_shell",
    "ios_native_carrier": "opl-aion-shell_mobile_source_until_a_separate_ios_repository_is_adopted",
    "token_broker_and_pairing_registry": "one-person-lab-cloud",
    "realtime_service": "ably",
    "task_history_and_execution": "codex_core_app_server_and_desktop_runtime",
    "cloud_service_must_not_become": [
      "second_codex_runtime",
      "second_task_store",
      "second_action_bus",
      "cloud_file_store_for_local_tasks"
    ]
  },
  "implementation_status": {
    "product_name_decided": true,
    "transport_decided": true,
    "protocol_source_implemented": false,
    "desktop_connector_source_implemented": false,
    "ios_source_implemented": false,
    "cloud_broker_source_implemented": false,
    "testflight_or_app_store_release": false,
    "china_three_network_qualification": false,
    "release_ready_claim_allowed": false
  },
  "acceptance": {
    "must_prove_before_beta": [
      "no_public_desktop_address_is_needed_for_pairing_or_reconnect",
      "pair_scoped_tokens_and_capabilities_are_least_privilege",
      "ably_and_cloud_cannot_read_task_content",
      "duplicate_send_does_not_create_duplicate_turns",
      "revoked_device_cannot_reestablish_desktop_application_access",
      "ios_background_resume_rehydrates_from_desktop_canonical_state",
      "desktop_and_ios_three_network_connectivity_smoke_passes"
    ],
    "must_prove_before_public_release": [
      "app_store_name_and_bundle_identifier_are_reserved_and_legal_reviewed",
      "apns_production_registration_and_revoke_readback",
      "free_plan_usage_alerts_and_upgrade_runbook",
      "privacy_copy_matches_actual_payload_and_retention",
      "testflight_clean_install_pairing_and_update_readback"
    ],
    "evidence_boundary": "contract_or_unit_tests_do_not_prove_installed_behavior_public_reachability_or_release_completion"
  },
  "source_refs": {
    "ably_capabilities": "https://ably.com/docs/auth/capabilities",
    "ably_token_auth": "https://ably.com/docs/auth/token",
    "ably_apns": "https://ably.com/docs/push/getting-started/apns",
    "ably_pricing": "https://ably.com/pricing",
    "ably_revocation": "https://ably.com/docs/auth/revocation",
    "cloudflare_workers_pricing": "https://developers.cloudflare.com/workers/platform/pricing/",
    "apple_app_information": "https://developer.apple.com/help/app-store-connect/reference/app-information/app-information",
    "implementation_plan": "docs/active/opl-ai-companion-plan.md",
    "app_product_profile": "contracts/app-product-profile.json#delivery_topology.mobile",
    "app_gui_contract": "contracts/app-gui-product-contract.json#remote_companion",
    "app_page_state_matrix": "contracts/app-page-state-matrix.json#remote_companion"
  }
}
