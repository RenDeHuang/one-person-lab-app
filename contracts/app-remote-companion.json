{
  "schema": "opl_app_remote_companion.v3",
  "owner": "one-person-lab-app",
  "purpose": "app_owned_opl_link_product_and_cross_surface_transport_contract",
  "state": "approved_conversation_first_product_baseline_source_aligned_external_configuration_pending",
  "contract_boundary": "This contract defines the OPL Link product, cross-surface behavior, security boundary, and provider selection. The exact cross-repository service broker and encrypted transport shape is owned by contracts/app-remote-companion-wire.json. It does not own iOS implementation, desktop connector implementation, OPL Link service implementation, provider runtime state, Codex runtime, conversation history, OPL Flow task state, domain state, or a cloud workspace.",
  "service_boundary": {
    "owner": "opl-link/service",
    "repository": "opl-link",
    "path": "service",
    "responsibilities": [
      "invitation_and_pairing_claims",
      "atomic_pair_seat_reservation_and_reclaim",
      "short_lived_usersig_and_tencent_user_id_lifecycle",
      "pair_revocation_and_provider_absence_readback",
      "optional_apns_business_id_projection"
    ],
    "runtime_dependency_for_opl_link": true,
    "release_dependency_for_opl_link": true
  },
  "optional_cloud_host": {
    "product": "OPL Cloud",
    "role": "optional_workspace_webui_host",
    "repository": "one-person-lab-cloud",
    "runtime_dependency_for_opl_link": false,
    "release_dependency_for_opl_link": false,
    "release_prerequisite_for_opl_link": false
  },
  "product_identity": {
    "app_store_name": "OPL Link",
    "home_screen_name": "OPL Link",
    "in_app_brand_name": "One Person Lab",
    "subtitle_en": "Your AI conversations, anywhere",
    "subtitle_zh_cn": "随时继续桌面 AI 对话",
    "internal_surface_id": "remote_companion",
    "client_kind": "independent_ios_client",
    "product_role": "remote_companion_channel_not_a_runtime_or_third_workbench",
    "full_workbench_surfaces": [
      "desktop_app",
      "desktop_webui"
    ],
    "local_ios_runtime": false,
    "local_ios_conversation_history_authority": false,
    "local_ios_provider_or_model_authority": false,
    "local_ios_agent_package_authority": false
  },
  "surface_boundary": {
    "conversation_model": {
      "primary_object": "canonical_codex_conversation",
      "canonical_identity": "canonical_thread_id",
      "conversation_is": [
        "the_user_visible_unit_in_the_opl_link_list",
        "the_context_for_messages_streaming_output_and_turn_control",
        "the_unit_that_can_be_started_opened_continued_and_stopped"
      ],
      "task_is": [
        "optional_desktop_metadata_or_grouping_label",
        "an_external_opl_flow_ledger_or_linear_reference_when_present"
      ],
      "opl_link_does_not_manage": [
        "task_lifecycle",
        "task_owner_deadline_dependency_or_workflow",
        "ledger_receipts_or_linear_issue_state"
      ],
      "task_management_authority": "opl_flow_via_opl_ledger_and_linear_when_enabled; otherwise_task_is_desktop_conversation_grouping_metadata_only"
    },
    "primary_user_outcomes": [
      "pair_one_phone_with_one_running_desktop_installation",
      "see_the_bound_desktop_conversation_list",
      "filter_the_currently_loaded_conversation_directory_locally_without_claiming_canonical_search",
      "open_a_canonical_conversation_and_read_its_history",
      "read_streaming_conversation_output",
      "continue_the_bound_canonical_conversation_with_text",
      "start_a_new_canonical_conversation_with_desktop_defaults",
      "stop_the_current_conversation_turn",
      "respond_to_an_owner_projected_conversation_approval_request",
      "receive_a_generic_conversation_update_notification"
    ],
    "deferred_outcomes": [
      "arbitrary_shell_or_terminal_commands",
      "remote_file_upload_or_file_system_mutation",
      "provider_model_reasoning_or_permission_policy_editing",
      "package_install_update_or_uninstall",
      "offline_command_queueing",
      "multi_user_shared_workspace_or_cloud_task_migration",
      "opl_flow_ledger_or_linear_task_management",
      "canonical_conversation_search_archive_rename_or_delete_until_desktop_apis_are_admitted",
      "multi_desktop_or_multi_phone_conversation_mirroring"
    ],
    "forbidden_claims": [
      "codex_runtime_is_running_on_the_iphone",
      "the_phone_is_a_second_codex_client_or_session_store",
      "a_provider_message_is_the_canonical_conversation_history",
      "a_connected_transport_proves_conversation_or_provider_readiness",
      "a_push_notification_contains_or_confirms_sensitive_conversation_content",
      "opl_link_is_a_linear_or_ledger_task_control_plane"
    ],
    "desktop_default_following_policy": "ios_follows_the_bound_desktop_canonical_thread_host_model_permission_and_agent_configuration_without_exposing_editors_in_mvp"
  },
  "transport": {
    "protocol": "opl_remote_transport.v1",
    "provider_strategy": {
      "active_provider": "tencent_cloud_im",
      "active_edition": "trial",
      "selection_status": "approved_for_mvp",
      "client_adapter_owner": "opl-link",
      "single_provider_per_release_cohort": true,
      "runtime_dual_write": false,
      "automatic_provider_fallback": false,
      "replacement_candidate": "ably",
      "replacement_candidate_implemented": false,
      "switch_policy": "prove_the_replacement_adapter_then_cut_over_one_release_cohort_and_require_explicit_repair_for_existing_pairs"
    },
    "connection_model": "desktop_and_ios_each_initiate_outbound_tls_or_wss_connections_to_the_selected_managed_provider",
    "public_desktop_address_required": false,
    "lan_or_vpn_configuration_required": false,
    "provider_secret_embedded_in_client": false,
    "authentication": {
      "mode": "pair_specific_user_id_with_short_lived_usersig",
      "credential_issuer": "opl-link/service",
      "provider_identity": "one_pair_specific_desktop_user_id_and_one_pair_specific_ios_user_id",
      "identity_creation": "only_after_invitation_validation_atomic_seat_reservation_and_desktop_pair_confirmation",
      "active_credential_policy": "existing_desktop_pair_token_or_ios_claim_token_becomes_active_device_credential_after_pair_activation_without_minting_a_second_bearer",
      "usersig_ttl_minutes": 60,
      "automatic_refresh": true,
      "tencent_sdkapp_secret_in_client": false,
      "credential_reuse_across_pairs": false
    },
    "message_policy": {
      "route": "pair_specific_c2c_custom_messages",
      "group_or_public_channel_used": false,
      "command_delivery": "online_only_without_cloud_command_queue",
      "provider_history_used_for_business_reads": false,
      "directional_roles_enforced_by_application_protocol": true,
      "ids_must_be_opaque": true,
      "user_text_or_workspace_path_in_provider_route": false,
      "transport_message_envelope": "encrypted_event_with_request_id_sequence_key_epoch_and_protocol_version",
      "stream_batching": "coalesce_output_deltas_by_100_to_250_ms_or_4_kib_whichever_occurs_first_and_flush_on_terminal_state"
    },
    "presence_policy": {
      "source": "encrypted_pair_heartbeat_and_timeout",
      "provider_presence_required": false,
      "transport_connected_is_product_ready": false
    },
    "payload_confidentiality": {
      "required": true,
      "scheme": "x25519_key_agreement_hkdf_sha256_two_directional_aes_256_gcm_keys",
      "key_authority": "desktop_and_ios_pair_only",
      "provider_plaintext_conversation_content": false,
      "cloud_plaintext_conversation_content": false,
      "key_rotation": "new_pair_specific_device_keypairs_on_repair_or_explicit_rekey",
      "aead_associated_data": "protocol_version_pair_id_sender_device_id_recipient_device_id_key_epoch_sender_sequence_and_channel_direction",
      "nonce_policy": "cryptographically_random_96_bit_nonce_with_duplicate_rejection_per_directional_key",
      "replay_protection": "pair_key_epoch_plus_per_sender_monotonic_sequence_and_request_id"
    },
    "usage_guardrails": {
      "provider": "tencent_cloud_im",
      "edition": "trial",
      "limits_reference": "https://cloud.tencent.com/document/product/269/11673",
      "snapshot_checked_on": "2026-08-16",
      "registered_user_id_limit": 100,
      "peak_dau_limit": 100,
      "user_ids_per_active_pair_seat": 2,
      "active_pair_seat_limit": 40,
      "pair_seat_warning_threshold": 35,
      "reserved_user_id_headroom": 20,
      "new_pairing_stops_at_seat_limit": true,
      "existing_pair_fail_open_during_capacity_warning": true,
      "limits_must_be_rechecked_before_beta_and_public_release": true
    }
  },
  "distribution_and_access": {
    "beta_carrier": "testflight",
    "public_carrier": "apple_app_store",
    "app_store_listing_can_be_public": true,
    "invitation_required_for_pairing": true,
    "testflight_is_capacity_or_entitlement_authority": false,
    "install_launch_or_invite_entry_consumes_provider_identity": false,
    "successful_pairing_consumes_one_active_pair_seat": true,
    "app_review_requires_real_sandbox_pair_or_complete_demo_access": true
  },
  "pairing": {
    "user_flow": "obtain_invitation_then_desktop_start_pairing_then_ios_scan_one_time_qr_then_compare_authentication_string_then_desktop_confirm_then_provision_transport_then_ios_enters_companion",
    "account_required": false,
    "primary_method": "one_time_qr",
    "fallback_method": "short_manual_code_or_paste_full_pairing_payload",
    "fallback_payload_policy": "both_entry_methods_bind_to_the_same_single_use_short_lived_pairing_record_without_creating_a_second_pairing_state",
    "short_manual_code": "implemented_via_configured_link_service_origin_then_normal_claim",
    "manual_code_resolution": {
      "configured_origin": "signed_ios_carrier_configuration",
      "endpoint": "/v1/remote-companion/pairings/resolve",
      "availability": "reserved_pairing_before_first_claim_only",
      "response_fields": [
        "pairing_id",
        "broker_url",
        "desktop_public_key",
        "expires_at"
      ],
      "response_must_not_include": [
        "claim_secret",
        "desktop_pair_token",
        "ios_claim_token",
        "provider_credential"
      ],
      "claim_behavior": "reuse_the_same_manual_code_with_the_resolved_pairing_id_in_the_existing_claim_protocol"
    },
    "qr_payload": [
      "broker_route",
      "opaque_pairing_id",
      "one_time_random_256_bit_qr_claim_secret",
      "desktop_pair_specific_public_key",
      "short_lived_pairing_expiry"
    ],
    "qr_payload_must_not_include": [
      "provider_secret_or_api_key",
      "desktop_public_ip_or_port",
      "workspace_path",
      "conversation_text",
      "long_lived_access_token",
      "plaintext_pair_master_key"
    ],
    "claim_protocol": [
      "broker_validates_one_time_invitation_and_atomically_reserves_one_pair_seat_with_a_5_minute_ttl",
      "desktop_creates_single_use_pairing_record_random_256_bit_qr_claim_secret_and_pair_specific_x25519_keypair",
      "broker_stores_only_the_salted_hash_of_the_qr_claim_secret_and_the_qr_carries_the_plaintext_secret_once",
      "ios_creates_a_pair_specific_x25519_keypair_and_submits_pairing_id_claim_secret_and_public_key_to_the_broker",
      "desktop_reads_the_claim_and_both_devices_display_the_same_short_authentication_string_derived_from_pairing_id_and_both_public_keys",
      "desktop_requires_local_confirmation_after_the_user_compares_the_short_authentication_string",
      "desktop_and_ios_derive_the_pair_master_key_locally_with_x25519_and_hkdf_without_transmitting_it",
      "desktop_pair_token_and_ios_claim_token_become_role_bound_active_device_credentials_after_activation_without_minting_second_bearers_and_the_broker_persists_only_their_sha256_hashes_for_future_usersig_requests",
      "broker_provisions_pair_specific_desktop_and_ios_tencent_user_ids_then_issues_separate_short_lived_usersig_credentials",
      "broker_marks_the_pair_active_only_after_both_provider_identities_and_clients_have_owner_readback"
    ],
    "broker_persistence": {
      "allowed": [
        "opaque_invitation_entitlement_or_hash",
        "opaque_pairing_id",
        "salted_single_use_claim_secret_or_manual_code_hash",
        "pair_specific_public_keys",
        "expiry_claim_and_seat_reservation_state",
        "provider_user_id_bindings",
        "device_credential_sha256_hashes",
        "revoked_device_hash"
      ],
      "forbidden": [
        "conversation_history",
        "conversation_content",
        "workspace_files",
        "provider_secret_or_api_key_in_client_records",
        "plaintext_pair_master_key",
        "plaintext_device_credential",
        "plaintext_invitation_secret"
      ],
      "atomic_claim_and_seat_reservation_required": true,
      "retention": "delete_unclaimed_records_after_expiry_and_delete_claim_metadata_after_pair_revocation_plus_bounded_security_retention"
    },
    "ios_pending_pairing_persistence": {
      "owner": "opl-link",
      "storage": "ios_keychain_when_unlocked_this_device_only_until_activation_expiry_or_local_reset",
      "material": [
        "opaque_pairing_id",
        "broker_route",
        "ios_device_id",
        "ios_pair_specific_private_key",
        "desktop_pair_specific_public_key",
        "ios_claim_token",
        "authentication_string",
        "short_lived_pairing_expiry"
      ],
      "resume": "cold_start_restores_awaiting_desktop_confirmation_and_reads_broker_state_without_reclaiming_or_reminting_pair_credentials",
      "activation": "persist_active_pair_material_with_the_existing_ios_claim_token_before_transport_connect_then_delete_the_pending_record",
      "clear_on": [
        "active_pair_material_persisted_after_activation",
        "pairing_expiry",
        "failed_claim",
        "terminal_revocation"
      ]
    },
    "capacity_lifecycle": {
      "owner": "opl-link/service",
      "pair_seat_definition": "one_pair_specific_desktop_user_id_plus_one_pair_specific_ios_user_id",
      "reservation_ttl_minutes": 5,
      "allocated_states": [
        "reserved",
        "awaiting_desktop_confirmation",
        "provisioning",
        "active",
        "revoking",
        "provider_reclaim_pending"
      ],
      "seat_release_condition": "both_tencent_user_ids_deleted_and_provider_owner_readback_confirms_absence",
      "client_must_not_allocate_reclaim_or_infer_seats": true
    },
    "device_lifecycle": {
      "mvp_max_active_companion_pairs_per_desktop_installation": 1,
      "device_label_user_editable": true,
      "revoke_action": "desktop_or_ios_explicit_revoke_pair",
      "revoke_effect": "mark_pair_revoked_deny_future_usersig_kick_provider_sessions_detach_desktop_delete_pair_keys_delete_both_provider_user_ids_then_release_seat_after_absence_readback",
      "existing_credential_policy": "a_previously_issued_usersig_may_remain_cryptographically_valid_until_expiry_but_the_deleted_or_revoked_pair_must_not_reconnect_publish_subscribe_or_execute_after_terminal_revoke",
      "provider_account_delete_and_absence_readback_required_for_seat_reclaim": true,
      "revoke_does_not_delete_canonical_conversations": true
    }
  },
  "action_policy": {
    "action_authority": "desktop_canonical_app_action_bridge",
    "request_required_fields": [
      "protocol_version",
      "pair_id",
      "device_id",
      "key_epoch",
      "nonce",
      "encrypted_payload"
    ],
    "product_action_names": [
      "conversation.list",
      "conversation.open",
      "conversation.refresh",
      "conversation.start",
      "conversation.send_text",
      "conversation.turn.stop",
      "conversation.approval.respond",
      "pair.revoke"
    ],
    "encrypted_request_fields": [
      "request_id",
      "canonical_thread_id_or_new_conversation_intent",
      "client_sequence",
      "action_id",
      "action_payload"
    ],
    "mvp_allowed_actions": [
      "canonical_task.list",
      "canonical_task.read",
      "canonical_task.refresh",
      "canonical_task.start",
      "canonical_task.send_text",
      "canonical_turn.stop",
      "canonical_approval.respond",
      "pair.revoke"
    ],
    "wire_action_ids_are_internal_aliases": true,
    "wire_action_id_mapping": {
      "conversation.list": "canonical_task.list",
      "conversation.open": "canonical_task.read",
      "conversation.refresh": "canonical_task.refresh",
      "conversation.start": "canonical_task.start",
      "conversation.send_text": "canonical_task.send_text",
      "conversation.turn.stop": "canonical_turn.stop",
      "conversation.approval.respond": "canonical_approval.respond",
      "pair.revoke": "pair.revoke"
    },
    "action_requirements": {
      "canonical_task.send_text": "product_action_conversation_send_text; desktop_validates_bound_thread_and_deduplicates_request_id_before_turn_start",
      "canonical_task.start": "product_action_conversation_start; desktop_uses_current_default_workspace_model_permission_and_agent_projection",
      "canonical_turn.stop": "product_action_conversation_turn_stop; desktop_routes_to_the_current_canonical_turn_only",
      "canonical_approval.respond": "product_action_conversation_approval_respond; allow_only_owner_projected_low_or_medium_impact_approvals_with_explicit_confirmation_and_route_through_the_existing_app_action_bridge; high_impact_approvals_remain_desktop_only",
      "pair.revoke": "invalidate_pair_and_confirm_terminal_revoked_readback_without_deleting_canonical_conversations"
    },
    "forbidden_actions": [
      "shell.exec",
      "arbitrary_file.read",
      "arbitrary_file.write",
      "provider.update",
      "model.update",
      "permission_policy.update",
      "package.install",
      "package.remove",
      "cloud_workspace.create",
      "cloud_workspace.migrate"
    ],
    "idempotency": {
      "send_and_start_requests_require_request_id": true,
      "desktop_deduplicates_within_pair_key_epoch": true,
      "ios_must_not_retry_a_command_after_unknown_terminal_result_without_refresh": true,
      "offline_command_queue": false
    }
  },
  "state_sync": {
    "canonical_state_owner": "codex_core_app_server_and_desktop_opl_app_projection",
    "initial_read": "desktop_projects_bound_conversation_summaries_and_current_thread_state_after_pair_authentication",
    "streaming": "foreground_ios_subscribes_to_encrypted_conversation_events_and_renders_partial_output",
    "resume": "on_foreground_or_reconnect_ios_refreshes_credentials_and_reads_canonical_thread_before_accepting_new_input",
    "local_cache": "encrypted_read_only_projection_and_user_draft_only",
    "draft_policy": "preserve_unsent_text_locally; never_send_a_draft_automatically",
    "stale_projection": "show_stale_state_and_refresh_action; do_not_infer_running_or_completed",
    "conflict_policy": "canonical_thread_and_request_id_are_authoritative; no_last_writer_merge_for_commands",
    "history_policy": "do_not_use_provider_history_as_canonical_conversation_truth"
  },
  "notifications": {
    "foreground_transport": "selected_remote_transport_adapter",
    "background_transport": "optional_apns_or_tencent_push_generic_signal_adapter",
    "push_is_optional": true,
    "push_payload": "generic_pair_scoped_conversation_update_signal_without_conversation_text_or_secrets",
    "background_behavior": "reconnect_and_resync_on_next_foreground; do_not_keep_a_permanent_background_socket",
    "notification_permission_denied": "foreground_use_remains_available_and_settings_explain_optional_notifications",
    "apns_business_id": {
      "owner": "opl-link/service",
      "wire_field": "push_business_id",
      "optional": true,
      "client_must_not_choose": true
    }
  },
  "ownership": {
    "app_contract_product_identity_and_cross_surface_behavior": "one-person-lab-app",
    "ios_native_carrier_client_state_and_transport_adapter": "opl-link",
    "desktop_connector_and_canonical_action_consumer": "opl-aion-shell_or_admitted_successor_shell",
    "invitation_pair_seat_usersig_and_provider_account_lifecycle": "opl-link/service",
    "realtime_service": "tencent_cloud_im",
    "conversation_history_and_execution": "codex_core_app_server_and_desktop_runtime",
    "cloud_service_must_not_become": [
      "second_codex_runtime",
      "second_conversation_store",
      "second_action_bus",
      "cloud_file_store_for_local_conversations"
    ]
  },
  "implementation_status": {
    "product_name_decided": true,
    "transport_decided": true,
    "ios_repository_initialized": true,
    "design_contracts_implemented": true,
    "protocol_source_implemented": true,
    "desktop_connector_source_implemented": true,
    "ios_source_implemented": true,
    "ios_conversation_surface_implemented": true,
    "desktop_conversation_projection_implemented": true,
    "link_service_source_implemented": true,
    "tencent_cloud_application_configured": false,
    "testflight_or_app_store_release": false,
    "china_three_network_qualification": false,
    "release_ready_claim_allowed": false
  },
  "acceptance": {
    "must_prove_before_beta": [
      "no_public_desktop_address_is_needed_for_pairing_or_reconnect",
      "pair_specific_user_ids_and_short_lived_usersig_keep_provider_secret_out_of_clients",
      "provider_and_cloud_cannot_read_conversation_content",
      "atomic_pair_seat_reservation_prevents_capacity_oversubscription",
      "duplicate_send_does_not_create_duplicate_turns",
      "revoked_device_cannot_reestablish_desktop_application_access",
      "both_provider_user_ids_are_absent_before_pair_seat_reclaim",
      "ios_background_resume_rehydrates_from_desktop_canonical_state",
      "desktop_and_ios_three_network_connectivity_smoke_passes"
    ],
    "must_prove_before_public_release": [
      "app_store_name_and_bundle_identifier_are_reserved_and_legal_reviewed",
      "tencent_trial_limits_and_upgrade_terms_are_rechecked_against_official_current_docs",
      "apns_or_tencent_push_production_registration_and_revoke_readback",
      "invitation_pair_seat_warning_and_hard_gate_have_owner_readback",
      "privacy_copy_matches_actual_payload_and_retention",
      "testflight_clean_install_pairing_update_and_revoke_readback",
      "app_review_has_a_real_sandbox_pair_or_complete_demo_access"
    ],
    "evidence_boundary": "contracts_docs_or_unit_tests_do_not_prove_installed_behavior_provider_configuration_public_reachability_testflight_or_release_completion"
  },
  "source_refs": {
    "wire_contract": "contracts/app-remote-companion-wire.json",
    "tencent_cloud_im_product": "https://cloud.tencent.com/document/product/269",
    "tencent_cloud_im_plans": "https://cloud.tencent.com/document/product/269/11673",
    "tencent_usersig": "https://cloud.tencent.com/document/product/269/32688",
    "ably_replacement_candidate_pricing": "https://ably.com/pricing",
    "apple_app_information": "https://developer.apple.com/help/app-store-connect/reference/app-information/app-information",
    "implementation_baseline": "docs/product/opl-link.md",
    "ios_repository": "https://github.com/gaofeng21cn/opl-link",
