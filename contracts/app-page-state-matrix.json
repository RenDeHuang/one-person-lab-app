      "machine_source": "App-owned active-shell validation",
      "refresh_source": "none",
      "page_contract": "theme_and_branding",
      "state_sections": [
        "branding"
      ]
    },
    {
      "id": "settings_theme",
      "expected_source": "OPL App state projection",
      "must_show": [
        "Default theme option",
        "Codex theme option",
        "current theme from app_state.settings.theme",
        "theme choice as App product preference"
      ],
      "must_not_show": [
        "AionUI theme as product authority",
        "theme choice as runtime or domain readiness"
      ],
      "machine_source": "opl app state --profile fast --json",
      "refresh_source": "opl app state --profile fast --json",
      "page_contract": "settings_theme",
      "state_sections": [
        "theme"
      ]
    },
    {
      "id": "first_launch_readiness",
      "expected_source": "pre-/guid first-run wizard and OPL initialize result",
      "launch_gate": {
        "id": "ready_to_launch",
        "ui_order": "before_guid",
        "required_core_items": [
          "workspace_root",
          "codex_cli",
          "codex_config"
        ],
        "full_readiness_items": [
          "domain_modules",
          "family_runtime_provider",
          "recommended_skills",
          "native_helpers",
          "repo_sync",
          "command_line_tools_install",
          "ecosystem_module_updates"
        ],
        "full_readiness_blocks_ready_to_launch": false
      },
      "must_show": [
        "workspace root readiness",
        "Codex CLI readiness",
        "Codex config readiness",
        "ready_to_launch before /guid",
        "full readiness and background maintenance state",
        "current initialization phase",
        "Core completed and total count",
        "Full readiness completed and total count",
        "background maintenance completed and total count",
        "next visible step",
        "completion state",
        "blocking error source",
        "beginner-facing readiness summary",
        "primary start action",
        "background maintenance collapsed technical disclosure",
        "technical details toggle"
      ],
      "progress_model": {
        "source_command": "opl system initialize --json",
        "source_path": "system_initialize.setup_flow",
        "renderer_truth_policy": "render_only_no_shell_private_progress_truth",
        "required_setup_flow_fields": [
          "phase",
          "ready_to_launch",
          "progress",
          "blocking_items",
          "maintenance_items"
        ],
        "required_progress_fields": [
          "ready_required_count",
          "total_required_count",
          "ready_full_readiness_count",
          "total_full_readiness_count",
          "ready_optional_count",
          "total_optional_count"
        ],
        "required_checklist_fields": [
          "item_id",
          "label",
          "status",
          "readiness_layer",
          "blocking",
          "severity",
          "next_visible_step",
          "detail_summary"
        ],
        "required_visible_elements": [
          "current initialization phase",
          "Core completed and total count",
          "Full readiness completed and total count",
          "background maintenance completed and total count",
          "blocking item list",
          "next visible step"
        ]
      },
      "beginner_view_model": {
        "audience": "beginner_non_technical_users",
        "presentation_mode": "simplified_first_run",
        "primary_user_goal": "reach_guid_with_codex_ready",
        "primary_steps": [
          "workspace_root",
          "codex_cli",
          "codex_config"
        ],
        "primary_progress_signal": "Core completed and total count",
        "advanced_progress_disclosure": "collapsed_or_secondary",
        "background_maintenance_presentation": "collapsed_technical_non_blocking",
        "technical_detail_policy": "hidden_until_expanded_or_error",
        "required_shell_testids": [
          "opl-first-run-beginner-summary",
          "opl-first-run-primary-action",
          "opl-first-run-technical-details-toggle"
        ],
        "localization_policy": {
          "chinese_primary_labels": [
            "工作目录",
            "本机助手",
            "访问权限"
          ],
          "technical_label_policy": "map_initialize_item_ids_to_app_owned_beginner_labels_before_rendering_primary_area",
          "forbidden_primary_area_text": [
            "Codex API Configuration",
            "Unknown",
            "Needs setup",
            "setup_flow",
            "opl system"
          ]
        }
      },
      "must_not_show": [
        "Homebrew, Node, Git, CLT, module, provider, or runtime maintenance as primary first-screen terminal goals",
        "Full readiness progress as the dominant first-screen message",
        "raw command output in the beginner primary area",
        "English runtime checklist labels in the Chinese beginner primary area",
        "Codex API Configuration, Unknown, or Needs setup in the Chinese beginner primary area",
        "background maintenance counters or labels in the beginner primary area"
      ]
    }
  ],
  "gui_product_contract": "contracts/app-gui-product-contract.json",
  "canonical_state_surface": {
    "schema": "opl_app_state.v1",
    "default_command": "opl app state --profile fast --json",
    "refresh_command": "opl app state --profile fast --json",
    "default_profile": "fast",
    "manual_refresh_profile": "fast",
    "page_load_policy": "fast_state_first_no_page_wide_spinner",
    "failure_policy": "section_level_status_with_last_good_display_cache_allowed"
  },
  "canonical_action_surface": {
    "command": "opl app action execute --action <action_id> [--payload json] [--dry-run] --json",
    "policy": "mutating_work_uses_explicit_app_action_route"
  },
  "full_detail_exception": {
    "command": "opl runtime app-operator-drilldown --detail full --json",
    "policy": "on_demand_only"
  }
}
