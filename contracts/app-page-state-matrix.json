      "must_not_show": [
        "raw settings.firstRun keys",
        "English first-run fallback in Chinese locales",
        "Codex API Configuration in Chinese beginner primary area",
        "Unknown or Needs setup in Chinese beginner primary area",
        "raw setup_flow fields or opl system commands in beginner primary area"
