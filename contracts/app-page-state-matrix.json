{
  "schema_version": 1,
  "owner": "one-person-lab-app",
  "purpose": "page_state_test_matrix",
  "state": "active",
  "active_shell": "aionui",
  "shell_root": "shells/aionui",
  "pages": [
    {
      "id": "guid_home",
      "expected_source": "App-owned GUI product contract and OPL App state projection",
      "machine_source": "contracts/app-gui-product-contract.json#pages.guid_home + opl app state --profile fast --json",
      "page_contract": "guid_home_entry",
      "home_view_model": {
        "authority": "app_repo_owned_product_truth",
        "implementation_carrier": "opl-aion-shell",
        "primary_input_surface": "single_card",
        "nested_input_card_frames_allowed": false,
        "appearance_default_css_theme_id": "default-theme",
        "codex_model_selector_visible": false,
        "codex_model_list_visible": false,
        "codex_model_policy": "auto_latest_frontier_from_codex_capabilities_or_app_default",
        "codex_default_model": "gpt-5.5",
        "codex_default_reasoning_effort": "xhigh",
        "codex_default_permission_mode": "full-access",
        "retired_codex_models_must_not_be_exposed": [
          "gpt-5.2-codex",
          "gpt-5.1-codex-max",
          "gpt-5.1-codex-mini"
        ],
        "state_source": "opl app state --profile fast --json",
        "refresh_source": "opl app state --profile full --json",
        "executor_policy_ref": "contracts/app-gui-product-contract.json#executor_policy",
        "assistant_source_ref": "contracts/app-gui-product-contract.json#default_assistants",
        "codex_only_default": true,
        "executor_tab_visible_when_single_executor": false,
        "default_assistants": [
          "mas",
          "mag",
          "rca",
          "oma"
        ],
        "hero_prompt": "把研究、基金和汇报交给 One Person Lab 自动推进"
      },
      "must_show": [
        "Codex-only default executor experience",
        "default Codex model state without a visible model tab",
        "default assistants MAS/MAG/RCA/OMA as click-to-start entries",
        "workspace selector",
        "file attachment control",
        "permission mode control",
        "send action"
      ],
      "must_not_show": [
        "executor tab when Codex CLI is the only executor",
        "Codex model dropdown on new conversation",
        "retired Codex model choices",
        "nested input card frames"
      ],
      "state_source": "opl app state --profile fast --json",
      "refresh_source": "opl app state --profile full --json"
    },
    {
      "id": "runtime",
      "expected_source": "OPL App state projection summary with on-demand Framework drilldown",
      "machine_source": "opl app state --profile fast --json",
      "primary_projection": "app_state.operator.summary",
      "fallback_projection": "full App/operator drilldown only for on-demand full detail",
      "framework_command": "opl app state --profile fast --json",
      "framework_full_detail_command": "opl runtime app-operator-drilldown --detail full --json",
      "framework_action_command": "opl app action execute --action <action_id> [--payload json] [--dry-run] --json",
      "page_contract": "runtime_status_summary_first",
      "runtime_view_model": {
        "role": "opl_runtime_status_summary",
        "bridge_contract": "contracts/app-runtime-bridge.json",
        "default_mode": "app_state_summary_first",
        "full_detail_policy": "on_demand_only",
        "polling_fallback": {
          "interval_seconds_min": 5,
          "interval_seconds_max": 10,
          "policy": "lightweight_polling_until_push_projection_available"
        },
        "action_queue": {
          "source": "app_state.actions",
          "fallback_source": "app_state.operator.actions",
          "authority": "framework_refs_only"
        },
        "vertical_map": {
          "source": "app_state.operator.dynamic_vertical_map",
          "fallback_source": "app_operator_drilldown.route_graph on demand",
          "orientation": "vertical",
          "scope": "multi_task_runtime_map"
        },
        "task_drilldown": {
          "command": "opl runtime app-operator-drilldown --task <task_id> --json",
          "detail_command": "opl runtime app-operator-drilldown --task <task_id> --detail full --json",
          "scope": "single_task",
          "default_mode": "summary_first"
        },
        "mas_paper_lens": {
          "source": "domain_projection_refs.mas.paper_lens",
          "scope": "refs_only_publication_progress",
          "authority": "mas_owned"
        },
        "authority_boundary": {
          "refs_only": true,
          "non_authority_display_only": true,
          "action_execution_owner": "opl_framework",
          "domain_verdict_owner": "domain_agent"
        },
        "primary_state_source": "opl app state --profile fast --json",
        "refresh_state_source": "opl app state --profile full --json",
        "summary_source": "app_state.operator.summary",
        "full_detail_source": "opl runtime app-operator-drilldown --detail full --json",
        "provider_status": {
          "source": "app_state.provider",
          "authority": "opl_framework"
        }
      },
      "operator_evidence_acceptance_path": {
        "role": "runtime_page_operator_evidence_acceptance",
        "accepts_refs_only_json": true,
        "summary_state_command": "opl app state --profile fast --json",
        "refresh_state_command": "opl app state --profile full --json",
        "full_drilldown_command": "opl runtime app-operator-drilldown --detail full --json",
        "action_dry_run_command": "opl app action execute --action <action_id> --dry-run --json",
        "action_execute_command": "opl app action execute --action <action_id> --json",
        "action_route_source": "app_state.actions",
        "action_execution_policy": "operator_selected_safe_app_action_route_only"
      },
      "operator_evidence_path": [
        "summary-first OPL App state read model",
        "full App state refresh",
        "full detail lazy load",
        "app_state.operator.summary refs",
        "app_state.provider readiness refs",
        "app_state.actions safe action refs",
        "refs-only non-authority boundary",
        "safe app action dry-run",
        "safe app action execute",
        "receipt/count refresh after execute",
        "authority boundary fields"
      ],
      "must_show": [
        "summary-first OPL runtime status",
        "provider readiness from app_state.provider",
        "operator summary from app_state.operator",
        "safe action refs from app_state.actions",
        "summary-first OPL App state read model",
        "full detail lazy load",
        "safe app action dry-run/execute controls",
        "receipt/count refresh after execute",
        "refs-only non-authority boundary"
      ],
      "must_not_own": [
        "runtime truth",
        "provider implementation",
        "domain truth",
        "memory body",
        "artifact body",
        "quality/readiness/export verdict",
        "action route authority",
        "domain action approval override"
      ],
      "framework_refresh_command": "opl app state --profile full --json"
    },
    {
      "id": "settings_overview",
      "expected_source": "OPL App state projection",
      "must_show": [
        "Developer Mode effective state from app_state.developer_mode",
        "workspace path from app_state.paths",
        "logs path from app_state.paths",
        "OPL Agent Codex context"
      ],
      "machine_source": "opl app state --profile fast --json",
      "refresh_source": "opl app state --profile full --json",
      "page_contract": "settings_system",
      "state_sections": [
        "developer_mode",
        "paths",
        "opl_agent_codex_context"
      ],
      "must_not_show": [
        "delayed developer mode flip from a shell-local cache",
        "AionUI local directory as OPL path truth"
      ]
    },
    {
      "id": "environment",
      "expected_source": "OPL App state projection",
      "must_show": [
        "Codex CLI version and default profile from app_state.core",
        "Temporal status from app_state.provider.temporal",
        "MAS/MAG/RCA/OMA module version and source from app_state.modules",
        "module path source explanation",
        "section-level refresh state"
      ],
      "machine_source": "opl app state --profile fast --json",
      "refresh_source": "opl app state --profile full --json",
      "page_contract": "settings_runtime",
      "state_sections": [
        "core.codex",
        "provider.temporal",
        "modules",
        "assistants",
        "release"
      ],
      "module_path_source_policy_ref": "contracts/app-gui-product-contract.json#module_path_source_policy",
      "must_not_show": [
        "Med Deep Scientist as a default module",
        "page-wide spinner while one section refreshes",
        "GUI-owned Temporal restart judgment"
      ]
    },
    {
      "id": "about",
      "expected_source": "OPL App state projection",
      "must_show": [
        "One Person Lab App version",
        "GUI shell version",
        "OPL Framework version",
        "Stable or Nightly channel",
        "localized update status"
      ],
      "machine_source": "opl app state --profile fast --json",
      "refresh_source": "opl app state --profile full --json",
      "page_contract": "about",
      "state_sections": [
        "release"
      ],
      "must_not_show": [
        "AionUI version as the App version",
        "raw i18n keys",
        "raw update error codes as user-facing copy"
      ]
    },
    {
      "id": "update",
      "expected_source": "OPL App state projection",
      "must_show": [
        "Stable channel update state",
        "Nightly opt-in update state when enabled",
        "localized GitHub release check failure"
      ],
      "must_not_show": [
        "Full first-install asset as a standard updater target",
        "English update labels in Chinese UI"
      ],
      "machine_source": "opl app state --profile fast --json",
      "refresh_source": "opl app state --profile full --json",
      "page_contract": "update",
      "state_sections": [
        "release"
      ]
    },
    {
      "id": "settings_theme",
      "expected_source": "OPL App state projection",
      "must_show": [
        "Default theme option",
        "Codex theme option",
        "current theme from app_state.settings.theme",
        "theme choice as App product preference"
      ],
      "must_not_show": [
        "AionUI theme as product authority",
        "theme choice as runtime or domain readiness"
      ],
      "machine_source": "opl app state --profile fast --json",
      "refresh_source": "opl app state --profile full --json",
      "page_contract": "settings_theme",
      "state_sections": [
        "theme"
      ]
    },
    {
      "id": "first_launch_readiness",
      "expected_source": "first-run wizard and OPL initialize result",
      "must_show": [
        "required setup state",
        "completion state",
        "blocking error source"
      ]
    }
  ],
  "gui_product_contract": "contracts/app-gui-product-contract.json",
  "canonical_state_surface": {
    "schema": "opl_app_state.v1",
    "default_command": "opl app state --profile fast --json",
    "refresh_command": "opl app state --profile full --json",
    "default_profile": "fast",
    "manual_refresh_profile": "full",
    "page_load_policy": "fast_state_first_no_page_wide_spinner",
    "failure_policy": "section_level_status_with_last_good_display_cache_allowed"
  },
  "canonical_action_surface": {
    "command": "opl app action execute --action <action_id> [--payload json] [--dry-run] --json",
    "policy": "mutating_work_uses_explicit_app_action_route"
  },
  "full_detail_exception": {
    "command": "opl runtime app-operator-drilldown --detail full --json",
    "policy": "on_demand_only"
  }
}
