{
  "schema_version": 1,
  "owner": "one-person-lab-app",
  "purpose": "page_state_test_matrix",
  "state": "active",
  "active_shell": "aionui",
  "shell_root": "shells/aionui",
  "pages": [
    {
      "id": "runtime",
      "expected_source": "OPL runtime snapshot or provider-backed projection",
      "machine_source": "runtime_tray_snapshot.app_operator_drilldown",
      "framework_command": "opl runtime app-operator-drilldown --json",
      "framework_full_detail_command": "opl runtime app-operator-drilldown --json --detail full",
      "framework_action_command": "opl runtime action execute --action <id> [--payload refs-only-json] [--dry-run]",
      "page_contract": "runtime_workbench_drilldown",
      "operator_evidence_acceptance_path": {
        "role": "runtime_page_operator_evidence_acceptance",
        "accepts_refs_only_json": true,
        "summary_drilldown_command": "opl runtime app-operator-drilldown --json",
        "full_drilldown_command": "opl runtime app-operator-drilldown --json --detail full",
        "action_dry_run_command": "opl runtime action execute --action <action_id> --dry-run",
        "action_execute_command": "opl runtime action execute --action <action_id>",
        "action_route_source": "runtime_tray_snapshot.app_operator_drilldown.safe_action_routes",
        "action_execution_policy": "operator_selected_safe_action_route_only"
      },
      "operator_evidence_path": [
        "summary-first app operator read model",
        "full detail lazy load",
        "safe action dry-run",
        "safe action execute",
        "receipt/count refresh after execute",
        "authority boundary fields"
      ],
      "must_show": [
        "runtime state",
        "source surface",
        "repair action when available",
        "operator evidence acceptance state",
        "summary-first app operator read model",
        "full detail lazy load",
        "safe action dry-run/execute controls",
        "receipt/count refresh after execute",
        "route graph and decision map refs",
        "review and repair queue",
        "artifact gallery and package/export lifecycle refs",
        "memory refs and writeback receipt refs",
        "quality/readiness refs",
        "provider SLO and repair refs",
        "owner-aware action routing",
        "safe action dry-run and execute result refs"
      ],
      "must_not_own": [
        "runtime truth",
        "provider implementation",
        "domain truth",
        "memory body",
        "artifact body",
        "quality/readiness/export verdict",
        "action route authority",
        "domain action approval override"
      ]
    },
    {
      "id": "settings_overview",
      "expected_source": "App settings and OPL environment summary",
      "must_show": ["current app version", "executor boundary", "environment state"]
    },
    {
      "id": "environment",
      "expected_source": "OPL system initialize / module / skill surfaces",
      "must_show": ["Codex default path", "module state", "repair command when needed"]
    },
    {
      "id": "about",
      "expected_source": "packaged App metadata and release channel",
      "must_show": ["product name", "version", "release channel"]
    },
    {
      "id": "update",
      "expected_source": "standard updater metadata",
      "must_show": ["standard package update state"],
      "must_not_show": ["Full first-install asset as standard update"]
    },
    {
      "id": "first_launch_readiness",
      "expected_source": "first-run wizard and OPL initialize result",
      "must_show": ["required setup state", "completion state", "blocking error source"]
    }
  ]
}
