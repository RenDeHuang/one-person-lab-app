{
  "schema_version": 1,
  "owner": "one-person-lab-app",
  "purpose": "active_shell_adapter",
  "state": "active",
  "app_repo": "gaofeng21cn/one-person-lab-app",
  "active_shell": "hermes-codex",
  "shell_root": "shells/hermes",
  "runtime_bridge_contract": "contracts/app-runtime-bridge.json",
  "upstream_family": "Hermes Agent/Codex",
  "shell_source": {
    "owner_repo": "NousResearch/hermes-agent",
    "default_ref": "main",
    "checkout_path": "shells/hermes",
    "history_policy": "external_checkout_not_merged_into_app_default_branch",
    "upstream_ref": "apps/desktop"
  },
  "release_role": "experimental_candidate_shell",
  "candidate_stage": "upstream_feature_comparison_minimal_opl_adapter",
  "architecture_policy": {
    "baseline_order": [
      "official_hermes_desktop_feature_baseline_first",
      "hermes_native_feature_comparison_recorded_before_opl_surface_growth",
      "minimal_opl_delta_applied_after_baseline_is_observable"
    ],
    "minimal_delta": [
      "opl_candidate_branding",
      "simplified_chinese_and_english_copy_via_hermes_i18n",
      "opl_icon_and_bundle_metadata",
      "macos_icon_safe_margin",
      "opl_app_managed_bootstrap_for_first_run",
      "model_access_api_key_configuration",
      "renderer_safe_profile_config_bootstrap_routes",
      "opl_defaults_seed_for_codex_runtime_and_domain_skills",
      "app_root_explicit_candidate_packaging"
    ],
    "extension_points": {
      "codex": "fixed ordinary executor route through Hermes openai-codex plus codex_app_server defaults",
      "med-autoscience": "Codex Skill/Plugin/MCP extension through Hermes skills.external_dirs and Codex app-server structured skill input",
      "policy": "extension points must not replace the complete Hermes backend or own OPL runtime truth"
    },
    "ordinary_user_experience": "wrapped Codex App experience on top of Hermes Desktop",
    "webui_strategy": "same Hermes React/Vite renderer with desktop IPC and browser transport adapters"
  },
  "app_server_adapter_contract": {
    "owner": "one-person-lab-app",
    "gateway_route": "codex app-server --listen stdio://",
    "ordinary_chat_route": "Hermes chat turn -> OPL Codex gateway -> Codex app-server thread/start turn/start event stream",
    "required_events": [
      "thread/start",
      "turn/start",
      "item/agentMessage/delta",
      "turn/completed"
    ],
    "forbidden_backends": [
      "Hermes Agent installer as ordinary executor",
      "provider-selected backend",
      "AionUI release shell backend"
    ]
  },
  "model_access_policy": {
    "ordinary_provider": "gflabtoken",
    "api_key_env": "OPENAI_API_KEY",
    "provider_base_url": "https://gflabtoken.cn/v1",
    "default_model": "gpt-5.5",
    "reasoning_effort": "xhigh",
    "ordinary_ui_surfaces": [
      "model access wizard",
      "Settings Access tab"
    ],
    "forbidden_ordinary_controls": [
      "OPENAI_BASE_URL",
      "provider marketplace",
      "OAuth provider accounts",
      "custom provider key",
      "second Auto model id"
    ]
  },
  "agent_route_contract": {
    "owner": "one-person-lab-app",
    "route_authority": "App-owned Codex Skill declaration only; Codex remains the invocation authority and runtime/domain truth remain in OPL Framework and domain repos",
    "ordinary_entries": [
      {
        "id": "med-autoscience",
        "label": "科研",
        "route": "codex-skill:med-autoscience",
        "authority": "med-autoscience"
      },
      {
        "id": "med-autogrant",
        "label": "基金",
        "route": "codex-skill:med-autogrant",
        "authority": "med-autogrant"
      },
      {
        "id": "redcube-ai",
        "label": "演示",
        "route": "codex-skill:redcube-ai",
        "authority": "redcube-ai"
      }
    ],
    "required_surface": "composer Codex Skill entries plus structured Codex skill input plus Settings Agents & Capabilities summaries",
    "forbidden_claims": [
      "domain_ready",
      "agent_runtime_authority",
      "artifact_authority",
      "quality_verdict"
    ]
  },
  "settings_information_architecture": {
    "ordinary_tabs": [
      "General",
      "Access",
      "Agents & Capabilities",
      "Local Environment",
      "Storage",
      "Appearance",
      "Advanced",
      "About & Updates"
    ],
    "opl_semantics": [
      "模型策略",
      "模型访问",
      "智能体与能力",
      "本机环境",
      "存储",
      "外观与语言",
      "高级与诊断",
      "关于与更新"
    ],
    "hidden_or_advanced": [
      "Hermes backend selection",
      "provider marketplace",
      "OAuth provider accounts",
      "custom Base URL",
      "remote terminal backend",
      "Hermes memory provider",
      "raw JSON-RPC gateway state"
    ],
    "ordinary_access_policy": "show_only_gflabtoken_api_key_and_current_codex_model_access_status"
  },
  "visual_parity_contract": {
    "comparison_baseline": "AionUI active release shell",
    "minimum_bar": "not_lower_than_aionui_for_chat_first_reading_composer_settings_and_packaged_smoke_visual_quality",
    "required_evidence": [
      "desktop screenshot comparison against AionUI baseline",
      "settings screenshot comparison against AionUI baseline",
      "packaged app screenshot or VM smoke artifact"
    ],
    "docs_or_contract_only_completion_allowed": false
  },
  "gui_authority": {
    "source_of_truth": "one-person-lab-app",
    "implementation_role": "active_shell_implementation_carrier",
    "product_contracts": [
      "contracts/app-gui-product-contract.json",
      "contracts/app-runtime-bridge.json",
      "contracts/app-product-profile.json",
      "contracts/app-install-exposure-policy.json",
      "contracts/app-page-state-matrix.json",
      "contracts/app-first-run-test-matrix.json",
      "contracts/app-release-channel.json"
    ],
    "shell_may_own": [
      "concrete renderer implementation",
      "process and preload implementation",
      "shell package metadata",
      "shell tests and release hooks",
      "Hermes desktop implementation experiments",
      "shell-local implementation details",
      "shell-local tests that prove App contracts are implemented"
    ],
    "shell_must_not_own": [
      "App GUI product truth",
      "App user-facing page-state authority",
      "App model-selection policy",
      "App onboarding policy",
      "App release/user documentation authority",
      "App release gate policy",
      "OPL runtime truth",
      "domain truth",
      "provider implementation"
    ],
    "upstream_intake_policy": "check_against_app_owned_gui_contracts_before_acceptance"
  },
  "shell_replacement_policy": {
    "candidate_root_pattern": "shells/<candidate>",
    "candidate_state": "candidate_until_contracts_and_tests_complete",
    "authority_transfer_allowed": false,
    "adoption_gate": [
      "declare candidate in contracts/app-shell-candidates.json",
      "implement contracts/app-gui-product-contract.json",
      "sync App product profile into the candidate shell target",
      "pass App page-state and first-run matrices",
      "pass App-root active shell validation",
      "pass GUI package compile through App wrapper",
      "preserve external checkout history policy"
    ]
  },
  "shell_contract": {
    "layout_id": "hermes_codex_desktop_bundle",
    "source_topology": "external_checkout_linked_shell_repo",
    "implementation_validation": "minimal_opl_branding_official_backend_and_defaults_seed",
    "paths": {
      "package_manifest": "package.json",
      "agents_guide": "AGENTS.md",
      "vitest_config": "package.json",
      "electron_builder_config": "package.json",
      "build_output_dir": "out",
      "product_profile_target": "package.json",
      "packaged_runtime_root": "package.json",
      "packaged_runtime_validator": "scripts/validate-hermes-codex-candidate.cjs",
      "release_prepare_script": "scripts/package-opl-candidate-app.cjs",
      "release_verify_script": "scripts/validate-hermes-codex-candidate.cjs"
    },
    "capabilities": [
      "upstream_hermes_desktop_feature_baseline_preserved",
      "candidate_app_bundle_package",
      "opl_branding_and_icon_replaced",
      "official_hermes_backend_preserved",
      "opl_defaults_seed_for_codex_runtime_and_domain_skills",
      "codex_app_server_backed_hermes_gateway_adapter",
      "app_owned_gui_product_contract",
      "app_owned_runtime_bridge_contract",
      "app_gui_release_channel_gating",
      "official_hermes_desktop_baseline_first",
      "minimal_opl_branding_i18n_icon_packaging_delta",
      "opl_app_managed_bootstrap_for_first_run",
      "model_access_api_key_configuration",
      "opl_first_run_initialization_owner",
      "macos_icon_safe_margin",
      "renderer_safe_profile_config_bootstrap_routes",
      "codex_mas_route_extension_not_backend_replacement",
      "codex_app_wrapper_user_experience_target",
      "hermes_i18n_zh_en_ui",
      "future_webui_same_renderer"
    ]
  },
  "first_run_contract": {
    "owner": "opl_app_cli",
    "ui_reuse_policy": "reuse_hermes_onboarding_module_and_progress_ui_only",
    "forbidden_default_action": "download_or_execute_hermes_agent_installer",
    "startup_model": "lightweight_startup_check_then_chat_first",
    "startup_check_sequence": [
      "check-opl-app-initialization-marker",
      "check-one-person-lab-cli",
      "check-codex-cli",
      "check-opl-app-state-fast-readiness",
      "check-gflabtoken-model-access",
      "check-codex-adapter-startup"
    ],
    "one_time_initialization_trigger": [
      "failed-lightweight-readiness-probe-after-missing-or-stale-marker",
      "missing-one-person-lab-core-components"
    ],
    "one_time_initialization_sequence": [
      "opl-cli-check",
      "codex-cli-check",
      "prepare-local-directories-and-config",
      "opl-core-readiness-check",
      "opl-core-install-or-repair-when-needed",
      "write-opl-app-initialization-marker"
    ],
    "model_access_wizard": {
      "trigger": "missing_or_invalid_gflabtoken_api_key_or_model_access_unavailable",
      "api_key_provider": "gflabtoken",
      "api_key_command": "opl system configure-codex --api-key-stdin --json",
      "provider_base_url": "https://gflabtoken.cn/v1",
      "default_model": "gpt-5.5",
      "api_key_env": "OPENAI_API_KEY",
      "ordinary_ui_policy": "show_only_model_access_api_key_no_base_url_provider_marketplace_or_oauth_accounts"
    },
    "background_refresh_sequence": [
      "opl system initialize --json",
      "opl system startup-maintenance --json",
      "opl system reconcile-modules --json",
      "mas_mag_rca_status_refresh",
      "contracts_diagnostics_refresh"
    ],
    "blocking_policy": "full_opl_initialize_and_module_refresh_must_not_block_hot_launch_or_chat_after_light_check_passes",
    "skip_to_chat_policy": {
      "trigger": "user_may_skip_non_core_or_slow_first_run_preparation_when_codex_adapter_can_start",
      "marker_state": "user_deferred",
      "must_not_claim": [
        "gflabtoken_api_key_configured",
        "module_reconcile_complete",
        "mas_mag_rca_domain_ready",
        "full_opl_readiness"
      ]
    },
    "api_key_missing_behavior": "show_opl_model_access_onboarding_without_running_hermes_agent_install",
    "api_key_present_behavior": "auto_continue_to_opl_codex_adapter_without_waiting_for_setup_runtime_check_or_api_key_form",
    "ready_check": "lightweight startup check: CLI available, fast app state proves Codex installed and model access status, core components discoverable when required, Codex adapter startable; missing or stale marker alone refreshes marker after successful fast probe and does not trigger full initialize",
    "packaged_smoke_must_prove": [
      "no install.sh or install.ps1 fetch or execution",
      "hot launch with fresh marker and model access does not run blocking full opl system initialize",
      "first launch with missing marker and usable fast app state does not run blocking full opl system initialize or show installation checklist",
      "missing or stale marker routes to the OPL one-time initialization checklist only when lightweight fast state probe cannot prove readiness",
      "one-time initialization writes or refreshes the OPL App initialization marker",
      "missing API key routes to model access wizard without showing the installation checklist",
      "user skip on first-run checklist closes the overlay and starts the Codex adapter",
      "user-deferred setup.status reports onboarding_deferred without marking gflabtoken API key configured",
      "background OPL status refresh starts only after the main chat surface is visible",
      "OPL Codex adapter starts",
      "existing Codex model access configuration auto-skips onboarding",
      "official Hermes OAuth provider route returns an empty renderer-safe provider list"
    ]
  },
  "icon_contract": {
    "source": "OPL/AionUI official icon asset family",
    "macos_safe_margin_required": true,
    "max_alpha_bounds_px": 900,
    "current_expected_alpha_bounds_px": "840x840+92+92",
    "applies_to": [
      "assets/icon.png",
      "assets/icon.icns",
      "public/apple-touch-icon.png",
      "packaged .app Contents/Resources icon"
    ]
  },
  "validation_commands": [
    {
      "id": "candidate_contract",
      "cwd": ".",
      "command": "node --experimental-strip-types scripts/validate-hermes-candidate.ts"
    },
    {
      "id": "candidate_app_bundle_build",
      "cwd": ".",
      "command": "OPL_APP_SHELL_ADAPTER_CONTRACT=contracts/shell-adapters/hermes-codex.json npm run package"
    },
    {
      "id": "candidate_packaged_first_run_smoke",
      "cwd": ".",
      "command": "npm --prefix shells/hermes run smoke:opl-first-run"
    }
  ],
  "manual_verification_commands": [
    {
      "id": "candidate_packaged_settings_visual_smoke",
      "cwd": ".",
      "command": "npm --prefix shells/hermes run smoke:settings-visual -- --allow-foreground --out out/smoke-settings-visual",
      "policy": "manual_or_vm_foreground_only"
    }
  ],
  "gui_product_contract": "contracts/app-gui-product-contract.json",
  "gui_product_contract_policy": {
    "must_implement": true,
    "source_of_truth": "one-person-lab-app",
    "upstream_override_allowed": false,
    "upstream_family_role": "implementation_material_only",
    "upstream_must_not_override_app_truth": true
  },
  "state_surface_contract": {
    "primary_read_command": "opl app state --profile fast --json",
    "refresh_read_command": "opl app state --profile fast --json",
    "full_state_read_command": "opl app state --profile full --json",
    "full_state_policy": "diagnostic_or_release_evidence_only",
    "action_command": "opl app action execute --action <action_id> [--payload json] [--dry-run] --json",
    "full_drilldown_exception": "opl runtime app-operator-drilldown --detail full --json",
    "forbidden_gui_truth_sources": [
      "direct opl connect modules --json page aggregation",
      "direct opl system developer-supervisor page aggregation",
      "direct opl family-runtime worker status page aggregation",
      "application.systemInfo as OPL path truth",
      "application.appVersions as OPL release truth",
      "direct reads of OPL internal state files"
    ]
  },
  "deferred_until_feature_comparison": {
    "policy": "do_not_port_old_aionui_or_agui_stable_surfaces_until_hermes_native_feature_comparison_is_recorded",
    "surfaces": [
      "opl_app_state_action_bridge",
      "app_product_profile_generated_config",
      "page_state_matrix_mapping",
      "first_run_matrix_mapping",
      "packaged_full_runtime",
      "standard_release_asset_normalization",
      "standard_release_asset_verification",
      "webui_parity"
    ]
  }
}
