  "schema_version": 1,
  "schema": "opl_app_gui_visual_reference_cohort.v1",
  "owner": "one-person-lab-app",
  "state": "app_owned_baseline_governance_active",
  "machine_boundary": "Defines the App-owned scene matrix and comparison semantics for OPL visual regression. External products are design references only; their artifacts are not required inputs and cannot own Pixel, Install, Release, product authority, or Stable admission.",
  "reference": {
    "owner": "one-person-lab-app",
    "baseline_id": "opl-app-approved-visual-baseline-v1",
    "state": "capture_and_human_approval_required",
    "allowed_states": [
      "capture_and_human_approval_required",
      "approved"
    ],
    "approval_receipt_schema": "opl_app_gui_visual_baseline_approval_receipt.v1",
    "approval_receipt_file": null,
    "approval_receipt_sha256": null,
    "platform": "macos",
    "reference_role": "app_owned_pixel_regression_baseline",
    "external_product_artifact_required": false,
    "stable_release_dependency": false
  },
  "candidate": {
    "product": "One Person Lab App",
    "shell": "opl-aion-shell",
    "app_contract_ref": "contracts/app-gui-product-contract.json#gui_maintenance_policy.visual_comparison_protocol",
    "shell_source_ref": "active_shell_checkout_git_head",
    "comparison_tool": "scripts/compare-gui-visual-cohort.ts"
  },
  "shared_primitive_contract": {
    "authority": "one-person-lab-app",
    "shell_role": "thin_implementation_overlay",
    "primitive_ids": [
      "composer",
      "rail_row",
      "icon_button",
      "menu",
      "settings_row"
    ],
    "shell_class_bindings": {
      "composer": "opl-codex-composer",
      "rail_row": "opl-codex-rail-row",
      "icon_button": "opl-codex-icon-button",
      "menu": "opl-codex-menu",
      "settings_row": "opl-codex-settings-row"
    },
    "new_component_framework_allowed": false,
    "upstream_authority_transfer_allowed": false
  },
  "capture_contract": {
    "reference_and_candidate_same_machine_required": true,
    "reference_and_candidate_same_display_scale_required": true,
    "reference_and_candidate_same_viewport_required": true,
    "reference_and_candidate_same_theme_locale_route_state_required": true,
    "supported_viewports": {
      "desktop": {
        "width": 1440,
        "height": 900
      },
      "narrow": {
        "width": 400,
        "height": 800
      }
    },
    "themes": [
      "light",
      "dark"
    ],
    "locales": [
      "zh-CN",
      "en-US"
    ],
    "required_surface_families": [
      "home",
      "conversation",
      "rail",
      "settings"
    ],
    "reference_directory_layout": "one_png_per_scene_named_<scene_id>.png",
    "candidate_directory_layout": "one_png_per_scene_named_<scene_id>.png"
  },
  "comparison_contract": {
    "pixel_channel_delta_threshold": 8,
    "changed_pixel_ratio_max": 0.015,
    "mean_absolute_channel_delta_max": 1.5,
    "alpha_channel_included": true,
    "dimension_mismatch": "fail",
    "missing_scene": "fail",
    "diff_png_required": true,
    "mask_policy": {
      "default": "none",
      "declaration_required": true,
      "maximum_masked_area_ratio": 0.08,
      "allowed_reasons": [
        "caret_blink",
        "os_window_chrome_dynamic",
        "live_status_timestamp"
      ],
      "undeclared_dynamic_region": "fail"
    },
    "human_review": {
      "required": true,
      "binding_fields": [
        "scene_id",
        "reference_screenshot_sha256",
        "candidate_screenshot_sha256",
        "verdict"
      ],
      "accepted_verdict": "accepted"
    },
    "scene_bound_visual_parity_requires": [
      "exact_binding_complete",
      "dimensions_equal",
      "pixel_thresholds_passed",
      "visual_delta_reviewed"
    ]
  },
