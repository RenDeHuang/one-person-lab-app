{
  "surface_kind": "opl_app_agent_package_launch_state_matrix.v1",
  "authority": "one-person-lab-app",
  "release_scope": "trusted_local_thin_shell",
  "read_and_action_sources": {
    "status": "opl app state --profile fast --json",
    "activation": "opl app action execute --action agent_package_activate --payload <json> --json",
    "status_and_dry_run_write_count": 0
  },
  "exposure_state": {
    "fields": [
      "enabled",
      "visibility"
    ],
    "visibility_values": [
      "visible",
      "hidden"
    ],
    "transitions": {
      "hide": {
        "enabled": "preserve",
        "visibility": "hidden"
      },
      "unhide": {
        "enabled": "preserve",
        "visibility": "visible"
      },
      "disable": {
        "enabled": false,
        "visibility": "preserve"
      },
      "enable": {
        "enabled": true,
        "visibility": "preserve"
      }
    }
  },
  "cases": [
    {
      "case_id": "ready_visible_enabled",
      "installed": true,
      "package_role": "standard_agent",
      "readiness": "ready",
      "exposure": {
        "enabled": true,
        "visibility": "visible"
      },
      "activation_required_before_launch": true,
      "ordinary_discovery_visible": true,
      "explicit_launch_allowed_after_activation": true
    },
    {
      "case_id": "verification_deferred_visible_enabled",
      "installed": true,
      "package_role": "standard_agent",
      "readiness": "verification_deferred",
      "exposure": {
        "enabled": true,
        "visibility": "visible"
      },
      "activation_required_before_launch": true,
      "ordinary_discovery_visible": true,
      "explicit_launch_allowed_after_activation": true
    },
    {
      "case_id": "activation_required_visible_enabled",
      "installed": true,
      "package_role": "standard_agent",
      "readiness": "activation_required",
      "exposure": {
        "enabled": true,
        "visibility": "visible"
      },
      "activation_required_before_launch": true,
      "ordinary_discovery_visible": true,
      "explicit_launch_allowed_after_activation": true
    },
    {
      "case_id": "disabled_visible_standard_agent",
      "installed": true,
      "package_role": "standard_agent",
      "readiness": "blocked",
      "exposure": {
        "enabled": false,
        "visibility": "visible"
      },
      "activation_required_before_launch": false,
      "blocked_reason": "package_disabled",
      "ordinary_discovery_visible": false,
      "explicit_launch_allowed_after_activation": false
    },
    {
      "case_id": "hidden_enabled_standard_agent",
      "installed": true,
      "package_role": "standard_agent",
      "readiness": "ready",
      "exposure": {
        "enabled": true,
        "visibility": "hidden"
      },
      "activation_required_before_launch": true,
      "ordinary_discovery_visible": false,
      "explicit_launch_allowed_after_activation": true,
      "retained_shortcut_launch_allowed_after_activation": true
    },
    {
      "case_id": "not_installed_standard_agent",
      "installed": false,
      "package_role": "standard_agent",
      "readiness": "not_installed",
      "exposure": null,
      "activation_required_before_launch": false,
      "blocked_reason": "package_not_installed",
      "ordinary_discovery_visible": false,
      "explicit_launch_allowed_after_activation": false
    },
    {
      "case_id": "installed_capability_package",
      "installed": true,
      "package_role": "framework_capability_package",
      "readiness": "ready",
      "exposure": {
        "enabled": true,
        "visibility": "hidden"
      },
      "activation_required_before_launch": false,
      "ordinary_discovery_visible": false,
      "explicit_launch_allowed_after_activation": false
    },
    {
      "case_id": "installed_workflow_profile",
      "installed": true,
      "package_role": "workflow_profile",
      "readiness": "ready",
      "exposure": {
        "enabled": true,
        "visibility": "hidden"
      },
      "activation_required_before_launch": false,
      "ordinary_discovery_visible": false,
      "explicit_launch_allowed_after_activation": false
    },
    {
      "case_id": "installed_standard_agent_lock_corrupt",
      "installed": true,
      "package_role": "standard_agent",
      "readiness": "blocked",
      "exposure": {
        "enabled": true,
        "visibility": "visible"
      },
      "activation_required_before_launch": false,
      "blocked_reason": "package_lock_corrupt",
      "ordinary_discovery_visible": true,
      "explicit_launch_allowed_after_activation": false
    },
    {
      "case_id": "recovery_in_progress",
      "installed": true,
      "package_role": "standard_agent",
      "readiness": "blocked",
      "exposure": {
        "enabled": true,
        "visibility": "visible"
      },
      "activation_required_before_launch": false,
      "blocked_reason": "package_recovery_in_progress",
      "read_surfaces_are_pure": [
        "fast",
        "list",
        "status",
        "dry_run"
      ],
      "recovery_action": {
        "state": "wait_only",
        "enabled": false
      },
      "explicit_launch_allowed_after_activation": false
    },
    {
      "case_id": "recovery_required_executable",
      "installed": true,
      "package_role": "standard_agent",
      "readiness": "blocked",
      "exposure": {
        "enabled": true,
        "visibility": "visible"
      },
      "activation_required_before_launch": false,
      "blocked_reason": "package_recovery_required",
      "read_surfaces_are_pure": [
        "fast",
        "list",
        "status",
        "dry_run"
      ],
      "recovery_action": {
        "state": "executable",
        "enabled": true,
        "action_id": "agent_package_repair"
      },
      "explicit_launch_allowed_after_activation": false
    },
    {
      "case_id": "recovery_required_manual_owner_intervention",
      "installed": true,
      "package_role": "standard_agent",
      "readiness": "blocked",
      "exposure": {
        "enabled": true,
        "visibility": "visible"
      },
      "activation_required_before_launch": false,
      "blocked_reason": "package_recovery_required",
      "read_surfaces_are_pure": [
        "fast",
        "list",
        "status",
        "dry_run"
      ],
      "recovery_action": {
        "state": "manual_owner_intervention_required",
        "enabled": false
      },
      "explicit_launch_allowed_after_activation": false
    }
  ],
  "workspace_transition_contract": {
    "primary_unit": "canonical_session_thread",
    "workspace_role": "mutable_context",
    "cases": [
      {
        "case_id": "workspace_a_to_b",
        "package_backed": true,
        "fresh_minimal_validation_required_before_next_launch": true
      },
      {
        "case_id": "workspace_b_to_c_validation_failure",
        "package_backed": true,
        "accepted": false,
        "reason_code": "agent_package_target_mismatch",
        "session_remains_recoverable": true
      },
      {
        "case_id": "plain_conversation_workspace_transition",
        "package_backed": false,
        "activation_required": false,
        "behavior": "unchanged"
      }
    ]
  },
  "normal_shell_launch_contract": {
    "cases": [
      {
        "case_id": "framework_blocked",
        "accepted": false,
        "reason_code": "agent_package_launch_blocked"
      },
      {
        "case_id": "malformed_activation",
        "accepted": false,
        "reason_code": "agent_package_activation_invalid"
      },
      {
        "case_id": "selection_drift",
        "accepted": false,
        "reason_code": "agent_package_selection_mismatch"
      },
      {
        "case_id": "version_drift",
        "accepted": false,
        "reason_code": "agent_package_version_mismatch"
      },
      {
        "case_id": "target_drift",
        "accepted": false,
        "reason_code": "agent_package_target_mismatch"
      },
      {
        "case_id": "valid_package_launch",
        "accepted": true,
        "selected_identity_matches": true,
        "target_matches": true
      },
      {
        "case_id": "plain_conversation",
        "package_backed": false,
        "activation_required": false,
        "accepted": true
      }
    ]
  }
}
