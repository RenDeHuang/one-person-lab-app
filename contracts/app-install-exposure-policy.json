{
  "schema_version": 1,
  "owner": "one-person-lab-app",
  "purpose": "app_install_exposure_policy",
  "state": "active",
  "machine_boundary": "App-owned installation and Codex-visible exposure policy. OPL Framework owns install/sync producers, generated family surfaces, action execution, and read models. Domain agents own skill semantics, domain handlers, action/stage truth, quality verdicts, and artifact authority.",
  "producer_owner": "one-person-lab",
  "product_authority": {
    "source_of_truth": "one-person-lab-app",
    "policy_scope": [
      "which installer surfaces must expose progress",
      "which App user path surfaces hide skill/plugin mechanics",
      "which Codex-visible companion entries are expected after App-managed setup",
      "which release gates prove the policy"
    ],
    "forbidden_authority": [
      "runtime_truth",
      "provider_implementation",
      "domain_truth",
      "domain_quality_verdict",
      "domain_artifact_authority"
    ]
  },
  "canonical_metadata_sources": {
    "owner": "one-person-lab",
    "domain_owner": "foundry_agent_repositories",
    "sources": [
      "family_action_catalog",
      "family_stage_control_plane",
      "family-product-entry-manifest-v2"
    ],
    "derived_surfaces": [
      "cli",
      "mcp",
      "skill",
      "product_entry",
      "product_status",
      "product_session",
      "domain_action_adapter",
      "workbench"
    ],
    "policy": "App, CLI, plugin-packaged skills, direct skills, and product-entry surfaces must consume the same domain-owned action/stage metadata instead of maintaining parallel semantic maps."
  },
  "public_abi": {
    "primary_semantic_entry": "skill",
    "skill_role": "public_codex_semantic_entry_and_prompt_contract",
    "plugin_role": "codex_app_distribution_and_capability_bundle",
    "command_contract_role": "machine_readable_action_and_stage_contract_under_the_skill",
    "product_entry_role": "domain_owned_product_entry_manifest_and_session_surface",
    "direct_skill_compatibility_required": true,
    "plugin_may_package_skill": true,
    "plugin_must_not_create_second_semantics": true,
    "app_must_not_require_plugin_for_cli_semantics": true,
    "app_must_not_mirror_plugin_skill_as_duplicate_bare_skill": true
  },
  "exposure_classes": [
    {
      "id": "family_domain_plugin_surfaces",
      "owner": "one-person-lab",
      "members": [
        "mas",
        "mag",
        "rca",
        "opl-bookforge"
      ],
      "default_app_visible": true,
      "sync_target": "codex_plugin_registry",
      "must_not_sync_to": [
        "~/.codex/skills/mas",
        "~/.codex/skills/mag",
        "~/.codex/skills/rca",
        "~/.codex/skills/opl-bookforge"
      ]
    },
    {
      "id": "opl_generated_plugin_surfaces",
      "owner": "one-person-lab",
      "members": [
        "opl-meta-agent",
        "opl-bookforge"
      ],
      "default_app_visible": false,
      "sync_target": "opl_generated_codex_plugin_surface",
      "must_not_sync_to": [
        "default_home_assistant_entry"
      ]
    },
    {
      "id": "companion_skill_sync",
      "owner": "one-person-lab",
      "members": [
        "superpowers",
        "cron",
        "officecli",
        "officecli-docx",
        "officecli-pptx",
        "officecli-xlsx",
        "officecli-academic-paper",
        "officecli-data-dashboard",
        "officecli-financial-model",
        "officecli-pitch-deck",
        "pdf",
        "mineru-document-extractor",
        "ui-ux-pro-max"
      ],
      "default_app_visible": true,
      "sync_target": "codex_user_skill_discovery_path",
      "must_not_sync_to": [
        "domain_plugin_semantic_mirror"
      ]
    },
    {
      "id": "packaged_full_runtime_payloads",
      "owner": "one-person-lab-app",
      "members": [
        "runtime_payloads",
        "domain_modules",
        "companion_skill_payloads",
        "native_helpers"
      ],
      "default_app_visible": false,
      "sync_target": "bundled_runtime_payload_refs",
      "must_not_sync_to": [
        "implicit_user_codex_skill_install_without_managed_sync"
      ]
    }
  ],
  "domain_exposure": [
    {
      "domain_id": "mas",
      "display_name": "Med Auto Science",
      "home_purpose_entry": "research",
      "default_home_visible": true,
      "codex_visible_entry": "mas",
      "preferred_app_distribution": "plugin_packaged_skill",
      "direct_skill_semantics_required": true,
      "canonical_metadata_source": "domain_action_catalog_and_stage_control_plane"
    },
    {
      "domain_id": "mag",
      "display_name": "Med Auto Grant",
      "home_purpose_entry": "grant",
      "default_home_visible": true,
      "codex_visible_entry": "mag",
      "preferred_app_distribution": "plugin_packaged_skill",
      "direct_skill_semantics_required": true,
      "canonical_metadata_source": "domain_action_catalog_and_stage_control_plane"
    },
    {
      "domain_id": "rca",
      "display_name": "RedCube AI",
      "home_purpose_entry": "ppt",
      "default_home_visible": true,
      "codex_visible_entry": "rca",
      "preferred_app_distribution": "plugin_packaged_skill",
      "direct_skill_semantics_required": true,
      "canonical_metadata_source": "domain_action_catalog_and_stage_control_plane"
    },
    {
      "domain_id": "bookforge",
      "display_name": "OPL BookForge",
      "home_purpose_entry": "book",
      "default_home_visible": true,
      "codex_visible_entry": "opl-bookforge",
      "preferred_app_distribution": "opl_generated_codex_plugin_surface",
      "direct_skill_semantics_required": true,
      "canonical_metadata_source": "opl_generated_interface_contract_pack"
    },
    {
      "domain_id": "oma",
      "display_name": "OPL Meta Agent",
      "home_purpose_entry": null,
      "default_home_visible": false,
      "codex_visible_entry": "opl-meta-agent",
      "preferred_app_distribution": "opl_generated_codex_plugin_surface",
      "direct_skill_semantics_required": true,
      "canonical_metadata_source": "opl_generated_interface_contract_pack"
    }
  ],
  "installer_surfaces": [
    {
      "surface": "app_first_run",
      "entrypoint": "One Person Lab.app",
      "primary_audience": "beginner_non_technical_users",
      "progress_source": "opl system initialize --json",
      "exposure_policy": "hide_skill_plugin_packaging_mechanics_by_default",
      "codex_exposure_owner": "app_or_cli_managed_background_maintenance"
    },
    {
      "surface": "full_first_install_dmg",
      "entrypoint": "One-Person-Lab-Full-<version>-mac-arm64.dmg",
      "primary_audience": "beginner_non_technical_users",
      "progress_source": "opl system initialize --json",
      "exposure_policy": "bundle_runtime_payloads_then_continue_codex_exposure_maintenance_after_core_ready",
      "codex_exposure_owner": "app_or_cli_managed_background_maintenance"
    },
    {
      "surface": "standard_dmg",
      "entrypoint": "One-Person-Lab-<version>-mac-arm64.dmg",
      "primary_audience": "beginner_non_technical_users",
      "progress_source": "opl system initialize --json",
      "exposure_policy": "app_managed_bootstrap_then_background_codex_exposure_maintenance",
      "codex_exposure_owner": "app_or_cli_managed_background_maintenance"
    },
    {
      "surface": "stable_local_authorized_macos_install",
      "entrypoint": "install.sh --stable-macos-install --yes",
      "compatibility_entrypoints": [
        "install-stable.sh"
      ],
      "primary_audience": "beginner_non_technical_users",
      "progress_source": "github_release_dmg_copy_and_local_quarantine_diagnostics",
      "exposure_policy": "one_terminal_command_download_copy_authorize_and_open_as_stable_release_path",
      "codex_exposure_owner": "app_or_cli_managed_background_maintenance",
      "stable_release_path": true,
      "default_package_profile": "full",
      "required_commands": [
        "curl",
        "hdiutil attach -nobrowse -readonly",
        "ditto",
        "xattr -dr com.apple.quarantine",
        "codesign --verify --deep --strict --verbose=2",
        "spctl --assess --type execute --verbose=4",
        "open"
      ]
    },
    {
      "surface": "unsigned_local_app_authorization",
      "entrypoint": "install.sh --authorize-local-app-only",
      "primary_audience": "developer_or_internal_test_users",
      "progress_source": "local_quarantine_and_gatekeeper_diagnostics",
      "exposure_policy": "explicit_user_confirmed_quarantine_removal_for_existing_local_app",
      "codex_exposure_owner": "not_applicable",
      "stable_release_replacement_allowed": false,
      "required_commands": [
        "xattr -dr com.apple.quarantine",
        "codesign --verify --deep --strict --verbose=2",
        "spctl --assess --type execute --verbose=4"
      ]
    },
    {
      "surface": "one_shot_cli_installer",
      "entrypoint": "install.sh",
      "primary_audience": "terminal_users",
      "progress_source": "opl system initialize --json",
      "exposure_policy": "print_shared_progress_without_separate_installer_truth",
      "codex_exposure_owner": "opl_framework"
    },
    {
      "surface": "docker_webui",
      "entrypoint": "Docker/WebUI one-click installer",
      "primary_audience": "server_or_webui_users",
      "progress_source": "opl system initialize --json",
      "exposure_policy": "one_click_installer_is_beginner_default_with_manual_docker_as_advanced_troubleshooting_path",
      "codex_exposure_owner": "opl_framework",
      "installer_model": {
        "primary_user_path": "one_click_installer",
        "linux_macos_shell_script": "install-docker-webui.sh",
        "windows_powershell_script": "install-docker-webui.ps1",
        "linux_macos_online_command": "curl -fsSL https://raw.githubusercontent.com/gaofeng21cn/one-person-lab-app/main/scripts/install-docker-webui.sh | bash -s -- --yes",
        "windows_online_command": "download install-docker-webui.ps1 from raw.githubusercontent.com and run with -Yes",
        "windows_prerequisite_mode": "explicit_install_prerequisites_switch_requires_administrator",
        "compose_file": "compose.yaml",
        "installer_outputs": [
          "host_data_dir",
          "host_projects_dir",
          "compose.yaml",
          "browser_webui_url"
        ],
        "persistent_host_dirs": [
          "OnePersonLab/data",
          "OnePersonLab/projects"
        ],
        "container_mounts": {
          "data": "/data",
          "projects": "/projects"
        },
        "api_key_policy": "never_pass_api_key_on_cli_or_environment_for_beginner_path",
        "api_key_entry_surface": "browser_webui_first_run_access_panel_or_settings_access",
        "manual_docker_fallback": "advanced_troubleshooting_path_only",
        "manual_fallback_forms": [
          "docker run",
          "docker compose"
        ],
        "online_availability_claim_policy": "repo_contract_and_artifacts_only_until_release_or_publish_receipt_exists"
      },
      "runtime_distribution_model": {
        "container_role": "preheated_webui_runtime_image",
        "first_visible_surface": "browser_webui",
        "persistent_data_dir": "/data",
        "persistent_projects_dir": "/projects",
        "default_profile": "webui_full",
        "profile_policy": {
          "webui_full": "beginner_default_with_payload_capable_seed_and_fast_first_start",
          "webui_slim": "developer_or_ci_only_metadata_seed_online_reconcile"
        },
        "stable_latest_policy": "latest_and_stable_must_point_to_webui_full_not_metadata_only_slim",
        "required_image_manifest": "/opt/opl/image-manifest.json",
        "required_seed_metadata": "/opt/opl/seed/metadata.json",
        "required_full_seed_components": [
          "opl_framework",
          "codex_cli",
          "companion_skills",
          "domain_modules"
        ],
        "image_update_scope": [
          "webui_shell",
          "aioncore",
          "launcher",
          "bootstrap",
          "base_linux_layer",
          "preheated_seed_payload"
        ],
        "opl_managed_update_scope": [
          "opl_framework",
          "codex_cli",
          "companion_skills",
          "domain_modules",
          "managed_toolchain"
        ],
        "status_surfaces": [
          "opl system initialize --json",
          "opl system startup-maintenance --json",
          "opl update status --json",
          "opl update plan --json"
        ],
        "rule": "Docker/WebUI presents a browser-first install experience; image updates and OPL-managed runtime/module updates are separate planes, and user state remains in mounted host directories."
      },
      "smoke_gate_contract": {
        "status": "required_manual_or_workflow_gate_not_live_evidence",
        "release_readiness_policy": "must_not_claim_release_ready_until_required_smoke_gates_have_fresh_artifacts_or_typed_blockers",
        "workflow_artifact": "docker-webui-smoke-gate-contract.json",
        "workflow_import": {
          "desktop_release_workflow": ".github/workflows/desktop-release.yml",
          "validation_job": "docker-webui-clean-vm-evidence",
          "linux_input": "docker_webui_clean_linux_evidence_artifact",
          "windows_input": "docker_webui_clean_windows_evidence_artifact",
          "validation_artifact": "docker-webui-clean-vm-evidence-<version>",
          "aggregate_summary": "docker-webui-clean-vm-evidence-validation.json",
          "linux_summary": "clean_linux_vm-validation-summary.json",
          "windows_summary": "clean_windows_vm-validation-summary.json",
          "accepted_result_file": "docker-webui-smoke-gate-result.json",
          "linux_default_producer": "desktop_release_same_job_ubuntu_clean_vm_generated",
          "linux_manual_producer_workflow": ".github/workflows/docker-webui-clean-linux-vm.yml",
          "windows_import_manifest": "windows-smoke-evidence.json",
          "missing_artifact_status": "typed_blocker",
          "missing_artifact_blocker_codes": [
            "missing_clean_linux_vm_docker_webui_evidence_artifact",
            "missing_clean_windows_vm_docker_webui_evidence_artifact"
          ],
          "readiness_admission_requires_passed_validation": true
        },
        "diagnostic_bundle_artifacts": [
          "compose.yaml",
          "docker ps",
          "docker logs",
          "http_health_readback",
          "api_key_flow_evidence",
          "auth_user_readback",
          "install_manifest_readback",
          "projects_mount_readback"
        ],
        "health_check_surfaces": [
          "http://localhost:3000/",
          "http://localhost:3000/manifest.webmanifest",
          "http://localhost:3000/api/auth/user",
          "OnePersonLab/data/opl/state/install-manifest.json",
          "OnePersonLab/projects"
        ],
        "required_gates": [
          {
            "id": "clean_linux_vm",
            "environment": "clean_linux_vm",
            "entrypoint": "install-docker-webui.sh --yes",
            "docker_state": "docker_engine_preinstalled_or_installed_by_explicit_admin_prerequisite",
            "data_state": "new_OnePersonLab_data_dir",
            "execution_mode": "desktop_release_same_job_ubuntu_clean_vm_smoke_or_manual_vm_smoke",
            "required_evidence": [
              "installer_stdout_stderr",
              "compose_yaml",
              "docker_ps",
              "container_logs",
              "http_health_readback",
              "api_key_flow_evidence",
              "auth_user_readback",
              "install_manifest_readback",
              "projects_mount_readback"
            ]
          },
          {
            "id": "clean_windows_vm",
            "environment": "clean_windows_vm",
            "entrypoint": "install-docker-webui.ps1 -Yes",
            "docker_state": "docker_desktop_running_or_installed_by_explicit_administrator_prerequisite",
            "data_state": "new_OnePersonLab_data_dir",
            "execution_mode": "manual_or_workflow_vm_smoke",
            "required_evidence": [
              "powershell_stdout_stderr",
              "compose_yaml",
              "docker_ps",
              "container_logs",
              "http_health_readback",
              "api_key_flow_evidence",
              "auth_user_readback",
              "install_manifest_readback",
              "projects_mount_readback"
            ]
          },
          {
            "id": "existing_docker",
            "environment": "host_with_existing_docker_engine",
            "entrypoint": "one_click_installer_against_existing_docker",
            "docker_state": "existing_docker_must_be_reused_not_reinstalled",
            "data_state": "new_OnePersonLab_data_dir",
            "execution_mode": "workflow_smoke_or_manual_smoke",
            "required_evidence": [
              "docker_version",
              "compose_yaml",
              "container_logs",
              "http_health_readback",
              "api_key_flow_evidence",
              "auth_user_readback",
              "install_manifest_readback",
              "projects_mount_readback"
            ]
          },
          {
            "id": "existing_old_onepersonlab_data_dir",
            "environment": "host_with_existing_OnePersonLab_data",
            "entrypoint": "one_click_installer_against_existing_data_dir",
            "docker_state": "docker_available",
            "data_state": "existing_OnePersonLab_data_dir_must_be_preserved_or_migrated_without_delete",
            "execution_mode": "manual_or_workflow_migration_smoke",
            "required_evidence": [
              "preexisting_data_inventory",
              "migration_or_preservation_log",
              "compose_yaml",
              "container_logs",
              "http_health_readback",
              "api_key_flow_evidence",
              "install_manifest_readback",
              "post_smoke_data_inventory"
            ]
          }
        ],
        "false_ready_boundary": {
          "docs_or_contract_only_can_claim_release_ready": false,
          "local_container_smoke_can_replace_clean_vm_smoke": false,
          "missing_gate_must_be_typed_blocker": true
        }
      }
    }
  ],
  "first_run_user_presentation": {
    "default_mode": "beginner_first",
    "skill_plugin_distinction_visible_by_default": false,
    "primary_message": "One Person Lab is preparing Codex and the workspace.",
    "primary_steps": [
      "workspace_root",
      "codex_cli",
      "codex_config"
    ],
    "secondary_steps": [
      "domain_modules",
      "family_runtime_provider",
      "recommended_skills",
      "native_helpers",
      "repo_sync",
      "command_line_tools_install",
      "ecosystem_module_updates"
    ],
    "technical_detail_policy": "hidden_until_expanded_or_error",
    "mature_project_pattern_refs": [
      "github_desktop_clone_flow",
      "vscode_getting_started_entry",
      "electron_auto_updater_downloaded_restart_prompt",
      "apple_clt_system_installer"
    ]
  },
  "setup_flow_contract": {
    "source_command": "opl system initialize --json",
    "source_path": "system_initialize.setup_flow",
    "truth_policy": "all_installers_and_renderers_derive_progress_from_the_shared_initialize_model",
    "ready_to_launch_gate": "ready_to_launch",
    "ready_to_launch_required_core_items": [
      "workspace_root",
      "codex_cli",
      "codex_config"
    ],
    "first_conversation_readiness": {
      "gate": "acp_warmup_before_initial_send",
      "source_command": "opl system initialize --json",
      "ready_to_launch_must_be_true": true,
      "must_wait_for": [
        "conversation_record_ready",
        "acp_warmup_complete"
      ],
      "must_not_wait_for": [
        "domain_modules",
        "family_runtime_provider",
        "recommended_skills",
        "native_helpers",
        "repo_sync",
        "command_line_tools_install",
        "ecosystem_module_updates"
      ],
      "failure_policy": "show_retryable_initial_message_error_without_losing_user_prompt"
    },
    "full_readiness_non_blocking_items": [
      "domain_modules",
      "family_runtime_provider",
      "recommended_skills",
      "native_helpers",
      "repo_sync",
      "command_line_tools_install",
      "ecosystem_module_updates"
    ]
  },
  "temporal_auto_configuration": {
    "owner": "one-person-lab",
    "app_role": "configure_defaults_and_surface_readiness_not_provider_implementation",
    "provider_env_default": "OPL_FAMILY_RUNTIME_PROVIDER=temporal",
    "local_service_defaults": {
      "address_env": "OPL_TEMPORAL_ADDRESS",
      "default_address": "127.0.0.1:7233",
      "namespace_env": "OPL_TEMPORAL_NAMESPACE",
      "default_namespace": "default",
      "task_queue_env": "OPL_TEMPORAL_TASK_QUEUE",
      "default_task_queue": "opl-stage-attempts"
    },
    "managed_commands": [
      "opl family-runtime service start --provider temporal",
      "opl family-runtime worker status --provider temporal",
      "opl family-runtime worker start --provider temporal",
      "opl family-runtime residency proof --provider temporal --production"
    ],
    "auto_configuration_entrypoints": [
      "opl install",
      "opl system initialize --json",
      "opl system startup-maintenance"
    ],
    "startup_maintenance_policy": {
      "must_export_local_defaults_before_provider_checks": true,
      "must_surface_service_worker_and_dependency_diagnostics": true,
      "must_not_block_ready_to_launch_on_worker_residency": true,
      "must_fail_closed_when_packaged_temporal_payload_is_missing": true
    },
    "first_run_policy": {
      "ready_to_launch_blocking": false,
      "full_readiness_item": "family_runtime_provider",
      "background_maintenance_owner": "app_or_cli_managed_background_maintenance",
      "required_diagnostics": [
        "temporal_cli_version",
        "temporal_service_lifecycle",
        "temporal_worker_lifecycle_status",
        "worker_dependency_health"
      ]
    },
    "packaged_runtime_policy": {
      "full_wrapper_must_export_defaults": true,
      "must_include_temporal_cli_wrapper": true,
      "temporal_cli_wrapper_must_execute_offline_archive": true,
      "must_include_temporal_node_runtime_packages": true,
      "must_exclude_temporal_testing_package": true,
      "native_core_bridge_target": "aarch64-apple-darwin"
    },
    "fail_closed_states": [
      "missing_temporal_cli_wrapper",
      "missing_temporal_node_runtime_package",
      "temporal_worker_dependency_unavailable",
      "temporal_local_service_stale_state",
      "temporal_worker_process_exited",
      "temporal_worker_source_stale"
    ]
  },
  "runtime_toolchain_auto_update": {
    "owner": "one-person-lab-app",
    "producer_owner": "one-person-lab",
    "app_role": "define_update_policy_surface_release_channel_and_install_exposure",
    "framework_role": "apply_verified_staged_runtime_during_startup_maintenance",
    "entrypoint": "opl system startup-maintenance",
    "ready_to_launch_blocking": false,
    "default_policy": {
      "auto_check": true,
      "download": "silent_background",
      "stage": "verify_then_stage_app_owned_runtime",
      "apply": "next_app_restart",
      "rollback": "previous_runtime_pointer_on_startup_smoke_failure"
    },
    "managed_components": [
      "codex_cli_fallback",
      "temporal_cli_archive",
      "node_runtime",
      "python_runtime",
      "uv_runtime",
      "officecli",
      "mineru_open_api",
      "companion_skills",
      "native_helper",
      "opl_framework_runtime"
    ],
    "user_global_tool_policy": {
      "prefer_compatible_newer_system_tool": true,
      "silent_homebrew_upgrade_allowed": false,
      "silent_system_tool_mutation_allowed": false,
      "opt_in_global_upgrade_surface": "Developer Profile explicit maintenance action"
    },
    "clean_machine_requirement": {
      "full_first_install_must_remain_self_contained": true,
      "required_release_smoke": "full_dmg_clean_vm_smoke",
      "standard_core_ready_must_not_require_homebrew_node_git_or_clt": true
    },
    "fail_closed_states": [
      "runtime_update_manifest_invalid",
      "runtime_update_asset_sha256_mismatch",
      "runtime_update_capability_smoke_failed",
      "runtime_update_startup_smoke_failed"
    ]
