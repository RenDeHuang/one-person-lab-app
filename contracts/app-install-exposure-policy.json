  "installer_surfaces": [
    {
      "surface": "app_first_run",
      "entrypoint": "One Person Lab.app",
      "primary_audience": "beginner_non_technical_users",
      "progress_source": "opl system initialize --json",
      "exposure_policy": "hide_skill_plugin_packaging_mechanics_by_default",
      "codex_exposure_owner": "app_or_cli_managed_background_maintenance"
    },
    {
      "surface": "full_first_install_dmg",
      "entrypoint": "One-Person-Lab-Full-<version>-mac-arm64.dmg",
      "primary_audience": "beginner_non_technical_users",
      "progress_source": "opl system initialize --json",
      "exposure_policy": "bundle_runtime_payloads_then_continue_codex_exposure_maintenance_after_core_ready",
      "codex_exposure_owner": "app_or_cli_managed_background_maintenance"
    },
    {
      "surface": "standard_dmg",
      "entrypoint": "One-Person-Lab-<version>-mac-arm64.dmg",
      "primary_audience": "beginner_non_technical_users",
      "progress_source": "opl system initialize --json",
      "exposure_policy": "app_managed_bootstrap_then_background_codex_exposure_maintenance",
      "codex_exposure_owner": "app_or_cli_managed_background_maintenance"
    },
    {
      "surface": "stable_local_authorized_macos_install",
      "entrypoint": "install-stable.sh",
      "backing_entrypoint": "install.sh --stable-macos-install --yes",
      "primary_audience": "beginner_non_technical_users",
      "progress_source": "github_release_dmg_copy_and_local_quarantine_diagnostics",
      "exposure_policy": "one_terminal_command_download_copy_authorize_and_open_as_stable_release_path",
      "codex_exposure_owner": "app_or_cli_managed_background_maintenance",
      "stable_release_path": true,
      "default_package_profile": "full",
      "required_commands": [
        "curl",
        "hdiutil attach -nobrowse -readonly",
        "ditto",
        "xattr -dr com.apple.quarantine",
        "codesign --verify --deep --strict --verbose=2",
        "spctl --assess --type execute --verbose=4",
        "open"
      ]
    },
    {
      "surface": "unsigned_local_app_authorization",
      "entrypoint": "install.sh --authorize-local-app-only",
      "primary_audience": "developer_or_internal_test_users",
      "progress_source": "local_quarantine_and_gatekeeper_diagnostics",
      "exposure_policy": "explicit_user_confirmed_quarantine_removal_for_existing_local_app",
      "codex_exposure_owner": "not_applicable",
      "stable_release_replacement_allowed": false,
      "required_commands": [
        "xattr -dr com.apple.quarantine",
        "codesign --verify --deep --strict --verbose=2",
        "spctl --assess --type execute --verbose=4"
      ]
    },
    {
      "surface": "one_shot_cli_installer",
      "entrypoint": "install.sh",
      "primary_audience": "terminal_users",
      "progress_source": "opl system initialize --json",
      "exposure_policy": "print_shared_progress_without_separate_installer_truth",
      "codex_exposure_owner": "opl_framework"
    },
    {
      "surface": "docker_webui",
      "entrypoint": "Docker/WebUI",
      "primary_audience": "server_or_webui_users",
      "progress_source": "opl system initialize --json",
      "exposure_policy": "show_cli_backed_status_without_desktop_plugin_semantics",
      "codex_exposure_owner": "opl_framework"
    }
  ],
  "first_run_user_presentation": {
    "default_mode": "beginner_first",
    "skill_plugin_distinction_visible_by_default": false,
    "primary_message": "One Person Lab is preparing Codex and the workspace.",
    "primary_steps": [
      "workspace_root",
      "codex_cli",
      "codex_config"
    ],
    "secondary_steps": [
      "domain_modules",
      "family_runtime_provider",
      "recommended_skills",
      "native_helpers",
      "repo_sync",
      "command_line_tools_install",
      "ecosystem_module_updates"
    ],
    "technical_detail_policy": "hidden_until_expanded_or_error",
    "mature_project_pattern_refs": [
      "github_desktop_clone_flow",
      "vscode_getting_started_entry",
      "electron_auto_updater_downloaded_restart_prompt",
      "apple_clt_system_installer"
    ]
