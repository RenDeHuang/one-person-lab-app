        "officecli-financial-model",
        "officecli-pitch-deck",
        "pdf",
        "mineru-document-extractor",
        "ui-ux-pro-max"
      ],
      "default_app_visible": true,
      "sync_target": "codex_user_skill_discovery_path",
      "must_not_sync_to": [
        "domain_plugin_semantic_mirror"
      ]
    },
    {
      "id": "packaged_full_runtime_payloads",
      "owner": "one-person-lab-app",
      "members": [
        "runtime_payloads",
        "domain_modules",
        "companion_skill_payloads",
        "native_helpers"
      ],
      "default_app_visible": false,
      "sync_target": "bundled_runtime_payload_refs",
      "must_not_sync_to": [
        "implicit_user_codex_skill_install_without_managed_sync"
      ]
    }
  ],
