{
  "schema_version": 1,
  "owner": "one-person-lab-app",
  "purpose": "app_owned_gui_product_contract",
  "state": "active",
  "machine_boundary": "App-owned GUI product requirements for active shell implementations. This contract defines user-facing GUI truth and allowed state/action surfaces; it does not own OPL runtime truth, provider implementation, domain truth, quality verdicts, or artifact authority.",
  "active_shell": "aionui",
  "implementation_carrier": "opl-aion-shell",
  "product_authority": {
    "source_of_truth": "one-person-lab-app",
    "active_shell_role": "implementation_carrier",
    "upstream_gui_role": "implementation_material_only",
    "upstream_behavior_acceptance_policy": "must_match_app_owned_gui_product_contract_before_release"
  },
  "framework_surfaces": {
    "canonical_state": {
      "schema": "opl_app_state.v1",
      "default_command": "opl app state --profile fast --json",
      "refresh_command": "opl app state --profile fast --json",
      "default_profile": "fast",
      "manual_refresh_profile": "fast",
      "page_load_policy": "fast_state_first_no_page_wide_spinner",
      "failure_policy": "section_level_status_with_last_good_display_cache_allowed",
      "full_profile_policy": "diagnostic_or_release_evidence_only"
    },
    "canonical_action": {
      "command": "opl app action execute --action <action_id> [--payload json] [--dry-run] --json",
      "policy": "mutating_work_uses_explicit_app_action_route"
    },
    "runtime_full_drilldown": {
      "command": "opl runtime app-operator-drilldown --detail full --json",
      "policy": "on_demand_only"
    },
    "forbidden_gui_truth_sources": [
      "direct opl modules --json page aggregation",
      "direct opl system developer-supervisor page aggregation",
      "direct opl family-runtime worker status page aggregation",
      "application.systemInfo as OPL path truth",
      "application.appVersions as OPL release truth",
      "direct reads of OPL internal state files"
    ]
  },
  "executor_policy": {
    "default_executor": "codex_cli",
    "codex_cli_fixed_executor": true,
    "codex_only_default": true,
    "home_executor_selector_visible": false,
    "executor_tab_visible_when_single_executor": false,
    "default_model": "gpt-5.5",
    "default_model_strategy": "codex_cli_auto_latest_available_frontier",
    "default_reasoning_effort": "xhigh",
    "home_model_status_label": "自动",
    "home_model_status_label_en": "Auto",
    "home_model_status_policy": "display_auto_only_until_codex_cli_connected",
    "precise_model_display_policy": "technical_details_or_connected_state_only",
    "default_permission_mode": "full-access",
    "permission_mode_selector_visible_on_home": false,
    "model_selector_visible_on_new_conversation": false,
    "model_selector_visible_in_conversation": false,
    "model_selection_auto_option_visible": false,
    "user_model_override_allowed": false,
    "restore_auto_model_selection_allowed": false,
    "frontier_model_preference_order": [
      "gpt-5.5",
      "gpt-5.4",
      "gpt-5.3-codex",
      "gpt-5.2"
    ],
    "send_after_model_display_policy": "must_not_require_model_or_executor_choice_before_send"
  },
  "home_purpose_entries": [
    {
      "id": "research",
      "primary_label": "科研",
      "target_assistant_id": "mas",
      "target_assistant_short_name": "MAS",
      "display_policy": "purpose_first",
      "home_entry_policy": "visible_click_to_start"
    },
    {
      "id": "grant",
      "primary_label": "基金",
      "target_assistant_id": "mag",
      "target_assistant_short_name": "MAG",
      "display_policy": "purpose_first",
      "home_entry_policy": "visible_click_to_start"
    },
    {
      "id": "ppt",
      "primary_label": "PPT",
      "target_assistant_id": "rca",
      "target_assistant_short_name": "RCA",
      "display_policy": "purpose_first",
      "home_entry_policy": "visible_click_to_start"
    }
  ],
  "default_assistants": [
    {
      "id": "mas",
      "display_name": "Med Auto Science",
      "short_name": "MAS",
      "home_purpose_label": "科研",
      "home_entry_display_policy": "purpose_first",
      "role": "research_and_paper_agent",
      "home_entry_policy": "purpose_entry_target"
    },
    {
      "id": "mag",
      "display_name": "Med Auto Grant",
      "short_name": "MAG",
      "home_purpose_label": "基金",
      "home_entry_display_policy": "purpose_first",
      "role": "grant_authoring_agent",
      "home_entry_policy": "purpose_entry_target"
    },
    {
      "id": "rca",
      "display_name": "RedCube AI",
      "short_name": "RCA",
      "home_purpose_label": "PPT",
      "home_entry_display_policy": "purpose_first",
      "role": "presentation_and_visual_deliverable_agent",
      "home_entry_policy": "purpose_entry_target"
    }
  ],
  "non_default_assistants": [
    {
      "id": "oma",
      "display_name": "OPL Meta Agent",
      "short_name": "OMA",
      "role": "opl_agent_design_and_testing_agent",
      "home_entry_policy": "explicit_or_settings_only",
      "home_default_visible": false
    }
  ],
  "theme_and_branding": {
    "default_theme_id": "codex",
    "allowed_theme_ids": [
      "codex",
      "default-theme"
    ],
    "default_visible_product_name": "One Person Lab App",
    "legacy_upstream_branding_forbidden": true,
    "visible_branding_surfaces": [
      "desktop_app_icon",
      "window_title",
      "html_meta_title",
      "web_manifest",
      "pwa_icons",
      "login_page",
      "first_run_page",
      "about_page",
      "update_page",
      "api_request_headers",
      "development_app_name",
      "logs_and_userdata_display_names"
    ],
    "forbidden_visible_terms": [
      "AionUI",
      "Aion UI",
      "AionUi"
    ]
  },
  "settings_navigation": {
    "required_sections": [
      "system",
      "runtime",
      "about",
      "update",
      "theme"
    ],
    "source": "opl app state --profile fast --json",
    "refresh_source": "opl app state --profile fast --json",
    "policy": "Settings pages display App-owned product state and framework-owned refs without taking runtime or domain authority."
  },
  "first_launch_readiness_policy": {
    "launch_gate": "ready_to_launch",
    "ui_order": "before_guid",
    "core_required_items": [
      "workspace_root",
      "codex_cli",
      "codex_config"
    ],
    "full_readiness_items": [
      "domain_modules",
      "family_runtime_provider",
      "recommended_skills",
      "native_helpers",
      "repo_sync",
      "command_line_tools_install",
      "ecosystem_module_updates"
    ],
    "full_readiness_blocks_launch": false,
    "default_provider": "gflab",
    "default_base_url": "https://gflabtoken.cn/v1",
    "default_model": "gpt-5.5",
    "default_reasoning_effort": "xhigh",
    "default_executor": "codex_cli",
    "full_runtime_provider": "temporal",
    "progress_model": {
      "source_command": "opl system initialize --json",
      "source_path": "system_initialize.setup_flow",
      "renderer_truth_policy": "render_only_no_shell_private_progress_truth",
      "required_setup_flow_fields": [
        "phase",
        "ready_to_launch",
        "progress",
        "blocking_items",
        "maintenance_items"
      ],
      "required_progress_fields": [
        "ready_required_count",
        "total_required_count",
        "ready_full_readiness_count",
        "total_full_readiness_count",
        "ready_optional_count",
        "total_optional_count"
      ],
      "required_checklist_fields": [
        "item_id",
        "label",
        "status",
        "readiness_layer",
        "blocking",
        "severity",
        "next_visible_step",
        "detail_summary"
      ],
      "required_visible_elements": [
        "current initialization phase",
        "Core completed and total count",
        "Full readiness completed and total count",
        "background maintenance completed and total count",
        "blocking item list",
        "next visible step"
      ]
    },
    "beginner_presentation": {
      "audience": "beginner_non_technical_users",
      "presentation_mode": "simplified_first_run",
      "primary_user_goal": "reach_guid_with_codex_ready",
      "primary_steps": [
        "workspace_root",
        "codex_cli",
        "codex_config"
      ],
      "primary_progress_signal": "Core completed and total count",
      "advanced_progress_disclosure": "collapsed_or_secondary",
      "background_maintenance_presentation": "secondary_non_blocking",
      "technical_detail_policy": "hidden_until_expanded_or_error",
      "mature_project_pattern_refs": [
        "github_desktop_welcome",
        "vscode_getting_started",
        "homebrew_default_install",
        "rustup_default_install"
      ]
    }
  },
  "module_path_source_policy": {
    "source": "app_state.modules[].source + app_state.modules[].path + app_state.paths",
    "settings_page": "settings_runtime",
    "must_explain": [
      "whether a module comes from the bundled Full runtime payload",
      "whether a module comes from a local domain repository checkout",
      "whether a module is managed by App/CLI maintenance",
      "that module path display is refs-only and not domain truth authority"
    ],
    "must_not_use": [
      "AionUI local directory as OPL path truth",
      "shell package path as module source truth",
      "direct reads of domain repository internals"
    ]
  },
  "release_channel_policy": {
    "stable": {
      "channel_id": "stable",
      "source": "contracts/app-release-channel.json#release_validation_profiles.stable",
      "must_gate": [
        "release_boundary_contract",
        "active_shell_quick_validation",
        "standard_macos_arm64_build",
        "local_standard_asset_validation",
        "full_first_install_build",
        "remote_standard_and_full_release_verification",
        "standard_dmg_clean_vm_smoke",
        "full_dmg_clean_vm_smoke",
        "one_shot_app_installer_fresh_install_smoke",
        "docker_webui_smoke",
        "operator_evidence_bundle"
      ],
      "latest_policy": "stable_release_may_be_marked_latest_after_required_lanes_pass"
    },
    "nightly": {
      "channel_id": "nightly_standard",
      "source": "contracts/app-release-channel.json#release_validation_profiles.nightly_standard",
      "must_gate": [
        "release_boundary_contract",
        "standard_macos_arm64_build",
        "local_standard_asset_validation",
        "remote_standard_release_verification"
      ],
      "must_not_gate": [
        "full_first_install_build",
        "standard_dmg_clean_vm_smoke",
        "full_dmg_clean_vm_smoke",
        "one_shot_app_installer_fresh_install_smoke",
        "docker_webui_smoke",
        "operator_evidence_bundle"
      ],
      "latest_policy": "never_mark_latest"
    }
  },
  "retired_domain_agents": [
    {
      "id": "mds",
      "display_name": "Med Deep Scientist",
      "default_display_allowed": false,
      "policy": "historical_or_explicit_reference_only"
    }
  ],
  "pages": {
    "guid_home": {
      "state_source": "opl app state --profile fast --json",
      "refresh_source": "opl app state --profile fast --json",
      "executor_policy_ref": "executor_policy",
      "assistant_source_ref": "default_assistants",
      "purpose_entry_source_ref": "home_purpose_entries",
      "hero_prompt": "把研究、基金和汇报交给 One Person Lab 自动推进",
      "must_show": [
        "Codex CLI fixed executor experience",
        "Codex automatic model status label",
        "purpose-first assistants Research/Grant/PPT as click-to-start entries",
        "selected assistant shown as a compact @ purpose tag",
        "workspace selector",
        "file attachment control",
        "send action"
      ],
      "must_not_show": [
        "executor selector on the home input",
        "Aion CLI or Claude Code backend choices on the home input",
        "Codex model override selector on the home input",
        "permission mode selector on the home input",
        "OPL Meta Agent as a default home assistant",
        "selected assistant full name as the hero title",
        "retired Codex model choices",
        "nested input card frames"
      ]
    },
    "settings_system": {
      "state_source": "opl app state --profile fast --json",
      "refresh_source": "opl app state --profile fast --json",
      "sections": [
        "developer_mode",
        "paths",
        "opl_agent_codex_context"
      ],
      "must_show": [
        "Developer Mode effective state from app_state.developer_mode",
        "workspace path from app_state.paths",
        "logs path from app_state.paths",
        "OPL Agent Codex context"
      ],
      "must_not_show": [
        "delayed developer mode flip from a shell-local cache",
        "AionUI local directory as OPL path truth"
      ]
    },
    "settings_runtime": {
      "state_source": "opl app state --profile fast --json",
      "refresh_source": "opl app state --profile fast --json",
      "sections": [
        "core.codex",
        "provider.temporal",
        "modules",
        "assistants",
        "release"
      ],
      "module_path_source_policy_ref": "module_path_source_policy",
      "must_show": [
        "Codex CLI version and default profile from app_state.core",
        "Temporal status from app_state.provider.temporal",
        "MAS/MAG/RCA/OMA module version and source from app_state.modules",
        "module path source explanation",
        "section-level refresh state"
      ],
      "must_not_show": [
        "Med Deep Scientist as a default module",
        "page-wide spinner while one section refreshes",
        "GUI-owned Temporal restart judgment"
      ]
    },
    "about": {
      "state_source": "opl app state --profile fast --json",
      "refresh_source": "opl app state --profile fast --json",
      "sections": [
        "release"
      ],
      "must_show": [
        "One Person Lab App version",
        "GUI shell version",
        "OPL Framework revision",
        "Stable or Nightly channel",
        "localized update status"
      ],
      "must_not_show": [
        "AionUI version as the App version",
        "raw i18n keys",
        "raw update error codes as user-facing copy"
      ]
    },
    "update": {
      "state_source": "opl app state --profile fast --json",
      "refresh_source": "opl app state --profile fast --json",
      "sections": [
        "release"
      ],
      "must_show": [
        "Stable channel update state",
        "Nightly opt-in update state when enabled",
        "localized GitHub release check failure"
      ],
      "must_not_show": [
        "Full first-install asset as a standard updater target",
        "English update labels in Chinese UI"
      ]
    },
    "settings_theme": {
      "state_source": "opl app state --profile fast --json",
      "refresh_source": "opl app state --profile fast --json",
      "sections": [
        "theme"
      ],
      "must_show": [
        "Default theme option",
        "Codex theme option",
        "current theme from app_state.settings.theme",
        "theme choice as App product preference"
      ],
      "must_not_show": [
        "AionUI theme as product authority",
        "theme choice as runtime or domain readiness"
      ]
    },
    "runtime_status": {
      "state_source": "opl app state --profile fast --json",
      "refresh_source": "opl app state --profile fast --json",
      "summary_source": "app_state.operator.summary",
      "full_detail_source": "opl runtime app-operator-drilldown --detail full --json",
      "full_detail_policy": "on_demand_only",
      "must_show": [
        "summary-first OPL runtime status",
        "provider readiness from app_state.provider",
        "operator summary from app_state.operator",
        "safe action refs from app_state.actions"
      ],
      "must_not_own": [
        "runtime truth",
        "provider implementation",
        "domain truth",
        "memory body",
        "artifact body",
        "quality/readiness/export verdict",
        "action route authority"
      ]
    }
  }
}
