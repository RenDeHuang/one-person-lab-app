{
  "schema_version": 1,
  "owner": "one-person-lab-app",
  "purpose": "app_owned_settings_control_plane",
  "state": "active",
  "machine_boundary": "Hydrated settings registry input for active shell adapters. This contract owns Settings navigation, slots, legacy route resolution, extension anchor behavior, and state/action source classification. It does not own OPL runtime truth, provider implementation, domain truth, release readiness, or shell-local rendering details.",
  "source_contract_ref": "contracts/app-gui-product-contract.json#settings_navigation",
  "page_state_matrix_ref": "contracts/app-page-state-matrix.json#pages",
  "product_profile_projection_target": "settings.control_plane",
  "active_shell": "aionui",
  "shell_adapter_role": "render_host_and_route_adapter_only",
  "shell_adapter_slot": {
    "host_component": "SettingsHost",
    "adapter_slot": "SettingsShellAdapterSlot",
    "registry_source": "contracts/app-settings-control-plane.json",
    "adapter_contract_ref": "contracts/app-shell-adapter.json#implementation_probes.settings_control_plane_shell_adapter_slot",
    "shell_may_own": [
      "container layout",
      "tab switching",
      "extension tab mount/keep-alive",
      "route sync"
    ],
    "app_owns": [
      "tab order",
      "user semantics",
      "OPL page slots",
      "state/action sources",
      "upstream intake classification"
    ]
  },
  "ordinary_visible_tabs": [
    "general",
    "access",
    "capabilities",
    "environment",
    "storage",
    "appearance",
    "advanced"
  ],
  "default_route": "/settings/general",
  "route_identity_policy": "keep_current_shell_route_ids_distinct_from_user_facing_ia_groups",
  "ordinary_routes": [
    {
      "id": "general",
      "path": "/settings/general",
      "label_key": "settings.overview",
      "default_label_en": "Overview",
      "default_label_zh": "总览",
      "icon_token": "dashboard",
      "ia_group": "overview",
      "slot_id": "settings_general",
      "state_source": "opl app state --profile fast --json",
      "refresh_source": "opl app state --profile fast --json"
    },
    {
      "id": "access",
      "path": "/settings/access",
      "label_key": "settings.onboarding",
      "default_label_en": "Setup & Access",
      "default_label_zh": "开始使用",
      "icon_token": "access",
      "ia_group": "setup_access",
      "slot_id": "settings_access",
      "state_source": "opl app state --profile fast --json",
      "refresh_source": "opl app state --profile fast --json"
    },
    {
      "id": "capabilities",
      "path": "/settings/capabilities",
      "label_key": "settings.capabilities",
      "default_label_en": "Capabilities",
      "default_label_zh": "能力",
      "icon_token": "capabilities",
      "ia_group": "capabilities",
      "slot_id": "settings_capabilities",
      "state_source": "contracts/app-gui-product-contract.json#default_assistants + opl app state --profile fast --json",
      "refresh_source": "opl app state --profile fast --json"
    },
    {
      "id": "environment",
      "path": "/settings/environment",
      "label_key": "settings.maintenance",
      "default_label_en": "Maintenance & Updates",
      "default_label_zh": "维护",
      "icon_token": "maintenance",
      "ia_group": "maintenance",
      "slot_id": "settings_environment",
      "state_source": "opl app state --profile fast --json",
      "refresh_source": "opl app state --profile fast --json"
    },
    {
      "id": "storage",
      "path": "/settings/storage",
      "label_key": "settings.storage",
      "default_label_en": "Data & Storage",
      "default_label_zh": "数据与存储",
      "icon_token": "storage",
      "ia_group": "data_storage",
      "slot_id": "settings_storage",
      "state_source": "active shell local data lifecycle service + contracts/app-release-channel.json#local_data_lifecycle",
      "refresh_source": "Settings / Storage refresh inventory"
    },
    {
      "id": "appearance",
      "path": "/settings/appearance",
      "label_key": "settings.preferences",
      "default_label_en": "Preferences",
      "default_label_zh": "偏好",
      "icon_token": "appearance",
      "ia_group": "preferences",
      "slot_id": "settings_theme",
      "state_source": "opl app state --profile fast --json",
      "refresh_source": "opl app state --profile fast --json"
    },
    {
      "id": "advanced",
      "path": "/settings/advanced",
      "label_key": "settings.advanced",
      "default_label_en": "Advanced",
      "default_label_zh": "高级",
      "icon_token": "advanced",
      "ia_group": "advanced",
      "slot_id": "settings_advanced",
      "state_source": "opl app state --profile fast --json",
      "refresh_source": "opl app state --profile fast --json"
    }
  ],
  "secondary_pages": [
    {
      "id": "about",
      "path": "/settings/about",
      "ia_group": "advanced",
      "slot_id": "about",
      "visibility": "secondary_or_deep_link"
    },
    {
      "id": "update",
      "path": "/settings/update",
      "ia_group": "maintenance",
      "slot_id": "update",
      "visibility": "secondary_or_deep_link"
    },
    {
      "id": "theme",
      "path": "/settings/theme",
      "ia_group": "preferences",
      "slot_id": "settings_theme",
      "visibility": "secondary_or_deep_link"
    },
    {
      "id": "workspace",
      "path": "/settings/workspace",
      "ia_group": "overview",
      "slot_id": "workspace",
      "visibility": "secondary_or_deep_link"
    },
    {
      "id": "local-services",
      "path": "/settings/local-services",
      "ia_group": "maintenance",
      "slot_id": "local_services",
      "visibility": "secondary_or_deep_link"
    }
  ],
  "legacy_route_redirects": {
    "overview": "general",
    "runtime": "environment",
    "system": "advanced",
    "model": "environment",
    "agent": "capabilities",
    "assistants": "capabilities",
    "skills-hub": "capabilities?tab=skills",
    "tools": "capabilities?tab=tools",
    "display": "appearance",
    "webui": "access",
    "pet": "appearance",
    "about": "advanced"
  },
  "extension_anchor_remap": {
    "overview": "general",
    "runtime": "environment",
    "system": "advanced",
    "model": "environment",
    "agent": "capabilities",
    "assistants": "capabilities",
    "skills-hub": "capabilities",
    "tools": "capabilities",
    "display": "appearance",
    "webui": "access",
    "pet": "appearance",
    "about": "advanced"
  },
  "extension_tab_policy": {
    "anchored_tabs": "insert_before_or_after_remapped_ordinary_route",
    "unanchored_tabs": "insert_before_advanced",
    "unknown_anchor": "treat_as_unanchored",
    "legacy_anchor_remap_required": true
  },
  "slot_registry": {
    "settings_general": {
      "component_key": "OverviewSettings",
      "wrapper_policy": "host_provides_wrapper"
    },
    "settings_access": {
      "component_key": "AccessSettingsContent",
      "wrapper_policy": "host_provides_wrapper"
    },
    "settings_capabilities": {
      "component_key": "CapabilitiesSettingsContent",
      "wrapper_policy": "host_provides_wrapper",
      "subroute_query_param": "tab",
      "legacy_subroutes": {
        "skills-hub": "skills",
        "tools": "tools"
      }
    },
    "settings_environment": {
      "component_key": "RuntimeSettings",
      "wrapper_policy": "host_provides_wrapper"
    },
    "settings_storage": {
      "component_key": "StorageSettings",
      "wrapper_policy": "host_provides_wrapper"
    },
    "settings_theme": {
      "component_key": "AppearanceModalContent",
      "wrapper_policy": "host_provides_wrapper"
    },
    "settings_advanced": {
      "component_key": "SystemModalContent",
      "wrapper_policy": "host_provides_wrapper"
    }
  },
  "state_action_policy": {
    "default_state_source": "opl app state --profile fast --json",
    "default_refresh_source": "opl app state --profile fast --json",
    "full_profile_policy": "diagnostic_or_release_evidence_only",
    "action_route": "opl app action execute --action <action_id> [--payload <json>] [--dry-run] --json",
    "shell_must_not_own": [
      "runtime truth",
      "provider implementation",
      "domain truth",
      "owner receipts",
      "release readiness"
    ]
  },
  "page_adapter_policy": {
    "policy": "settings_pages_consume_explicit_view_model_adapters",
    "required_pages": {
      "access": {
        "route_id": "access",
        "adapter_entry": "packages/desktop/src/renderer/pages/settings/accessProjection.ts",
        "renderer_entry": "packages/desktop/src/renderer/pages/settings/sections/AccessSettings.tsx",
        "state_source": "opl app state --profile fast --json",
        "forbidden_sources": [
          "raw provider selector as ordinary UI",
          "direct provider implementation reads",
          "domain truth writes"
        ]
      },
      "environment": {
        "route_id": "environment",
        "adapter_entry": "packages/desktop/src/renderer/pages/settings/RuntimeSettings/runtimeSettingsViewModel.ts",
        "renderer_entry": "packages/desktop/src/renderer/pages/settings/sections/RuntimeSettings.tsx",
        "state_source": "opl app state --profile fast --json",
        "forbidden_sources": [
          "raw runtime projection as layout source",
          "owner receipt writes",
          "release readiness claims"
        ]
      },
      "storage": {
        "route_id": "storage",
        "adapter_entry": "packages/desktop/src/renderer/pages/settings/storageProjection.ts",
        "renderer_entry": "packages/desktop/src/renderer/pages/settings/StorageSettings/index.tsx",
        "state_source": "active shell local data lifecycle service + contracts/app-release-channel.json#local_data_lifecycle",
        "forbidden_sources": [
          "silent user artifact deletion",
          "cleanup without receipt policy"
        ]
      },
      "capabilities": {
        "route_id": "capabilities",
        "adapter_entry": "packages/desktop/src/renderer/pages/settings/capabilitiesProjection.ts",
        "renderer_entry": "packages/desktop/src/renderer/pages/settings/CapabilitiesSettings.tsx",
        "state_source": "contracts/app-gui-product-contract.json#default_assistants + opl app state --profile fast --json",
        "forbidden_sources": [
          "upstream unified catalog without allowlist",
          "Team MCP ordinary surface"
        ]
      }
    }
  },
  "visual_qa_policy": {
    "policy": "settings_control_center_visual_qa_is_shell_behavior_evidence",
    "required_viewports": [
      "desktop",
      "mobile"
    ],
    "required_routes": [
      "/settings/general",
      "/settings/access",
      "/settings/capabilities",
      "/settings/environment",
      "/settings/storage",
      "/settings/appearance",
      "/settings/advanced"
    ],
    "required_secondary_routes": [
      "/settings/workspace",
      "/settings/local-services"
    ],
    "required_status_anchors": [
      "diagnostics_collapsed_by_default",
      "state_changing_action_confirmation",
      "post_action_recovery_notice",
      "legacy_redirect_landing"
    ],
    "evidence_manifest": {
      "path": "tests/e2e/screenshots/settings-control-center-manifest.json",
      "required_fields": [
        "command",
        "commit",
        "viewport",
        "route",
        "screenshot_path",
        "status_anchors"
      ],
      "viewport_policy": "each required route is captured for desktop and mobile viewports",
      "secondary_route_policy": "workspace and local-services are captured or explicitly marked route_unit_covered with no screenshot claim"
    },
    "evidence_command": "E2E_SCREENSHOTS=1 bun run test:e2e -- tests/e2e/specs/navigation.e2e.ts --grep \"Settings Pages|Sidebar Navigation\"",
    "does_not_prove": [
      "release readiness",
      "packaged App readiness",
      "runtime currentness",
      "owner acceptance"
    ]
  },
  "upstream_intake_classification": {
    "accepted": [
      "layout styling fixes",
      "settings accessibility fixes",
      "extension tab rendering fixes",
      "i18n plumbing fixes"
    ],
    "adapt": [
      "skills or tools settings",
      "assistant settings",
      "provider or model setup",
      "remote access setup",
      "settings route changes"
    ],
    "redirect": [
      "Butler setup shortcuts",
      "WebUI primary setup",
      "raw provider configuration"
    ],
    "reject": [
      "AionUI Team ordinary surface",
      "shell-owned product IA",
      "shell-owned runtime truth",
      "backend/provider raw selector as ordinary App setup"
    ]
  },
  "upstream_intake_checklist": {
    "policy": "classify_aionui_settings_upstream_before_registry_or_slot_changes",
    "allowed_classifications": [
      "accepted",
      "adapt",
      "redirect",
      "reject"
    ],
    "required_steps": [
      "record the upstream Settings surface and user-visible behavior",
      "classify as accepted/adapt/redirect/reject before changing registry or slots",
      "bind accepted/adapt entries to SettingsHost or SettingsShellAdapterSlot evidence",
      "route redirect/reject entries through legacy redirects, extension anchor remap, or forbidden probes",
      "keep runtime truth, domain truth, provider implementation, owner receipts, and release readiness outside the shell adapter"
    ]
  },
  "validation_policy": {
    "contract_checks": [
      "ordinary routes hydrate from this control plane",
      "legacy redirects resolve through this control plane",
      "extension anchors remap through this control plane",
      "product profile projection matches this control plane",
      "page-state matrix route groups remain consistent"
    ],
    "shell_behavior_checks": [
      "ordinary tabs render in declared order",
      "legacy settings tabs do not render as ordinary tabs",
      "legacy routes redirect to App-owned routes",
      "extension tabs with legacy anchors remain visible",
      "unknown settings deep links redirect to nearest App-owned group"
    ],
    "source_probes_reserved_for": [
      "forbidden Team surface and mutations",
      "forbidden runtime truth sources",
      "forbidden shell-owned product IA"
    ]
  }
}
