    "evidence_manifest": {
      "path": "tests/e2e/screenshots/settings-control-center-manifest.json",
      "required_fields": [
        "command",
        "commit",
        "viewport",
        "route",
        "screenshot_path",
        "status_anchors"
      ],
      "viewport_policy": "each required route is captured for desktop and mobile viewports",
      "secondary_route_policy": "workspace and local-services are captured or explicitly marked route_unit_covered with no screenshot claim"
    },
    "evidence_command": "E2E_SCREENSHOTS=1 bun run test:e2e -- tests/e2e/specs/navigation.e2e.ts --grep \"Settings Pages|Sidebar Navigation\"",
    "does_not_prove": [
      "release readiness",
      "packaged App readiness",
      "runtime currentness",
      "owner acceptance"
    ],
    "release_currentness_separation": {
      "visual_qa_claim": "active_shell_settings_behavior_evidence_only",
      "release_or_currentness_claim": "requires_separate_release_owner_runtime_or_packaged_app_evidence",
      "forbidden_claims_from_manifest": [
        "release readiness",
        "packaged App readiness",
        "runtime currentness",
        "owner acceptance"
      ]
    }
  },
