      "container layout",
      "tab switching",
      "extension tab mount/keep-alive",
      "route sync"
    ],
    "app_owns": [
      "tab order",
      "user semantics",
      "OPL page slots",
      "state/action sources",
      "upstream intake classification"
    ]
  },
