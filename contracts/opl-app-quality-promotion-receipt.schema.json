{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://one-person-lab.dev/contracts/opl-app-quality-promotion-receipt.schema.json",
  "title": "OPL App Quality Promotion Receipt",
  "type": "object",
  "required": [
    "schema",
    "status",
    "operation",
    "generated_at",
    "subject",
    "source_classification",
    "promoted_classification",
    "qualification",
    "invariants",
    "receipt_digest"
  ],
  "properties": {
    "schema": {
      "const": "opl_app_quality_promotion_receipt.v1"
    },
    "status": {
      "const": "passed"
    },
    "operation": {
      "const": "promote_quality"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "subject": {
      "type": "object",
      "required": [
        "version",
        "release_tag",
        "source_commit",
        "component_manifest_digest",
        "component_manifest_sha256",
        "artifact"
      ],
      "properties": {
        "version": {
          "type": "string",
          "minLength": 1
        },
        "release_tag": {
          "type": "string",
          "minLength": 1
        },
        "source_commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "component_manifest_digest": {
          "$ref": "#/$defs/digest"
        },
        "component_manifest_sha256": {
          "$ref": "#/$defs/digest"
        },
        "artifact": {
          "$ref": "#/$defs/artifact"
        }
      },
      "additionalProperties": false
    },
    "source_classification": {
      "type": "object",
      "required": [
        "quality_status",
        "build_trigger",
        "preview_kind",
        "non_stable_notice"
      ],
      "properties": {
        "quality_status": {
          "const": "preview"
        },
        "build_trigger": {
          "enum": [
            "manual",
            "automated"
          ]
        },
        "preview_kind": {
          "enum": [
            "dev",
            "nightly"
          ]
        },
        "non_stable_notice": {
          "const": true
        }
      },
      "additionalProperties": false
    },
    "promoted_classification": {
      "type": "object",
      "required": [
        "quality_status",
        "build_trigger",
        "preview_kind",
        "source_preview_kind_preserved_as_provenance"
      ],
      "properties": {
        "quality_status": {
          "const": "stable"
        },
        "build_trigger": {
          "enum": [
            "manual",
            "automated"
          ]
        },
        "preview_kind": {
          "const": null
        },
        "source_preview_kind_preserved_as_provenance": {
          "const": true
        }
      },
      "additionalProperties": false
    },
    "qualification": {
      "type": "object",
      "required": [
        "stable_qualified",
        "stable_qualification_receipt_sha256",
        "passed_gates",
        "skipped_gates",
        "failed_gates"
      ],
      "properties": {
        "stable_qualified": {
          "const": true
        },
        "stable_qualification_receipt_sha256": {
          "$ref": "#/$defs/digest"
        },
        "passed_gates": {
          "$ref": "#/$defs/all_stable_gates"
        },
        "skipped_gates": {
          "type": "array",
          "maxItems": 0
        },
        "failed_gates": {
          "type": "array",
          "maxItems": 0
        }
      },
      "additionalProperties": false
    },
    "invariants": {
      "type": "object",
      "required": [
        "same_exact_artifact_digest",
        "immutable_manifest_rewrite",
        "latest_pointer_mutation",
        "promotion_receipt_is_separate_authority"
      ],
      "properties": {
        "same_exact_artifact_digest": {
          "const": true
        },
        "immutable_manifest_rewrite": {
          "const": false
        },
        "latest_pointer_mutation": {
          "const": false
        },
        "promotion_receipt_is_separate_authority": {
          "const": true
        }
      },
      "additionalProperties": false
    },
    "receipt_digest": {
      "$ref": "#/$defs/digest"
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "artifact": {
      "type": "object",
      "required": [
        "name",
        "digest",
        "size"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "$ref": "#/$defs/digest"
        },
        "size": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    "all_stable_gates": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "uniqueItems": true,
      "prefixItems": [
        {
          "const": "container_webui"
        },
        {
          "const": "full"
        },
        {
          "const": "homebrew_clean_install"
        },
        {
          "const": "native_webui"
        },
        {
          "const": "stable_heavy_vm"
        },
        {
          "const": "standard_vm"
        }
      ]
    }
  },
  "additionalProperties": false
}
