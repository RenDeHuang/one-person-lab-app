{
  "schema_version": 1,
  "owner": "one-person-lab-app",
  "purpose": "release_channel_contract",
  "state": "active",
  "release_repo": "gaofeng21cn/one-person-lab-app",
  "active_shell": "aionui",
  "shell_root": "shells/aionui",
  "standard_updater": {
    "allowed_metadata": [
      "latest-mac.yml",
      "latest-arm64-mac.yml"
    ],
    "allowed_assets": [
      "One-Person-Lab-*-mac-arm64.dmg",
      "One-Person-Lab-*-mac-arm64.zip",
      "One-Person-Lab-*-mac-arm64.dmg.blockmap",
      "One-Person-Lab-*-mac-arm64.zip.blockmap"
    ],
    "forbidden_asset_substrings": ["Full"],
    "rule": "standard updater metadata must never point to Full first-install assets"
  },
  "full_first_install": {
    "asset_name_must_include": "Full",
    "updater_visible": false,
    "validation_required": true,
    "generated_companion_text_language": "en",
    "same_tag_refresh": {
      "allowed": true,
      "mode": "github_release_upload_clobber",
      "scope": "Full first-install assets and Full release-note section only"
    },
    "payload_boundary": {
      "role": "declared_payload_assembly_and_validation",
      "allowed_actions": [
        "copy_declared_framework_runtime_payload",
        "copy_declared_domain_module_payloads",
        "copy_declared_foundry_agent_payloads",
        "copy_declared_companion_tool_payloads",
        "write_distribution_manifest",
        "write_checksums"
      ],
      "forbidden_authority": [
        "runtime_truth",
        "provider_implementation",
        "domain_truth",
        "domain_quality_verdict",
        "domain_artifact_authority"
      ],
      "truth_sources": [
        "gaofeng21cn/one-person-lab",
        "gaofeng21cn/opl-meta-agent",
        "gaofeng21cn/med-autoscience",
        "gaofeng21cn/med-autogrant",
        "gaofeng21cn/redcube-ai"
      ]
    }
  },
  "release_acceleration": {
    "plan_command": "npm run release:plan -- --version <version> --include-full-package",
    "full_runtime_cache": {
      "enabled_by_default": true,
      "mode_env": "OPL_FULL_RUNTIME_CACHE_MODE",
      "dir_env": "OPL_FULL_RUNTIME_CACHE_DIR",
      "default_dir": "~/Library/Caches/One Person Lab/full-runtime-layers",
      "layer_ids": [
        "toolchain",
        "domain-runtime",
        "opl-runtime",
        "skills"
      ]
    },
    "publish_resume": {
      "default": "skip_existing_assets_when_size_and_sha256_digest_match",
      "match_fields": [
        "asset_name",
        "size",
        "sha256"
      ],
      "force_flag": "--force-upload"
    },
    "vm_gate": {
      "source": "clean no-CLT Tart base clone",
      "display": "1920x1080px",
      "settings_smoke": true
    }
  },
  "normalization_command": "node --experimental-strip-types scripts/prepare-release-assets.ts build-artifacts release-assets",
  "validation_command": "node --experimental-strip-types scripts/validate-release.ts release-assets"
}
