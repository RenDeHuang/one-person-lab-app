{
  "schema_version": 1,
  "owner": "one-person-lab-app",
  "purpose": "release_channel_contract",
  "state": "active",
  "release_repo": "gaofeng21cn/one-person-lab-app",
  "active_shell": "aionui",
  "shell_root": "shells/aionui",
  "standard_updater": {
    "allowed_metadata": [
      "latest.yml",
      "latest-win-arm64.yml",
      "latest-mac.yml",
      "latest-arm64-mac.yml",
      "latest-linux.yml",
      "latest-linux-arm64.yml"
    ],
    "allowed_assets": [
      "One-Person-Lab-*-win-*.exe",
      "One-Person-Lab-*-mac-*.dmg",
      "One-Person-Lab-*-mac-*.zip",
      "One-Person-Lab-*-linux-*.deb"
    ],
    "forbidden_asset_substrings": ["Full"],
    "rule": "standard updater metadata must never point to Full first-install assets"
  },
  "full_first_install": {
    "asset_name_must_include": "Full",
    "updater_visible": false,
    "validation_required": true,
    "payload_boundary": {
      "role": "declared_payload_assembly_and_validation",
      "allowed_actions": [
        "copy_declared_framework_runtime_payload",
        "copy_declared_domain_module_payloads",
        "copy_declared_companion_tool_payloads",
        "write_distribution_manifest",
        "write_checksums"
      ],
      "forbidden_authority": [
        "runtime_truth",
        "provider_implementation",
        "domain_truth",
        "domain_quality_verdict",
        "domain_artifact_authority"
      ],
      "truth_sources": [
        "gaofeng21cn/one-person-lab",
        "gaofeng21cn/med-autoscience",
        "gaofeng21cn/med-autogrant",
        "gaofeng21cn/redcube-ai"
      ]
    }
  },
  "normalization_command": "node --experimental-strip-types scripts/prepare-release-assets.ts build-artifacts release-assets",
  "validation_command": "node --experimental-strip-types scripts/validate-release.ts release-assets"
}
