{
  "schema_version": 1,
  "owner": "one-person-lab-app",
  "purpose": "release_channel_contract",
  "state": "active",
  "release_repo": "gaofeng21cn/one-person-lab-app",
  "active_shell": "aionui",
  "shell_root": "shells/aionui",
  "standard_updater": {
    "allowed_metadata": [
      "latest-mac.yml",
      "latest-arm64-mac.yml"
    ],
    "allowed_assets": [
      "One-Person-Lab-*-mac-arm64.dmg",
      "One-Person-Lab-*-mac-arm64.zip",
      "One-Person-Lab-*-mac-arm64.dmg.blockmap",
      "One-Person-Lab-*-mac-arm64.zip.blockmap"
    ],
    "forbidden_asset_substrings": ["Full"],
    "rule": "standard updater metadata must never point to Full first-install assets",
    "same_tag_refresh": {
      "allowed": true,
      "mode": "github_actions_prebuilt_assets_upload_clobber",
      "scope": "standard App DMG, ZIP, blockmaps, and updater metadata for an existing release"
    }
  },
  "nightly_standard": {
    "prerelease": true,
    "full_first_install_allowed": false,
    "latest_release_allowed": false,
    "tag_pattern": "v<YY.M.D-nightly.YYYYMMDD>",
    "asset_scope": [
      "One-Person-Lab-<version>-mac-arm64.dmg",
      "One-Person-Lab-<version>-mac-arm64.zip",
      "One-Person-Lab-<version>-mac-arm64.dmg.blockmap",
      "One-Person-Lab-<version>-mac-arm64.zip.blockmap",
      "latest-mac.yml",
      "latest-arm64-mac.yml"
    ],
    "rule": "Nightly releases publish standard macOS arm64 updater assets only and remain visible only to prerelease opt-in update checks."
  },
  "full_first_install": {
    "asset_name_must_include": "Full",
    "updater_visible": false,
    "updater_metadata_allowed": false,
    "validation_required": true,
    "generated_companion_text_language": "en",
    "required_payloads": {
      "codex_cli": {
        "version_source": "npm view @openai/codex version",
        "install_rule": "install_exact_latest_npm_version",
        "receipt_env": "OPL_FULL_CODEX_VERSION",
        "runtime_path": "runtime/current/bin/codex",
        "verification": "codex --version must equal codex-cli <npm_latest>"
      },
      "temporal_runtime_provider": {
        "provider_env_default": "OPL_FAMILY_RUNTIME_PROVIDER=temporal",
        "required_packages": [
          "@temporalio/activity",
          "@temporalio/client",
          "@temporalio/common",
          "@temporalio/worker",
          "@temporalio/workflow"
        ],
        "forbidden_packages": ["@temporalio/testing"],
        "native_core_bridge_releases": ["aarch64-apple-darwin"],
        "verification": "Full manifest runtime_assertions.temporal_core_bridge_releases must be exactly aarch64-apple-darwin"
      }
    },
    "size_budget": {
      "platform_scope": "macos-arm64",
      "max_full_dmg_bytes": 550000000,
      "max_runtime_uncompressed_bytes": 800000000
    },
    "measurement_policy": {
      "full_dmg_bytes": "github_release_asset_size_bytes",
      "runtime_uncompressed_bytes": "manifest_size_breakdown_total_runtime_uncompressed_bytes"
    },
    "same_tag_refresh": {
      "allowed": true,
      "mode": "github_release_upload_clobber",
      "scope": "Full first-install assets and Full release-note section only"
    },
    "payload_boundary": {
      "role": "declared_payload_assembly_and_validation",
      "allowed_actions": [
        "copy_declared_framework_runtime_payload",
        "copy_declared_domain_module_payloads",
        "copy_declared_foundry_agent_payloads",
        "copy_declared_companion_tool_payloads",
        "write_distribution_manifest",
        "write_checksums"
      ],
      "forbidden_authority": [
        "runtime_truth",
        "provider_implementation",
        "domain_truth",
        "domain_quality_verdict",
        "domain_artifact_authority"
      ],
      "truth_sources": [
        "gaofeng21cn/one-person-lab",
        "gaofeng21cn/opl-meta-agent",
        "gaofeng21cn/med-autoscience",
        "gaofeng21cn/med-autogrant",
        "gaofeng21cn/redcube-ai"
      ]
    }
  },
  "release_acceleration": {
    "plan_command": "npm run release:plan -- --version <version> --include-full-package",
    "full_runtime_cache": {
      "enabled_by_default": true,
      "mode_env": "OPL_FULL_RUNTIME_CACHE_MODE",
      "dir_env": "OPL_FULL_RUNTIME_CACHE_DIR",
      "default_dir": "~/Library/Caches/One Person Lab/full-runtime-layers",
      "layer_ids": [
        "toolchain",
        "domain-runtime",
        "opl-runtime",
        "skills"
      ]
    },
    "full_runtime_packaging_hygiene": {
      "local_state_excluded": [
        ".codegraph",
        ".git",
        ".worktrees",
        ".venv",
        "node_modules",
        "runtime",
        "runtime-state",
        "runs",
        "sessions",
        "tests"
      ],
      "measurement_command": "npm run release:full:size -- --markdown",
      "domain_runtime_allowlist_owner": "domain_repositories",
      "app_policy": "exclude local indexes, dependency caches, tests, and user/runtime state; do not infer domain truth or artifact authority from package pruning"
    },
    "publish_resume": {
      "default": "skip_existing_assets_when_size_and_sha256_digest_match",
      "match_fields": [
        "asset_name",
        "size",
        "sha256"
      ],
      "force_flag": "--force-upload"
    },
    "post_publish_remote_verification": {
      "script": "npm run verify-remote-release -- --version <version>",
      "standard_required_assets": [
        "One-Person-Lab-<version>-mac-arm64.dmg",
        "One-Person-Lab-<version>-mac-arm64.zip",
        "One-Person-Lab-<version>-mac-arm64.dmg.blockmap",
        "One-Person-Lab-<version>-mac-arm64.zip.blockmap",
        "latest-mac.yml",
        "latest-arm64-mac.yml"
      ],
      "full_required_assets": [
        "One-Person-Lab-Full-<version>-mac-arm64.dmg",
        "full-package-manifest.json",
        "README-Full-First-Install.txt",
        "SHA256SUMS.txt"
      ],
      "checks": [
        "remote_asset_size",
        "remote_asset_sha256_digest",
        "standard_updater_metadata",
        "full_sha256sums",
        "full_manifest_distribution_boundary",
        "full_manifest_size_budget",
        "full_release_asset_size_budget",
        "full_runtime_uncompressed_size_budget",
        "full_readme_english_only"
      ]
    },
    "github_actions": {
      "desktop_release_workflow": ".github/workflows/desktop-release.yml",
      "new_release_mode": "new_release",
      "draft_candidate_mode": "draft_candidate",
      "refresh_existing_mode": "refresh_existing",
      "promote_workflow": ".github/workflows/desktop-release-promote.yml",
      "remote_verification_workflow": ".github/workflows/release-verify-remote.yml",
      "full_runtime_cache_warmup_workflow": ".github/workflows/full-runtime-cache-warmup.yml",
      "nightly_standard_release_workflow": ".github/workflows/nightly-standard-release.yml",
      "full_first_install_workflow": ".github/workflows/full-first-install-release.yml",
      "first_run_vm_workflow": ".github/workflows/opl-first-run-vm.yml",
      "first_run_vm_mode": "run_vm_smoke"
    },
    "vm_gates": [
      {
        "id": "standard_dmg_clean_vm_smoke",
        "source": "clean no-CLT Tart base clone",
        "artifact": "One-Person-Lab-<version>-mac-arm64.dmg",
        "smoke_profile": "no-clt-clean-vm",
        "display": "1920x1080px",
        "settings_smoke": true,
        "runtime_profile": "standard",
        "release_blocking_readiness": [
          "app_launch",
          "core_ready_or_app_managed_bootstrap_visible",
          "settings_navigation"
        ],
        "gate_policy": "deterministic_release_blocking"
      },
      {
        "id": "full_dmg_clean_vm_smoke",
        "source": "clean no-CLT Tart base clone",
        "artifact": "One-Person-Lab-Full-<version>-mac-arm64.dmg",
        "smoke_profile": "no-clt-clean-vm",
        "display": "1920x1080px",
        "settings_smoke": true,
        "runtime_profile": "full",
        "codex_config_wizard": "required_and_submitted",
        "release_blocking_readiness": [
          "core_ready",
          "domain_modules_ready",
          "family_runtime_provider_ready"
        ],
        "gate_policy": "deterministic_release_blocking",
        "post_core_ready_background_policy": "best_effort_non_blocking_until_maintenance_ready"
      }
    ],
    "vm_gate": {
      "source": "clean no-CLT Tart base clone",
      "artifact": "One-Person-Lab-Full-<version>-mac-arm64.dmg",
      "smoke_profile": "no-clt-clean-vm",
      "display": "1920x1080px",
      "settings_smoke": true,
      "runtime_profile": "full",
      "codex_config_wizard": "required_and_submitted",
      "gate_policy": "deterministic_release_blocking",
      "preflight_summary_fields": [
        "runner_labels",
        "source_vm",
        "guest_user",
        "ssh_key_configured",
        "release_source",
        "package_profile",
        "runtime_profile",
        "dmg_artifact_path",
        "smoke_profile",
        "display",
        "settings_smoke",
        "artifact_output",
        "tart_graphics",
        "temporary_vm_retention"
      ],
      "release_blocking_readiness": [
        "core_ready",
        "domain_modules_ready",
        "family_runtime_provider_ready"
      ],
      "post_core_ready_background_policy": "best_effort_non_blocking_until_maintenance_ready",
      "non_blocking_deferred_maintenance": [
        "Command Line Tools installation",
        "companion skills install",
        "ecosystem module updates",
        "git availability",
        "managed repo sync"
      ]
    },
    "ai_exploratory_policy": {
      "codex_app": "non_blocking_exploratory_only",
      "computer_use": "non_blocking_exploratory_only",
      "release_blocking_requirement": "findings_must_be_promoted_to_deterministic_contract_workflow_or_script_gate",
      "rule": "AI-assisted exploratory UI checks can discover issues but cannot block or clear release readiness without a deterministic gate."
    }
  },
  "release_validation_profiles": {
    "nightly_standard": {
      "purpose": "fast prerelease confidence for users who opt into standard updater Nightly builds",
      "required_lanes": [
        "release_boundary_contract",
        "standard_macos_arm64_build",
        "local_standard_asset_validation",
        "remote_standard_release_verification"
      ],
      "forbidden_lanes": [
        "full_first_install_build",
        "standard_dmg_clean_vm_smoke",
        "full_dmg_clean_vm_smoke",
        "one_shot_app_installer_fresh_install_smoke",
        "docker_webui_smoke",
        "operator_evidence_bundle"
      ],
      "release_latest_policy": "never_mark_latest",
      "github_release_visibility": "prerelease_only"
    },
    "stable": {
      "purpose": "complete user-install proof before a stable App Release is treated as smooth",
      "required_lanes": [
        "release_boundary_contract",
        "active_shell_quick_validation",
        "standard_macos_arm64_build",
        "local_standard_asset_validation",
        "full_first_install_build",
        "remote_standard_and_full_release_verification",
        "standard_dmg_clean_vm_smoke",
        "full_dmg_clean_vm_smoke",
        "one_shot_app_installer_fresh_install_smoke",
        "docker_webui_smoke",
        "operator_evidence_bundle"
      ],
      "required_installation_surfaces": [
        "standard_dmg_clean_vm_smoke",
        "full_dmg_clean_vm_smoke",
        "one_shot_app_installer_fresh_install_smoke",
        "docker_webui_smoke"
      ],
      "release_latest_policy": "stable_release_may_be_marked_latest_after_required_lanes_pass",
      "heavy_gate_policy": "run before stable promotion; may be skipped only for draft or emergency packaging refreshes that are not called stable-complete"
    }
  },
  "operator_evidence_bundle": {
    "purpose": "runtime_page_operator_evidence_acceptance",
    "bundle_root_pattern": "release-evidence/<version>/",
    "manifest_path": "evidence-manifest.json",
    "acceptance_path": "Runtime page",
    "runtime_page_contract": "contracts/app-page-state-matrix.json#runtime",
    "refs_only": true,
    "missing_evidence_policy": {
      "default_validation": "fail_closed",
      "allow_missing_evidence_flag": "--allow-missing-evidence",
      "missing_status": "missing_evidence",
      "packaged_app_evidence_requires": "all_required_artifacts_present_and_verified"
    },
    "required_artifacts": [
      {
        "id": "app_state_summary",
        "path": "app-state-summary.json",
        "kind": "json",
        "producer": "opl app state --profile fast --json",
        "source_kind": "opl_app_state_summary"
      },
      {
        "id": "app_state_full",
        "path": "app-state-full.json",
        "kind": "json",
        "producer": "opl app state --profile full --json",
        "source_kind": "opl_app_state_full"
      },
      {
        "id": "drilldown_full",
        "path": "drilldown-full.json",
        "kind": "json",
        "producer": "opl runtime app-operator-drilldown --detail full --json",
        "source_kind": "opl_app_operator_drilldown_full"
      },
      {
        "id": "action_dry_run_result",
        "path": "action-dry-run-result.json",
        "kind": "json",
        "producer": "opl app action execute --action <action_id> --dry-run --json",
        "source_kind": "opl_app_action_dry_run"
      },
      {
        "id": "action_execute_result",
        "path": "action-execute-result.json",
        "kind": "json",
        "producer": "opl app action execute --action <action_id> --json",
        "source_kind": "opl_app_action_execute"
      },
      {
        "id": "runtime_screenshot",
        "path": "screenshots/runtime.png",
        "kind": "image",
        "producer": "Runtime page screenshot",
        "source_kind": "app_runtime_page_screenshot"
      },
      {
        "id": "full_screenshot",
        "path": "screenshots/full.png",
        "kind": "image",
        "producer": "Full first-install release screenshot",
        "source_kind": "full_first_install_release_screenshot"
      },
      {
        "id": "action_screenshot",
        "path": "screenshots/action.png",
        "kind": "image",
        "producer": "Runtime action confirmation/result screenshot",
        "source_kind": "app_runtime_action_screenshot"
      },
      {
        "id": "first_run_log",
        "path": "first-run.log",
        "kind": "log",
        "producer": "clean first-run VM smoke",
        "source_kind": "clean_first_run_vm_smoke"
      },
      {
        "id": "settings_smoke",
        "path": "settings-smoke.json",
        "kind": "json",
        "producer": "settings smoke",
        "source_kind": "settings_smoke"
      },
      {
        "id": "remote_release_verification",
        "path": "remote-release-verification.json",
        "kind": "json",
        "producer": "npm run verify-remote-release -- --version <version> --include-full-package --summary-path remote-release-verification.json",
        "source_kind": "remote_release_verification"
      }
    ],
    "forbidden_authority": [
      "runtime_truth",
      "provider_implementation",
      "domain_truth",
      "domain_quality_verdict",
      "domain_artifact_authority"
    ],
    "acceptance_rule": "App records and displays refs-only release evidence produced by OPL/runtime/domain owners; it does not reinterpret the bundle as runtime truth, domain truth, artifact authority, or a quality verdict."
  },
  "normalization_command": "node --experimental-strip-types scripts/prepare-release-assets.ts build-artifacts release-assets",
  "validation_command": "node --experimental-strip-types scripts/validate-release.ts release-assets"
}
