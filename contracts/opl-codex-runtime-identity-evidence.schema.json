{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://one-person-lab.dev/contracts/opl-codex-runtime-identity-evidence.schema.json",
  "title": "OPL Packaged Codex Runtime Identity Evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "status", "authority", "runs", "created_at"],
  "properties": {
    "schema": {
      "const": "opl_codex_runtime_identity_evidence.v1"
    },
    "status": {
      "const": "passed"
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy_owner",
        "runtime_identity_producer",
        "carrier",
        "aioncore_modified",
        "aioncore_native_readback",
        "exact_identity_may_gate_install_or_runtime",
        "claim_scope"
      ],
      "properties": {
        "policy_owner": {
          "const": "one-person-lab-app"
        },
        "runtime_identity_producer": {
          "const": "gaofeng21cn/opl-aion-shell"
        },
        "carrier": {
          "const": "aioncore_managed_resources_projection"
        },
        "aioncore_modified": {
          "const": false
        },
        "aioncore_native_readback": {
          "const": false
        },
        "exact_identity_may_gate_install_or_runtime": {
          "const": false
        },
        "claim_scope": {
          "const": "opl_controlled_input_and_successful_handshake_without_aioncore_native_readback"
        }
      }
    },
    "runs": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "$ref": "#/$defs/run"
      }
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "allOf": [
    {
      "properties": {
        "runs": {
          "contains": {
            "type": "object",
            "required": ["id"],
            "properties": {
              "id": {
                "const": "full_clean_install_finder"
              }
            }
          },
          "minContains": 1,
          "maxContains": 1
        }
      }
    },
    {
      "properties": {
        "runs": {
          "contains": {
            "type": "object",
            "required": ["id"],
            "properties": {
              "id": {
                "const": "standard_update_after_full_finder"
              }
            }
          },
          "minContains": 1,
          "maxContains": 1
        }
      }
    }
  ],
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "evidence_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "path", "sha256"],
      "properties": {
        "kind": {
          "enum": [
            "artifact_tree",
            "environment_capture",
            "process_inspection",
            "handshake_log",
            "typed_error_probe"
          ]
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "path",
        "realpath",
        "version",
        "sha256",
        "codex_home",
        "runtime_key",
        "runtime_cohort_ref",
        "carrier"
      ],
      "properties": {
        "schema": {
          "const": "opl_codex_runtime_identity.v1"
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "realpath": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "#/$defs/digest"
        },
        "codex_home": {
          "type": "string",
          "minLength": 1
        },
        "runtime_key": {
          "type": "string",
          "minLength": 1
        },
        "runtime_cohort_ref": {
          "$ref": "#/$defs/digest"
        },
        "carrier": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "producer_manifest_sha256",
            "projection_manifest_sha256",
            "aioncore_native_readback"
          ],
          "properties": {
            "kind": {
              "const": "aioncore_managed_resources_projection"
            },
            "producer_manifest_sha256": {
              "$ref": "#/$defs/digest"
            },
            "projection_manifest_sha256": {
              "$ref": "#/$defs/digest"
            },
            "aioncore_native_readback": {
              "const": false
            }
          }
        }
      }
    },
    "typed_error_probe": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "status", "evidence_refs"],
      "properties": {
        "code": {
          "enum": [
            "USER_AGENT_NOT_INSTALLED",
            "USER_AGENT_COMMAND_NOT_FOUND",
            "MANAGED_RUNTIME_UNAVAILABLE",
            "RUNTIME_ACTIVATION_REQUIRED",
            "RUNTIME_IDENTITY_MISMATCH"
          ]
        },
        "status": {
          "const": "passed"
        },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/evidence_ref"
          }
        }
      }
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "status",
        "runtime_profile",
        "transition",
        "launch",
        "artifact",
        "managed_candidate",
        "direct_app_server",
        "aioncore_acp",
        "identity_comparison",
        "typed_error_probes"
      ],
      "properties": {
        "id": {
          "enum": [
            "full_clean_install_finder",
            "standard_update_after_full_finder"
          ]
        },
        "status": {
          "const": "passed"
        },
        "runtime_profile": {
          "enum": ["full", "standard"]
        },
        "transition": {
          "enum": ["clean_install", "full_to_standard_update"]
        },
        "launch": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "entrypoint",
            "path",
            "shell_profile_loaded",
            "global_codex_present",
            "restarted"
          ],
          "properties": {
            "entrypoint": {
              "const": "finder"
            },
            "path": {
              "const": "/usr/bin:/bin"
            },
            "shell_profile_loaded": {
              "const": false
            },
            "global_codex_present": {
              "const": false
            },
            "restarted": {
              "const": true
            }
          }
        },
        "artifact": {
          "type": "object",
          "additionalProperties": false,
          "required": ["profile", "app_version", "path", "sha256"],
          "properties": {
            "profile": {
              "enum": ["full", "standard"]
            },
            "app_version": {
              "type": "string",
              "minLength": 1
            },
            "path": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "$ref": "#/$defs/digest"
            }
          }
        },
        "managed_candidate": {
          "$ref": "#/$defs/identity"
        },
        "direct_app_server": {
          "type": "object",
          "additionalProperties": false,
          "required": ["observation_mode", "handshake", "identity", "evidence_refs"],
          "properties": {
            "observation_mode": {
              "const": "resolver_verified_spawn_input"
            },
            "handshake": {
              "const": "initialize_passed"
            },
            "identity": {
              "$ref": "#/$defs/identity"
            },
            "evidence_refs": {
              "type": "array",
              "minItems": 2,
              "items": {
                "$ref": "#/$defs/evidence_ref"
              }
            }
          }
        },
        "aioncore_acp": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "observation_mode",
            "native_readback",
            "managed_candidate_count",
            "handshake",
            "identity",
            "evidence_refs"
          ],
          "properties": {
            "observation_mode": {
              "const": "unique_managed_candidate_inherited_environment_and_conversation_handshake"
            },
            "native_readback": {
              "const": false
            },
            "managed_candidate_count": {
              "const": 1
            },
            "handshake": {
              "const": "ordinary_conversation_real_response_passed"
            },
            "identity": {
              "$ref": "#/$defs/identity"
            },
            "evidence_refs": {
              "type": "array",
              "minItems": 2,
              "items": {
                "$ref": "#/$defs/evidence_ref"
              }
            }
          }
        },
        "identity_comparison": {
          "type": "object",
          "additionalProperties": false,
          "required": ["fields", "status", "claim_scope", "may_gate_install_or_runtime"],
          "properties": {
            "fields": {
              "const": [
                "path",
                "realpath",
                "version",
                "sha256",
                "codex_home",
                "runtime_cohort_ref"
              ]
            },
            "status": {
              "const": "matched"
            },
            "claim_scope": {
              "const": "opl_controlled_input_and_successful_handshake_without_aioncore_native_readback"
            },
            "may_gate_install_or_runtime": {
              "const": false
            }
          }
        },
        "typed_error_probes": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "items": {
            "$ref": "#/$defs/typed_error_probe"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "id": {
                "const": "full_clean_install_finder"
              }
            },
            "required": ["id"]
          },
          "then": {
            "properties": {
              "runtime_profile": {
                "const": "full"
              },
              "transition": {
                "const": "clean_install"
              },
              "artifact": {
                "properties": {
                  "profile": {
                    "const": "full"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "id": {
                "const": "standard_update_after_full_finder"
              }
            },
            "required": ["id"]
          },
          "then": {
            "properties": {
              "runtime_profile": {
                "const": "standard"
              },
              "transition": {
                "const": "full_to_standard_update"
              },
              "artifact": {
                "properties": {
                  "profile": {
                    "const": "standard"
                  }
                }
              }
            }
          }
        }
      ]
    }
  }
}
