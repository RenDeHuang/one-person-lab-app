        "experimental_bearer_token"
      ],
      "base_url_must_match_opl_gateway": true,
      "manual_user_input_required": false,
      "synthetic_api_key_generation_allowed": false,
      "secret_exposure_allowed": false,
      "missing_or_incompatible_host_credential": "diagnostic_skipped_without_artifact_gate_failure"
    },
    "api_key_compatibility_lane": {
      "requires_explicit_request": true,
      "explicit_credential_file_role": "optional_manual_override_only",
      "provider_command": "opl system configure-codex --api-key-stdin --json",
      "provider_command_role": "new_or_rotated_provider_credential_only",
      "package_reconciliation_performed": false,
      "package_lifecycle_mutation_allowed": false,
      "blocking_release_gate": false
    },
    "package_reconciliation_independence": {
      "owner": "one-person-lab",
      "surface": "framework_managed_update_plane",
      "carrier_neutral": true,
      "provider_configuration_required": false,
      "api_key_required": false,
      "configure_codex_allowed": false,
