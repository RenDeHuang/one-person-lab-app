{
  "schema_version": 1,
  "owner": "one-person-lab-app",
  "purpose": "first_run_test_matrix",
  "state": "active",
  "active_shell": "aionui",
  "shell_root": "shells/aionui",
  "shared_progress_model": {
    "producer": "one-person-lab",
    "source_command": "opl system initialize --json",
    "source_path": "system_initialize.setup_flow",
    "truth_policy": "all_installers_and_renderers_derive_progress_from_the_shared_initialize_model",
    "required_setup_flow_fields": [
      "phase",
      "ready_to_launch",
      "progress",
      "blocking_items",
      "maintenance_items"
    ],
    "required_progress_fields": [
      "ready_required_count",
      "total_required_count",
      "ready_full_readiness_count",
      "total_full_readiness_count",
      "ready_optional_count",
      "total_optional_count"
    ],
    "required_checklist_fields": [
      "item_id",
      "label",
      "status",
      "required",
      "readiness_layer",
      "blocking",
      "severity",
      "next_visible_step",
      "detail_summary"
    ],
    "consumers": [
      {
        "package_type": "full",
        "surface": "App first-run readiness page"
      },
      {
        "package_type": "standard",
        "surface": "App-managed bootstrap or ready-state page"
      },
      {
        "package_type": "source_installer",
        "surface": "CLI one-shot install output"
      },
      {
        "package_type": "docker_webui",
        "surface": "WebUI container logs or CLI-backed status"
      }
    ],
    "event_stream_source_command": "opl system initialize --events --json",
    "event_stream_policy": "explicit_configuration_or_diagnostics_only"
  },
  "scenarios": [
    {
      "id": "standard_app_existing_framework",
      "package_type": "standard",
      "expects": [
        "App launches",
        "OPL Framework is discovered through installed CLI or configured path",
        "runtime page uses framework-owned machine-readable output"
      ]
    },
    {
      "id": "beginner_simplified_first_run_clean_machine",
      "package_type": "standard_or_full",
      "audience": "beginner_non_technical_users",
      "view_model": "simplified_first_run",
      "source_command": "opl system initialize --json",
      "required_shell_testids": [
        "opl-startup-preflight",
        "opl-first-run-beginner-summary",
        "opl-first-run-initialize-pending",
        "opl-first-run-primary-action",
        "opl-first-run-technical-details-toggle",
        "opl-first-run-focused-workspace",
        "opl-first-run-step-rail",
        "opl-first-run-task-panel",
        "opl-first-run-access-methods",
        "opl-first-run-gateway-method",
        "opl-first-run-existing-codex-method",
        "opl-first-run-codex-api-key-input",
        "opl-first-run-configure-codex-button",
        "opl-first-run-recheck-existing",
        "opl-first-run-ready-entry",
        "opl-first-run-window-actions",
        "opl-first-run-step-workspace_root",
        "opl-first-run-step-codex",
        "opl-first-run-step-codex_config"
      ],
      "expects": [
        "startup preflight renders visible desktop session, app configuration, and initialization status steps instead of a blank window before FirstRun or /guid",
        "initialize pending state renders explicit progress copy and item summaries before opl system initialize returns",
        "first screen shows a plain readiness summary instead of a technical checklist as the dominant view",
        "primary action leads to /guid only after ready_to_launch is true",
        "workspace root, Codex CLI, and model access are the only primary steps",
        "Chinese locale first-run primary area uses beginner labels such as 工作目录, 本机助手, and 模型访问 even when initialize checklist labels are English",
        "Chinese locale first-run primary area does not expose Codex API Configuration, Unknown, Needs setup, raw setup_flow fields, or opl system commands",
        "OPL Gateway access key entry uses beginner-facing 访问密钥 copy while existing usable Codex model access can skip first-launch Gateway setup",
        "first-run uses a focused full-window setup workspace and hides ordinary product navigation until the user enters /guid",
        "first-run renders as an authenticated standalone route outside the ordinary product layout",
        "startup preflight skip enters focused first-run instead of /guid while readiness is unknown",
        "the three Core items render as a stable step rail while only the current task occupies the main panel",
        "the active rail step and task panel select the first unready Core item in fixed step order before completion",
        "Core progress uses completed step count without percentage progress",
        "model access offers functional OPL Gateway and existing Codex configuration paths without competing primary actions",
        "model access method switching and alternate actions remain disabled until the current request settles",
        "ready state replaces the current task in place and keeps one primary entry action",
        "FirstRun never navigates automatically after initialize and only the ready entry action opens /guid",
        "technical details stay inside FirstRun and do not expose ordinary Settings navigation",
        "all initialize, model access, and maintenance actions share one in-flight interaction lock",
        "initialize pending does not claim ready or no blockers before a payload returns",
        "required Core checklist items never treat disabled status as ready",
        "the 400x600 minimum App window keeps the current primary action visible",
        "background App shell is inert and aria-hidden until the user enters /guid",
        "macOS preserves traffic-light safe area while Windows and Linux retain desktop window controls",
        "interactive controls use localized accessible names rather than testid strings",
        "beginner errors are localized inline while raw diagnostics remain in technical details",
        "submitted access keys are redacted before any renderer diagnostic is stored or rendered",
        "Full readiness and background maintenance remain visible after expanding technical details",
        "Homebrew, Node, Git, CLT, modules, provider, and runtime maintenance do not become the beginner primary terminal goals"
      ],
      "event_stream_source_command": "opl system initialize --events --json",
      "event_stream_policy": "explicit_configuration_or_diagnostics_only"
    },
    {
      "id": "full_first_install_clean_machine",
      "package_type": "full",
      "clean_machine_missing_tools": [
        "command_line_tools",
        "homebrew",
        "node",
        "git"
      ],
      "core_ready_source": "bundled_runtime",
      "ready_to_launch_gate": {
        "ui_order": "before_guid",
        "required_core_items": [
          "workspace_root",
          "codex_cli",
          "codex_config"
        ],
        "blocks_on_full_readiness": false
      },
      "background_maintenance": [
        "repo_sync",
        "module_reconcile",
        "command_line_tools_install",
        "native_helpers",
        "companion_skills_install",
        "ecosystem_module_updates"
      ],
      "post_core_ready_background_policy": {
        "mode": "best_effort_non_blocking",
        "continues_after_core_ready": true,
        "managed_items": [
          "repo_sync",
          "module_reconcile",
          "command_line_tools_install",
          "native_helpers",
          "companion_skills_install",
          "ecosystem_module_updates"
        ]
      },
      "release_gate": true,
      "vm": {
        "source": "clean no-CLT Tart base clone",
        "display": "1920x1080px",
        "smoke_profile": "no-clt-clean-vm",
        "settings_smoke": true,
        "diagnostic_scope": "release_gate",
        "runtime_profile": "full"
      },
      "diagnostics_contract": {
        "app_wrapper": {
          "current_artifact": "app-wrapper-diagnostics.json",
          "current_logs": [
            "app-wrapper-preflight.log",
            "app-wrapper-smoke.stdout.log",
            "app-wrapper-smoke.stderr.log"
          ],
          "current_install_asset_artifacts": [
            "codex-package-preflight.json",
            "codex-package-registry-response.json",
            "codex-package-tarballs/openai-codex.tgz",
            "codex-package-tarballs/openai-codex-darwin-arm64.tgz"
          ],
          "current_cache_dirs": [
            "codex-npm-cache"
          ],
          "required_preflight_fields": [
            "host.node",
            "host.npm",
            "host.curl",
            "host.npm_registry",
            "host.codex_package_metadata",
            "host.codex_package_preflight",
            "release_inputs.diagnostic_scope",
            "artifact_paths.codex_package_preflight",
            "artifact_paths.codex_package_registry_response",
            "artifact_paths.codex_package_tarball",
            "artifact_paths.codex_platform_package_tarball",
            "artifact_paths.codex_npm_cache_dir",
            "codex_install.install_asset_preseed"
          ],
          "required_codex_package_preflight_fields": [
            "status",
            "registry.status_code",
            "package.version",
            "package.tarball_url",
            "package.tarball_url_host",
            "package.platform_version",
            "package.platform_tarball_url",
            "package.platform_tarball_url_host",
            "tarball.sha256",
            "tarball.size_bytes",
            "platform_tarball.sha256",
            "platform_tarball.size_bytes",
            "timings.elapsed_ms",
            "cache.npm_cache_dir",
            "blocking_failures",
            "warnings",
            "truth_boundary"
          ],
          "required_timeout_fields": [
            "job_timeout_minutes",
            "run_timeout_ms",
            "smoke_timeout_ms",
            "codex_install_phase_timeout_ms",
            "codex_readiness_phase_timeout_ms"
          ],
          "required_wrapper_diagnostic_fields": [
            "app-wrapper-diagnostics.json",
            "app-wrapper-preflight.log",
            "app-wrapper-smoke-command-preview.txt",
            "app-wrapper-smoke.stdout.log",
            "app-wrapper-smoke.stderr.log",
            "tart-smoke-summary.json",
            "artifact_paths.smoke_command_preview",
            "artifact_paths.smoke_stdout",
            "artifact_paths.smoke_stderr",
            "artifact_paths.tart_smoke_summary",
            "smoke_command.exit_code",
            "phase_timings.app_wrapper_preflight",
            "phase_timings.app_wrapper_smoke"
          ]
        },
        "codex_install": {
          "current_app_scope": "required_from_tart_smoke_summary_or_shell_companion_diagnostics",
          "shell_interface_status": "implemented_opl_aion_shell_phase_options",
          "install_asset_preseed": {
            "mode": "host_prefetch_cache_preseed",
            "shell_arguments": [
              "--codex-package-tarball",
              "--codex-platform-package-tarball",
              "--codex-npm-cache-dir"
            ],
            "required_artifacts": [
              "codex-package-preflight.json",
              "codex-package-registry-response.json",
              "codex-package-tarballs/openai-codex.tgz",
              "codex-package-tarballs/openai-codex-darwin-arm64.tgz",
              "codex-npm-cache"
            ],
            "truth_boundary": "install_asset_cache_preseed_not_app_readiness_truth_or_owner_receipt"
          },
          "allowed_sources": [
            "tart-smoke-summary.json",
            "artifacts/codex-install-diagnostics.json"
          ],
          "required_fields": [
            "command_preview",
            "stdout",
            "stderr",
            "exit_code",
            "phase_timings",
            "timeouts.codex_install_phase_ms",
            "timeouts.codex_readiness_phase_ms"
          ]
        }
      },
      "expects": [
        "Full DMG is installed into /Applications on first launch",
        "Codex model access is ready before /guid; OPL Gateway is configured only when no existing Codex login or other usable provider is available",
        "Settings pages are navigable after first-run initialization",
        "Full runtime payload is materialized",
        "ready_to_launch is reached before /guid after workspace root, Codex CLI, and usable Codex model access are ready",
        "Core ready is reached from bundled runtime without requiring host CLT, Homebrew, Node, or Git",
        "domain modules, family runtime provider, recommended skills, native helpers, repo sync, CLT installation, and ecosystem module updates continue as full readiness or best-effort background maintenance after Core ready and ready_to_launch",
        "Codex remains the default executor path",
        "standard state modules are visible after initialization",
        "Domain modules, family runtime provider, recommended skills, native helpers, repo sync, CLT, and ecosystem updates do not block ready_to_launch",
        "Packaged GUI route smoke selects MAS, MAG, and RCA professional Agent Package shortcuts, hides ordinary backend/model/permission selectors, and records launch-only Codex CLI agent_package_shortcut invocation receipts"
      ],
      "release_evidence_artifacts": [
        "app-wrapper-diagnostics.json",
        "app-wrapper-preflight.log",
        "app-wrapper-smoke-command-preview.txt",
        "app-wrapper-smoke.stdout.log",
        "app-wrapper-smoke.stderr.log",
        "tart-smoke-summary.json",
        "artifacts/smoke-summary.json",
        "artifacts/system-initialize.json",
        "artifacts/settings-smoke-summary.json",
        "artifacts/assistant-route-smoke-summary.json",
        "artifacts/codex-functional-check-summary.json",
        "artifacts/assistant-route-smoke/mas.png",
        "artifacts/assistant-route-smoke/mag.png",
        "artifacts/assistant-route-smoke/rca.png"
      ]
    },
