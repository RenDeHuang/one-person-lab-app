    }
  },
  "desktop_dispatch": {
    "canonical_bridge": "opl_app_state_and_action_bridge",
    "command_allowlist_source": "contracts/app-remote-companion.json#action_policy.mvp_allowed_actions",
    "product_action_mapping_source": "contracts/app-remote-companion.json#action_policy.wire_action_id_mapping",
    "request_dedupe_scope": "pair_id_key_epoch_request_id",
    "high_impact_approval_policy": "reject_and_keep_desktop_only",
    "provider_history_read_for_business_state": false,
    "cloud_conversation_store": false,
    "task_management_authority": false
  },
  "secret_and_log_policy": {
    "never_log": [
      "conversation_content",
      "task_content",
      "workspace_path",
      "invitation_code",
      "claim_secret",
      "manual_code",
      "desktop_pair_token",
      "ios_claim_token",
      "device_credential",
      "private_key",
      "pair_master_key",
      "usersig",
      "tencent_sdkapp_secret"
    ],
    "push_payload": "generic_pair_scoped_update_signal_only",
    "provider_or_cloud_plaintext_conversation_content": false
  }
}
