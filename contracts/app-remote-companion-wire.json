      "associated_data_utf8": "protocol_version=23:opl_remote_transport.v1|pair_id=13:pair-test-001|sender_device_id=15:ios-test-device|recipient_device_id=19:desktop-test-device|key_epoch=1:1|sender_sequence=1:1|channel_direction=14:ios_to_desktop",
      "nonce_hex": "000102030405060708090a0b",
      "plaintext_utf8": "OPL Link wire vector v1",
