{
  "schema": "opl_app_remote_companion_wire.v1",
  "owner": "one-person-lab-app",
  "state": "approved_mvp_wire_contract",
  "protocol_version": "opl_remote_transport.v1",
  "contract_boundary": "This contract owns the cross-repository OPL Link service broker HTTP and encrypted transport wire shape. It does not make OPL Cloud a conversation store, task control plane, runtime dependency, or release prerequisite; it also does not prescribe provider SDK types or prove a deployed Tencent application.",
  "service_owner": "opl-link/service",
  "compatibility": {
    "version_field_required": true,
    "supported_versions": [
      "opl_remote_transport.v1"
    ],
    "unknown_version_policy": "reject_before_decryption_or_action_dispatch",
    "unknown_action_policy": "reject_without_forwarding_to_the_canonical_action_bridge",
    "legacy_response_fields": {
      "manual_code": {
        "status": "compatibility_response_only",
        "user_fallback": false,
        "client_behavior": "use_claim_secret_from_full_pairing_payload"
      }
    },
    "legacy_transport_identifiers": {
      "status": "v1_wire_aliases_only",
      "action_prefix": "canonical_task",
      "event_prefix": "task",
      "product_object": "canonical_codex_conversation",
      "product_semantics_source": "contracts/app-remote-companion.json#surface_boundary.conversation_model",
      "must_not_be_interpreted_as": "opl_link_task_control_plane_or_task_lifecycle_authority"
    }
  },
  "serialization": {
    "media_type": "application/json",
    "field_names": "lower_snake_case",
    "binary_encoding": "unpadded_base64url",
    "timestamp_encoding": "rfc3339_utc",
    "opaque_identifier_encoding": "uuid_v4_or_128_bit_random_base64url",
    "maximum_encrypted_transport_message_bytes": 65536
  },
  "broker_http": {
    "base_path": "/v1/remote-companion",
    "tls_required": true,
    "mutation_idempotency_header": "Idempotency-Key",
    "authorization_header": "Authorization: Bearer <opaque_token>",
    "tokens": {
      "desktop_pair_token": "single_pairing_desktop_poll_and_confirmation_then_desktop_active_device_credential_after_activation",
      "ios_claim_token": "single_pairing_ios_poll_then_ios_active_device_credential_after_activation",
      "active_device_credential": "role_bound_to_the_callers_existing_desktop_pair_token_or_ios_claim_token_after_activation_without_minting_a_second_bearer",
      "revocation_receipt_token": "single_revocation_status_read_only_until_terminal_or_expiry",
      "storage": "store_only_sha256_or_stronger_salted_hashes_and_return_plaintext_once",
      "transport": "bearer_header_only_never_url_query_or_qr"
    },
    "endpoints": [
      {
        "id": "operator_create_invitation",
        "method": "POST",
        "path": "/v1/remote-companion/invitations",
        "auth": "existing_opl_link_service_operator_session",
        "idempotency_required": true,
        "request_fields": [
          "label",
          "expires_at"
        ],
        "response_fields": [
          "invitation_code",
          "expires_at"
        ],
        "secret_response_fields": [
          "invitation_code"
        ]
      },
      {
        "id": "desktop_create_pairing",
        "method": "POST",
        "path": "/v1/remote-companion/pairings",
        "auth": "one_time_invitation_code_in_body",
        "idempotency_required": true,
        "request_fields": [
          "protocol_version",
          "invitation_code",
          "desktop_device_id",
          "desktop_device_label",
          "desktop_public_key"
        ],
        "response_fields": [
          "protocol_version",
          "pairing_id",
          "desktop_pair_token",
          "claim_secret",
          "manual_code",
          "expires_at",
          "broker_url"
        ],
        "secret_response_fields": [
          "desktop_pair_token",
          "claim_secret",
          "manual_code"
        ]
      },
      {
        "id": "ios_claim_pairing",
        "method": "POST",
        "path": "/v1/remote-companion/pairings/claim",
        "auth": "claim_secret_or_manual_code_in_body",
        "idempotency_required": true,
        "request_fields": [
          "protocol_version",
          "pairing_id",
          "claim_secret_or_manual_code",
          "ios_device_id",
          "ios_device_label",
          "ios_public_key"
        ],
        "response_fields": [
          "protocol_version",
          "pairing_id",
          "ios_claim_token",
          "state",
          "authentication_string",
          "expires_at"
        ],
        "secret_response_fields": [
          "ios_claim_token"
        ]
      },
      {
        "id": "read_pairing",
        "method": "GET",
        "path": "/v1/remote-companion/pairings/{pairing_id}",
        "auth": "desktop_pair_token_or_ios_claim_token_or_active_device_credential",
        "idempotency_required": false,
        "response_fields": [
          "protocol_version",
          "pairing_id",
          "state",
          "authentication_string",
          "expires_at",
          "device_activation"
        ],
        "device_activation_fields": [
          "device_id",
          "device_label",
          "peer_device_id",
          "peer_device_label",
          "provider_user_id",
          "peer_provider_user_id",
          "peer_public_key",
          "sdk_app_id",
          "push_business_id",
          "usersig",
          "usersig_expires_at"
        ],
        "active_device_credential_source": "desktop_pair_token_for_desktop_and_ios_claim_token_for_ios_become_active_after_pair_activation",
        "device_activation_policy": "return_only_the_calling_devices_own_activation_and_the_minimum_peer_route_identity_device_label_and_public_key_required_for_e2ee; never_return_or_echo_a_bearer_in_device_activation"
      },
      {
        "id": "desktop_confirm_pairing",
        "method": "POST",
        "path": "/v1/remote-companion/pairings/{pairing_id}/confirm",
        "auth": "desktop_pair_token",
        "idempotency_required": true,
        "request_fields": [
          "protocol_version",
          "authentication_string"
        ],
        "response_fields": [
          "protocol_version",
          "pairing_id",
          "state"
        ]
      },
      {
        "id": "refresh_provider_credentials",
        "method": "POST",
        "path": "/v1/remote-companion/pairings/{pairing_id}/credentials",
        "auth": "active_device_credential",
        "idempotency_required": true,
        "request_fields": [
          "protocol_version",
          "device_id"
        ],
        "response_fields": [
          "protocol_version",
          "provider",
          "sdk_app_id",
          "push_business_id",
          "provider_user_id",
          "peer_provider_user_id",
          "usersig",
          "usersig_expires_at"
        ],
        "secret_response_fields": [
          "usersig"
        ]
      },
      {
        "id": "revoke_pair",
        "method": "DELETE",
        "path": "/v1/remote-companion/pairings/{pairing_id}",
        "auth": "active_device_credential_or_desktop_pair_token",
        "idempotency_required": true,
        "response_fields": [
          "protocol_version",
          "pairing_id",
          "state",
          "revocation_receipt_id",
          "revocation_receipt_token"
        ],
        "secret_response_fields": [
          "revocation_receipt_token"
        ]
      },
      {
        "id": "read_revocation",
        "method": "GET",
        "path": "/v1/remote-companion/revocations/{revocation_receipt_id}",
        "auth": "revocation_receipt_token",
        "idempotency_required": false,
        "response_fields": [
          "protocol_version",
          "pairing_id",
          "state",
          "desktop_provider_identity_absent",
          "ios_provider_identity_absent",
          "seat_released"
        ],
        "terminal_rule": "state_is_revoked_and_seat_released_is_true_only_after_both_provider_identities_are_absent_by_provider_owner_readback"
      }
    ],
    "pairing_states": [
      "reserved",
      "claimed",
      "awaiting_desktop_confirmation",
      "provisioning",
      "active",
      "revoking",
      "provider_reclaim_pending",
      "revoked",
      "expired"
    ],
    "error_envelope": {
      "fields": [
        "protocol_version",
        "error_code",
        "retryable",
        "request_id"
      ],
      "allowed_error_codes": [
        "invalid_request",
        "unsupported_protocol",
        "invitation_invalid",
        "invitation_expired",
        "invitation_consumed",
        "capacity_unavailable",
        "pairing_not_found",
        "pairing_expired",
        "claim_invalid",
        "claim_attempts_exhausted",
        "authentication_mismatch",
        "pairing_not_ready",
        "credential_invalid",
        "pair_revoked",
        "provider_unavailable",
        "conflict",
        "rate_limited",
        "internal_error"
      ],
      "must_not_include": [
        "conversation_text",
        "task_text",
        "workspace_path",
        "provider_secret",
        "invitation_code",
        "claim_secret",
        "device_credential",
        "usersig"
      ]
    }
  },
  "pairing_qr": {
    "url_scheme": "opllink",
    "host": "pair",
    "fields": [
      "protocol_version",
      "broker_url",
      "pairing_id",
      "claim_secret",
      "desktop_public_key",
      "expires_at"
    ],
    "forbidden_fields": [
      "desktop_pair_token",
      "invitation_code",
      "provider_secret",
      "device_credential",
      "usersig",
      "workspace_path",
      "conversation_text",
      "task_text"
    ],
    "single_use": true
  },
  "pairing_authentication_string": {
    "input_serialization": "utf8_length_prefixed_fields_in_exact_order_pair_id_desktop_public_key_ios_public_key_joined_by_ascii_pipe",
    "field_encoding": "name_equals_utf8_byte_count_colon_value",
    "digest": "sha256",
    "decimal_derivation": "unsigned_big_endian_first_4_digest_bytes_modulo_1000000",
    "display_format": "zero_padded_6_digits_grouped_as_3_space_3",
    "test_vector": {
      "pair_id": "pair-test-001",
      "desktop_public_key": "3p7bfXt9wbTTW2HC7OQ1Nz-DQ8hbeGdNrfx-FG-IK08",
      "ios_public_key": "hSDwCYkwp1R0i33ctD73Wg2_Og0mOBr066SpjqqbTmo",
      "serialized_input": "pair_id=13:pair-test-001|desktop_public_key=43:3p7bfXt9wbTTW2HC7OQ1Nz-DQ8hbeGdNrfx-FG-IK08|ios_public_key=43:hSDwCYkwp1R0i33ctD73Wg2_Og0mOBr066SpjqqbTmo",
      "sha256_hex": "4c0c31d417933196080996b1ac1012c4a5d1b890bf722c07b49f45f6cc794b53",
      "authentication_string": "867 604"
    }
  },
  "transport_envelope": {
    "outer_fields": [
      "protocol_version",
      "pair_id",
      "sender_device_id",
      "recipient_device_id",
      "key_epoch",
      "sender_sequence",
      "nonce",
      "ciphertext"
    ],
    "outer_plaintext_must_not_include": [
      "action_id",
      "thread_id",
      "conversation_text",
      "task_text",
      "workspace_path",
      "approval_text",
      "model",
      "permission"
    ],
    "associated_data_fields": [
      "protocol_version",
      "pair_id",
      "sender_device_id",
      "recipient_device_id",
      "key_epoch",
      "sender_sequence",
      "channel_direction"
    ],
    "nonce_bytes": 12,
    "cipher": "aes_256_gcm",
    "key_agreement": "x25519",
    "key_derivation": "hkdf_sha256",
    "directional_keys": true,
    "direction_values": [
      "ios_to_desktop",
      "desktop_to_ios"
    ],
    "x25519_key_encoding": "raw_32_bytes_then_unpadded_base64url_on_wire",
    "hkdf_salt": "utf8_pair_id",
    "hkdf_info": "utf8_opl_remote_transport.v1_pipe_key_epoch_equals_decimal_pipe_direction_equals_direction_value",
    "associated_data_serialization": "utf8_name_equals_utf8_byte_count_colon_value_fields_in_declared_order_joined_by_ascii_pipe",
    "ciphertext_encoding": "aes_gcm_ciphertext_followed_by_16_byte_tag_then_unpadded_base64url",
    "encrypted_payload_variants": {
      "command": {
        "fields": [
          "kind",
          "request_id",
          "action_id",
          "canonical_thread_id",
          "payload"
        ],
        "kind": "command",
        "allowed_action_ids": [
          "canonical_task.list",
          "canonical_task.read",
          "canonical_task.refresh",
          "canonical_task.start",
          "canonical_task.send_text",
          "canonical_turn.stop",
          "canonical_approval.respond",
          "pair.revoke"
        ],
        "product_action_mapping": {
          "canonical_task.list": "conversation.list",
          "canonical_task.read": "conversation.open",
          "canonical_task.refresh": "conversation.refresh",
          "canonical_task.start": "conversation.start",
          "canonical_task.send_text": "conversation.send_text",
          "canonical_turn.stop": "conversation.turn.stop",
          "canonical_approval.respond": "conversation.approval.respond",
          "pair.revoke": "pair.revoke"
        },
        "payload_contracts": {
          "canonical_task.list": {
            "canonical_thread_id_required": false,
            "payload_fields": []
          },
          "canonical_task.read": {
            "canonical_thread_id_required": true,
            "payload_fields": []
          },
          "canonical_task.refresh": {
            "canonical_thread_id_required": false,
            "payload_fields": []
          },
          "canonical_task.start": {
            "canonical_thread_id_required": false,
            "payload_fields": [
              "text"
            ]
          },
          "canonical_task.send_text": {
            "canonical_thread_id_required": true,
            "payload_fields": [
              "text"
            ]
          },
          "canonical_turn.stop": {
            "canonical_thread_id_required": true,
            "payload_fields": [],
            "turn_selection": "desktop_resolves_and_validates_the_current_canonical_active_turn"
          },
          "canonical_approval.respond": {
            "canonical_thread_id_required": true,
            "payload_fields": [
              "approval_id",
              "decision"
            ],
            "decision_values": [
              "approve",
              "reject"
            ],
            "decision_mapping": {
              "approve": "desktop_may_map_only_to_the_owner_allowed_one_shot_accept_decision",
              "reject": "desktop_may_map_only_to_the_owner_allowed_decline_decision"
            },
            "impact_policy": "desktop_must_revalidate_the_owner_projected_low_or_medium_impact_and_allowed_decision_without_trusting_client_impact"
          },
          "pair.revoke": {
            "canonical_thread_id_required": false,
            "payload_fields": []
          }
        }
      },
      "event": {
        "fields": [
          "kind",
          "event_id",
          "request_id",
          "event_type",
          "canonical_revision",
          "payload"
        ],
        "kind": "event",
        "allowed_event_types": [
          "task.snapshot",
          "task.list_snapshot",
          "thread.snapshot",
          "turn.delta",
          "turn.completed",
          "turn.stopped",
          "approval.requested",
          "approval.resolved",
          "action.accepted",
          "action.rejected",
          "desktop.heartbeat",
          "pair.revoked"
        ],
        "product_event_mapping": {
          "task.list_snapshot": "conversation.directory_snapshot",
          "task.snapshot": "conversation.summary_snapshot",
          "thread.snapshot": "conversation.snapshot",
          "turn.delta": "conversation.turn_delta",
          "turn.completed": "conversation.turn_completed",
          "turn.stopped": "conversation.turn_stopped",
          "approval.requested": "conversation.approval_requested",
          "approval.resolved": "conversation.approval_resolved",
          "action.accepted": "conversation.action_accepted",
          "action.rejected": "conversation.action_rejected",
          "desktop.heartbeat": "desktop.heartbeat",
          "pair.revoked": "pair.revoked"
        },
        "payload_contracts": {
          "task.list_snapshot": [
            "tasks",
            "complete"
          ],
          "task.snapshot": [
            "task"
          ],
          "thread.snapshot": [
            "thread_id",
            "messages",
            "approval"
          ],
          "turn.delta": [
            "thread_id",
            "turn_id",
            "delta"
          ],
          "turn.completed": [
            "thread_id",
            "turn_id"
          ],
          "turn.stopped": [
            "thread_id",
            "turn_id"
          ],
          "approval.requested": [
            "thread_id",
            "approval"
          ],
          "approval.resolved": [
            "thread_id",
            "approval_id",
            "decision"
          ],
          "action.accepted": [
            "action_id"
          ],
          "action.rejected": [
            "action_id",
            "error_code",
            "refresh_required"
          ],
          "desktop.heartbeat": [
            "sent_at"
          ],
          "pair.revoked": [
            "pairing_id"
          ]
        },
        "projection_shapes": {
          "task": [
            "id",
            "title",
            "status",
            "updated_at",
            "needs_user_action",
            "active_turn_id"
          ],
          "message": [
            "id",
            "role",
            "text",
            "created_at"
          ],
          "approval": [
            "id",
            "summary",
            "impact"
          ]
        }
      }
    },
    "ordering": {
      "sender_sequence_starts_at": 1,
      "sender_sequence_monotonic_per_pair_key_epoch_and_sender": true,
      "duplicate_nonce_rejected": true,
      "duplicate_or_regressed_sequence_rejected": true,
      "duplicate_request_id_is_idempotent": true,
      "gap_policy": "mark_projection_stale_and_refresh_canonical_state_before_new_commands",
      "unknown_send_result_policy": "do_not_resend_refresh_canonical_state"
    },
    "test_vector": {
      "source": "rfc7748_x25519_alice_and_bob_keys_plus_opl_wire_parameters",
      "sender_role": "ios",
      "ios_private_key_hex": "77076d0a7318a57d3c16c17251b26645df4c2f87ebc0992ab177fba51db92c2a",
