{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://one-person-lab.dev/schemas/windows-platform-post-resize-gate.schema.json",
  "title": "OPL Windows post-resize factory and lease gate receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "stage",
    "status",
    "observed_at",
    "factory_root",
    "capacity",
    "weston_crash_loop",
    "disk_layout",
    "released_volumes",
    "iso",
    "cutover",
    "script_bundle",
    "source_integration",
    "vms",
    "v6_writer_lease"
  ],
  "properties": {
    "schema": { "const": "opl_windows_platform_post_resize_gate.v1" },
    "stage": { "enum": ["factory_ready", "v6_lease_ready", "terminal_closeout"] },
    "status": { "const": "passed" },
    "observed_at": { "type": "string", "format": "date-time" },
    "factory_root": { "const": "C:\\OPL-VMs" },
    "capacity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["drive", "filesystem", "size_bytes", "free_bytes", "minimum_free_bytes", "gate_passed"],
      "properties": {
        "drive": { "const": "C:" },
        "filesystem": { "const": "NTFS" },
        "size_bytes": { "type": "integer", "minimum": 1099511627776 },
        "free_bytes": { "type": "integer", "minimum": 32212254720 },
        "minimum_free_bytes": { "const": 32212254720 },
        "gate_passed": { "const": true }
      }
    },
    "weston_crash_loop": {
      "type": "object",
      "additionalProperties": false,
      "required": ["observation_seconds", "dump_count_before", "dump_count_after", "new_dump_count", "stopped"],
      "properties": {
        "observation_seconds": { "type": "integer", "minimum": 180 },
        "dump_count_before": { "type": "integer", "minimum": 0 },
        "dump_count_after": { "type": "integer", "minimum": 0 },
        "new_dump_count": { "const": 0 },
        "stopped": { "const": true }
      }
    },
    "disk_layout": {
      "type": "object",
      "additionalProperties": false,
      "required": ["disk_number", "partition_style", "system_drive", "system_drive_size_bytes", "winre_enabled", "receipt_sha256"],
      "properties": {
        "disk_number": { "const": 0 },
        "partition_style": { "const": "GPT" },
        "system_drive": { "const": "C:" },
        "system_drive_size_bytes": { "type": "integer", "minimum": 1099511627776 },
        "winre_enabled": { "const": true },
        "receipt_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "released_volumes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["f_drive_required", "f_drive_present", "release_proven"],
      "properties": {
        "f_drive_required": { "const": false },
        "f_drive_present": { "const": false },
        "release_proven": { "const": true }
      }
    },
    "iso": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "language", "edition", "size_bytes", "sha256", "source", "verified"],
      "properties": {
        "path": { "const": "C:\\OPL-VMs\\ISO\\26200.6584.250915-1905.25h2_ge_release_svc_refresh_CLIENTENTERPRISEEVAL_OEMRET_x64FRE_zh-cn.iso" },
        "language": { "const": "zh-CN" },
        "edition": { "const": "Windows 11 Enterprise Evaluation 25H2 x64" },
        "size_bytes": { "const": 7371034624 },
        "sha256": { "const": "7b4ac87391b659f7724229682b642256289a1c00504056249f0f12029157d3d2" },
        "source": { "const": "microsoft_official_evaluation" },
        "verified": { "const": true }
      }
    },
    "cutover": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_root", "source_mode", "target_root", "manifest_sha256", "file_count", "total_bytes", "verified", "source_deleted"],
      "properties": {
        "source_root": { "const": "E:\\_Original-E-20260726\\OPL-VMs" },
        "source_mode": { "const": "read_only_recovery" },
        "target_root": { "const": "C:\\OPL-VMs" },
        "manifest_sha256": { "$ref": "#/$defs/sha256" },
        "file_count": { "type": "integer", "minimum": 1 },
        "total_bytes": { "type": "integer", "minimum": 7371034624 },
        "verified": { "const": true },
        "source_deleted": { "const": false }
      }
    },
    "script_bundle": {
      "type": "array",
      "minItems": 6,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "path", "sha256", "factory_root_binding", "source_classification"],
        "properties": {
          "name": { "type": "string", "pattern": "^[A-Za-z0-9-]+\\.ps1$" },
          "path": { "type": "string", "pattern": "^C:\\\\OPL-VMs\\\\Scripts\\\\[A-Za-z0-9-]+\\.ps1$" },
          "sha256": { "$ref": "#/$defs/sha256" },
          "factory_root_binding": { "const": "C:\\OPL-VMs" },
          "source_classification": { "enum": ["canonical_source", "task_owned_sealed_host_script"] }
        }
      }
    },
    "source_integration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "canonical_main_commit",
        "canonical_main_tree",
        "source_commit",
        "source_tree",
        "delivery_commit",
        "delivery_tree",
        "packet_manifest_sha256",
        "absorption_audit_sha256",
        "remote_ref_tree_blob_parity",
        "authenticated_raw_parity",
        "anonymous_raw_parity",
        "source_absorbed",
        "task_worktree_removed",
        "local_task_branch_removed",
        "remote_task_branch_removed",
        "remaining_source_cleanup_count"
      ],
      "properties": {
        "canonical_main_commit": { "$ref": "#/$defs/gitSha" },
        "canonical_main_tree": { "$ref": "#/$defs/gitSha" },
        "source_commit": { "$ref": "#/$defs/gitSha" },
        "source_tree": { "$ref": "#/$defs/gitSha" },
        "delivery_commit": { "$ref": "#/$defs/gitSha" },
        "delivery_tree": { "$ref": "#/$defs/gitSha" },
        "packet_manifest_sha256": { "$ref": "#/$defs/sha256" },
        "absorption_audit_sha256": { "$ref": "#/$defs/sha256" },
        "remote_ref_tree_blob_parity": { "const": true },
        "authenticated_raw_parity": { "const": true },
        "anonymous_raw_parity": { "const": true },
        "source_absorbed": { "const": true },
        "task_worktree_removed": { "type": "boolean" },
        "local_task_branch_removed": { "type": "boolean" },
        "remote_task_branch_removed": { "type": "boolean" },
        "remaining_source_cleanup_count": { "type": "integer", "minimum": 0 }
      }
    },
    "vms": {
      "type": "array",
      "maxItems": 2,
      "items": { "$ref": "#/$defs/vmIdentity" }
    },
    "v6_writer_lease": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "sha256", "request_sha256", "vm_identity", "executor_task_id", "powered_off", "operation_count"],
          "properties": {
            "path": { "const": "C:\\OPL-VMs\\Leases\\OPL-V6-WSL2-01.writer-lease.json" },
            "sha256": { "$ref": "#/$defs/sha256" },
            "request_sha256": { "$ref": "#/$defs/sha256" },
            "vm_identity": { "type": "string", "pattern": "^hyperv-vmid:[0-9a-f-]{36}$" },
            "executor_task_id": { "const": "019f97e4-288a-7140-8850-925c657d8c71" },
            "powered_off": { "const": true },
            "operation_count": { "const": 0 }
          }
        }
      ]
    }
  },
  "allOf": [
    {
      "if": { "properties": { "stage": { "const": "factory_ready" } }, "required": ["stage"] },
      "then": { "properties": { "v6_writer_lease": { "type": "null" } } }
    },
    {
      "if": { "properties": { "stage": { "enum": ["v6_lease_ready", "terminal_closeout"] } }, "required": ["stage"] },
      "then": {
        "properties": {
          "vms": {
            "minItems": 2,
            "maxItems": 2,
            "allOf": [
              {
                "contains": { "properties": { "name": { "const": "OPL-V6-WSL2-01" } }, "required": ["name"] },
                "minContains": 1,
                "maxContains": 1
              },
              {
                "contains": { "properties": { "name": { "const": "OPL-WEBUI-CLEAN-01" } }, "required": ["name"] },
                "minContains": 1,
                "maxContains": 1
              }
            ]
          },
          "v6_writer_lease": { "type": "object" }
        }
      }
    },
    {
      "if": { "properties": { "stage": { "const": "terminal_closeout" } }, "required": ["stage"] },
      "then": {
        "properties": {
          "source_integration": {
            "properties": {
              "task_worktree_removed": { "const": true },
              "local_task_branch_removed": { "const": true },
              "remote_task_branch_removed": { "const": true },
              "remaining_source_cleanup_count": { "const": 0 }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "gitSha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "uuid": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$" },
    "vmIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "vm_id", "generation", "state", "config_path", "active_vhdx_path", "vhdx_chain", "checkpoint_id", "checkpoint_name", "localization", "clean_baseline", "network", "network_receipt_sha256"],
      "properties": {
        "name": { "enum": ["OPL-V6-WSL2-01", "OPL-WEBUI-CLEAN-01"] },
        "vm_id": { "$ref": "#/$defs/uuid" },
        "generation": { "const": 2 },
        "state": { "const": "Off" },
        "config_path": { "type": "string", "pattern": "^C:\\\\OPL-VMs\\\\Guests\\\\.*$" },
        "active_vhdx_path": { "type": "string", "pattern": "^C:\\\\OPL-VMs\\\\Guests\\\\.*\\.vhdx$" },
        "vhdx_chain": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "parent_path", "vhd_type", "file_size_bytes", "maximum_size_bytes"],
            "properties": {
              "path": { "type": "string", "pattern": "^C:\\\\OPL-VMs\\\\Guests\\\\.*\\.(?:avhdx|vhdx)$" },
              "parent_path": {
                "oneOf": [
                  { "type": "null" },
                  { "type": "string", "pattern": "^C:\\\\OPL-VMs\\\\Guests\\\\.*\\.(?:avhdx|vhdx)$" }
                ]
              },
              "vhd_type": { "enum": ["Dynamic", "Differencing", "Fixed"] },
              "file_size_bytes": { "type": "integer", "minimum": 1 },
              "maximum_size_bytes": { "type": "integer", "minimum": 1 }
            }
          }
        },
        "checkpoint_id": { "$ref": "#/$defs/uuid" },
        "checkpoint_name": { "type": "string", "pattern": "^OPL-Clean-Windows-zh-CN-" },
        "localization": {
          "type": "object",
          "additionalProperties": false,
          "required": ["ui_language", "system_locale", "user_locale", "default_input_method_tip"],
          "properties": {
            "ui_language": { "const": "zh-CN" },
            "system_locale": { "const": "zh-CN" },
            "user_locale": { "const": "zh-CN" },
            "default_input_method_tip": { "const": "0804:00000804" }
          }
        },
        "clean_baseline": { "const": true },
        "network": {
          "type": "object",
          "additionalProperties": false,
          "required": ["switch_name", "switch_id", "nat_name", "nat_id", "subnet", "guest_ip", "static_mac_address", "host_loopback_port_lease", "inbound_nat_mappings", "writable_surface_overlap_count"],
          "properties": {
            "switch_name": { "type": "string", "pattern": "^OPL-NAT-OPL-(?:V6-WSL2|WEBUI-CLEAN)-01$" },
            "switch_id": { "$ref": "#/$defs/uuid" },
            "nat_name": { "type": "string", "pattern": "^OPL-NAT-OPL-(?:V6-WSL2|WEBUI-CLEAN)-01$" },
            "nat_id": { "type": "string", "minLength": 3, "maxLength": 200 },
            "subnet": { "enum": ["172.28.101.0/24", "172.28.102.0/24"] },
            "guest_ip": { "enum": ["172.28.101.10", "172.28.102.10"] },
            "static_mac_address": { "type": "string", "pattern": "^[0-9A-F]{12}$" },
            "host_loopback_port_lease": { "enum": ["33001-33019", "33101-33119"] },
            "inbound_nat_mappings": { "const": 0 },
            "writable_surface_overlap_count": { "const": 0 }
          }
        },
        "network_receipt_sha256": { "$ref": "#/$defs/sha256" }
      }
    }
  }
}
