{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://one-person-lab.dev/schemas/windows-platform-vm-lease.schema.json",
  "title": "OPL C-root Windows VM single-writer platform lease",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "status",
    "factory_root",
    "receipt_id",
    "granted_at",
    "released_at",
    "lease_id",
    "vm_name",
    "execution_owner_thread",
    "previous_owner_thread",
    "next_owner_thread",
    "source_contract",
    "generation",
    "vm_uuid",
    "config_path",
    "active_vhdx_path",
    "vhdx_chain",
    "checkpoint_chain",
    "network",
    "guest_localization",
    "exclusive_paths",
    "runtime_namespace",
    "receipt_namespace",
    "clean_vm_attestation",
    "request_sha256",
    "post_resize_gate_receipt_sha256",
    "storage_probe_receipt_sha256",
    "vm_create_receipt_sha256",
    "network_receipt_sha256",
    "writable_surface_overlap_count",
    "lease_authorized"
  ],
  "properties": {
    "schema": { "const": "opl_windows_vm_lease.v2" },
    "status": { "enum": ["active", "released"] },
    "factory_root": { "const": "C:\\OPL-VMs" },
    "receipt_id": { "$ref": "#/$defs/uuid" },
    "granted_at": { "type": "string", "format": "date-time" },
    "released_at": { "type": ["string", "null"], "format": "date-time" },
    "lease_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,80}$" },
    "vm_name": { "enum": ["OPL-V6-WSL2-01", "OPL-WEBUI-CLEAN-01"] },
    "execution_owner_thread": { "type": "string", "pattern": "^[0-9a-f-]{36}$" },
    "previous_owner_thread": { "type": ["string", "null"] },
    "next_owner_thread": { "type": "string", "pattern": "^[0-9a-f-]{36}$" },
    "source_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["app_acceptance_sha", "delivery_commit", "intake_manifest_sha256", "post_resize_gate_receipt_sha256"],
      "properties": {
        "app_acceptance_sha": { "$ref": "#/$defs/gitSha" },
        "delivery_commit": { "$ref": "#/$defs/gitSha" },
        "intake_manifest_sha256": { "$ref": "#/$defs/sha256" },
        "post_resize_gate_receipt_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "generation": { "const": 2 },
    "vm_uuid": { "$ref": "#/$defs/uuid" },
    "config_path": { "$ref": "#/$defs/cRootPath" },
    "active_vhdx_path": { "$ref": "#/$defs/cRootPath" },
    "vhdx_chain": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/vhdxEntry" }
    },
    "checkpoint_chain": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "created_at"],
        "properties": {
          "id": { "$ref": "#/$defs/uuid" },
          "name": { "type": "string", "minLength": 3 },
          "created_at": { "type": "string", "format": "date-time" }
        }
      }
    },
    "network": {
      "type": "object",
      "additionalProperties": false,
      "required": ["current_switch", "switch_id", "nat_name", "nat_id", "subnet", "guest_ip", "host_loopback_port_lease", "static_mac_address", "inbound_nat_mappings"],
      "properties": {
        "current_switch": { "type": "string", "pattern": "^OPL-NAT-OPL-(?:V6-WSL2|WEBUI-CLEAN)-01$" },
        "switch_id": { "$ref": "#/$defs/uuid" },
        "nat_name": { "type": "string", "pattern": "^OPL-NAT-OPL-(?:V6-WSL2|WEBUI-CLEAN)-01$" },
        "nat_id": { "type": "string", "minLength": 3 },
        "subnet": { "enum": ["172.28.101.0/24", "172.28.102.0/24"] },
        "guest_ip": { "enum": ["172.28.101.10", "172.28.102.10"] },
        "host_loopback_port_lease": { "enum": ["33001-33019", "33101-33119"] },
        "static_mac_address": { "type": "string", "pattern": "^[0-9A-Fa-f]{12}$" },
        "inbound_nat_mappings": { "const": 0 }
      }
    },
    "guest_localization": { "$ref": "#/$defs/localization" },
    "exclusive_paths": {
      "type": "object",
      "additionalProperties": false,
      "required": ["guest", "config", "evidence", "vhdx"],
      "properties": {
        "guest": { "$ref": "#/$defs/cRootPath" },
        "config": { "$ref": "#/$defs/cRootPath" },
        "evidence": { "$ref": "#/$defs/cRootPath" },
        "vhdx": { "$ref": "#/$defs/cRootPath" }
      }
    },
    "runtime_namespace": { "enum": ["OPL-V6-WSL2-01", "OPL-WEBUI-CLEAN-01"] },
    "receipt_namespace": { "$ref": "#/$defs/cRootPath" },
    "clean_vm_attestation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "schema", "vm_identity", "checkpoint_id", "checkpoint_name", "clean_user_receipt_sha256"],
      "properties": {
        "path": { "$ref": "#/$defs/cRootPath" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "schema": { "const": "opl_windows_clean_vm_attestation.v2" },
        "vm_identity": { "type": "string", "pattern": "^hyperv-vmid:[0-9a-f-]{36}$" },
        "checkpoint_id": { "$ref": "#/$defs/uuid" },
        "checkpoint_name": { "type": "string", "pattern": "^OPL-Clean-Windows-zh-CN-" },
        "clean_user_receipt_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "request_sha256": { "$ref": "#/$defs/sha256" },
    "post_resize_gate_receipt_sha256": { "$ref": "#/$defs/sha256" },
    "storage_probe_receipt_sha256": { "$ref": "#/$defs/sha256" },
    "vm_create_receipt_sha256": { "$ref": "#/$defs/sha256" },
    "network_receipt_sha256": { "$ref": "#/$defs/sha256" },
    "writable_surface_overlap_count": { "const": 0 },
    "lease_authorized": { "const": true }
  },
  "allOf": [
    {
      "if": { "properties": { "vm_name": { "const": "OPL-V6-WSL2-01" } }, "required": ["vm_name"] },
      "then": {
        "properties": {
          "lease_id": { "const": "opl-v6-wsl2-01" },
          "execution_owner_thread": { "const": "019f97e4-288a-7140-8850-925c657d8c71" },
          "next_owner_thread": { "const": "019f97e4-288a-7140-8850-925c657d8c71" },
          "config_path": { "const": "C:\\OPL-VMs\\Guests\\OPL-V6-WSL2-01\\Virtual Machines" },
          "active_vhdx_path": { "pattern": "^C:\\\\OPL-VMs\\\\Guests\\\\OPL-V6-WSL2-01\\\\Virtual Hard Disks\\\\.+\\.(?:avhdx|vhdx)$" },
          "vhdx_chain": { "items": { "$ref": "#/$defs/v6VhdxEntry" } },
          "network": {
            "properties": {
              "current_switch": { "const": "OPL-NAT-OPL-V6-WSL2-01" },
              "nat_name": { "const": "OPL-NAT-OPL-V6-WSL2-01" },
              "subnet": { "const": "172.28.102.0/24" },
              "guest_ip": { "const": "172.28.102.10" },
              "host_loopback_port_lease": { "const": "33101-33119" }
            }
          },
          "exclusive_paths": {
            "properties": {
              "guest": { "const": "C:\\OPL-VMs\\Guests\\OPL-V6-WSL2-01" },
              "config": { "const": "C:\\OPL-VMs\\Guests\\OPL-V6-WSL2-01\\Virtual Machines" },
              "evidence": { "const": "C:\\OPL-VMs\\Guests\\OPL-V6-WSL2-01\\Evidence" },
              "vhdx": { "const": "C:\\OPL-VMs\\Guests\\OPL-V6-WSL2-01\\Virtual Hard Disks\\OPL-V6-WSL2-01.vhdx" }
            }
          },
          "runtime_namespace": { "const": "OPL-V6-WSL2-01" },
          "receipt_namespace": { "const": "C:\\OPL-VMs\\Guests\\OPL-V6-WSL2-01\\Evidence" },
          "clean_vm_attestation": {
            "properties": {
              "path": { "const": "C:\\OPL-VMs\\Guests\\OPL-V6-WSL2-01\\Evidence\\clean-vm-attestation.json" }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "vm_name": { "const": "OPL-WEBUI-CLEAN-01" } }, "required": ["vm_name"] },
      "then": {
        "properties": {
          "lease_id": { "const": "opl-webui-clean-01" },
          "execution_owner_thread": { "const": "019f972b-f550-7961-90be-9873600cd895" },
          "next_owner_thread": { "const": "019f972b-f550-7961-90be-9873600cd895" },
          "config_path": { "const": "C:\\OPL-VMs\\Guests\\OPL-WEBUI-CLEAN-01\\Virtual Machines" },
          "active_vhdx_path": { "pattern": "^C:\\\\OPL-VMs\\\\Guests\\\\OPL-WEBUI-CLEAN-01\\\\Virtual Hard Disks\\\\.+\\.(?:avhdx|vhdx)$" },
          "vhdx_chain": { "items": { "$ref": "#/$defs/webuiVhdxEntry" } },
          "network": {
            "properties": {
              "current_switch": { "const": "OPL-NAT-OPL-WEBUI-CLEAN-01" },
              "nat_name": { "const": "OPL-NAT-OPL-WEBUI-CLEAN-01" },
              "subnet": { "const": "172.28.101.0/24" },
              "guest_ip": { "const": "172.28.101.10" },
              "host_loopback_port_lease": { "const": "33001-33019" }
            }
          },
          "exclusive_paths": {
            "properties": {
              "guest": { "const": "C:\\OPL-VMs\\Guests\\OPL-WEBUI-CLEAN-01" },
              "config": { "const": "C:\\OPL-VMs\\Guests\\OPL-WEBUI-CLEAN-01\\Virtual Machines" },
              "evidence": { "const": "C:\\OPL-VMs\\Guests\\OPL-WEBUI-CLEAN-01\\Evidence" },
              "vhdx": { "const": "C:\\OPL-VMs\\Guests\\OPL-WEBUI-CLEAN-01\\Virtual Hard Disks\\OPL-WEBUI-CLEAN-01.vhdx" }
            }
          },
          "runtime_namespace": { "const": "OPL-WEBUI-CLEAN-01" },
          "receipt_namespace": { "const": "C:\\OPL-VMs\\Guests\\OPL-WEBUI-CLEAN-01\\Evidence" },
          "clean_vm_attestation": {
            "properties": {
              "path": { "const": "C:\\OPL-VMs\\Guests\\OPL-WEBUI-CLEAN-01\\Evidence\\clean-vm-attestation.json" }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "gitSha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "uuid": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "cRootPath": { "type": "string", "pattern": "^C:\\\\OPL-VMs(?:\\\\.*)?$" },
    "vhdxEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "parent_path", "vhd_type", "file_size_bytes", "maximum_size_bytes"],
      "properties": {
        "path": { "$ref": "#/$defs/cRootPath" },
        "parent_path": { "oneOf": [{ "$ref": "#/$defs/cRootPath" }, { "type": "null" }] },
        "vhd_type": { "enum": ["Dynamic", "Differencing", "Fixed"] },
        "file_size_bytes": { "type": "integer", "minimum": 1 },
        "maximum_size_bytes": { "type": "integer", "minimum": 68719476736 }
      }
    },
    "v6VhdxEntry": {
      "allOf": [
        { "$ref": "#/$defs/vhdxEntry" },
        {
          "properties": {
            "path": { "pattern": "^C:\\\\OPL-VMs\\\\Guests\\\\OPL-V6-WSL2-01\\\\Virtual Hard Disks\\\\.+\\.(?:avhdx|vhdx)$" },
            "parent_path": {
              "oneOf": [
                { "type": "string", "pattern": "^C:\\\\OPL-VMs\\\\Guests\\\\OPL-V6-WSL2-01\\\\Virtual Hard Disks\\\\.+\\.(?:avhdx|vhdx)$" },
                { "type": "null" }
              ]
            }
          }
        }
      ]
    },
    "webuiVhdxEntry": {
      "allOf": [
        { "$ref": "#/$defs/vhdxEntry" },
        {
          "properties": {
            "path": { "pattern": "^C:\\\\OPL-VMs\\\\Guests\\\\OPL-WEBUI-CLEAN-01\\\\Virtual Hard Disks\\\\.+\\.(?:avhdx|vhdx)$" },
            "parent_path": {
              "oneOf": [
                { "type": "string", "pattern": "^C:\\\\OPL-VMs\\\\Guests\\\\OPL-WEBUI-CLEAN-01\\\\Virtual Hard Disks\\\\.+\\.(?:avhdx|vhdx)$" },
                { "type": "null" }
              ]
            }
          }
        }
      ]
    },
    "localization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["installation_media_language", "ui_language", "system_locale", "user_locale", "default_input_method_tip"],
      "properties": {
        "installation_media_language": { "const": "zh-CN" },
        "ui_language": { "const": "zh-CN" },
        "system_locale": { "const": "zh-CN" },
        "user_locale": { "const": "zh-CN" },
        "default_input_method_tip": { "const": "0804:00000804" }
      }
    }
  }
}
