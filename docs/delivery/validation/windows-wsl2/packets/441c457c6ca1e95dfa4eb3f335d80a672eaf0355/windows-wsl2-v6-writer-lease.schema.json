{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://one-person-lab.dev/schemas/windows-wsl2-v6-writer-lease.schema.json",
  "title": "OPL Windows V6 Hyper-V writer lease",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "status",
    "host_platform",
    "vm_name",
    "vm_identity",
    "platform_owner_task_id",
    "executor_task_id",
    "lease_id",
    "issued_at",
    "expires_at",
    "allowed_operations",
    "clean_vm_attestation"
  ],
  "properties": {
    "schema": {
      "const": "opl_windows_v6_vm_writer_lease.v1"
    },
    "status": {
      "const": "active"
    },
    "host_platform": {
      "const": "windows_hyperv"
    },
    "vm_name": {
      "const": "OPL-V6-WSL2-01"
    },
    "vm_identity": {
      "type": "string",
      "pattern": "^hyperv-vmid:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "platform_owner_task_id": {
      "const": "019f972b-f550-7961-90be-9873600cd895"
    },
    "executor_task_id": {
      "const": "019f97e4-288a-7140-8850-925c657d8c71"
    },
    "lease_id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{2,160}$"
    },
    "issued_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "allowed_operations": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "uniqueItems": true,
      "items": {
        "enum": [
          "v6_build_seal",
          "v6_fixture_phase_transition",
          "v6_guest_visible_smoke",
          "v6_soft_shutdown"
        ]
      },
      "allOf": [
        {
          "contains": {
            "const": "v6_build_seal"
          }
        },
        {
          "contains": {
            "const": "v6_fixture_phase_transition"
          }
        },
        {
          "contains": {
            "const": "v6_guest_visible_smoke"
          }
        },
        {
          "contains": {
            "const": "v6_soft_shutdown"
          }
        }
      ]
    },
    "clean_vm_attestation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "vm_id",
        "checkpoint_id",
        "attested_at"
      ],
      "properties": {
        "status": {
          "const": "attested"
        },
        "vm_id": {
          "$ref": "#/$defs/uuid"
        },
        "checkpoint_id": {
          "type": "string",
          "minLength": 3,
          "maxLength": 160
        },
        "attested_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  },
  "$defs": {
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    }
  }
}
