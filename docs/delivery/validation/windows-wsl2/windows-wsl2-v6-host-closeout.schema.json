{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://one-person-lab.dev/schemas/windows-wsl2-v6-host-closeout.schema.json",
  "title": "OPL Windows WSL2 V6 Hyper-V host closeout receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "validation_state",
    "assessment_scope",
    "terminal_v6_verdict",
    "status",
    "observed_at",
    "source_refs",
    "packet",
    "artifact",
    "vm",
    "writer_lease",
    "phase_evidence",
    "resource_cleanup",
    "writer_release",
    "capability_outcome",
    "error"
  ],
  "properties": {
    "schema": {
      "const": "opl_windows_wsl2_v6_host_closeout.v1"
    },
    "validation_state": {
      "const": "validation_only_non_binding"
    },
    "assessment_scope": {
      "const": "status_projection_only"
    },
    "terminal_v6_verdict": {
      "const": true
    },
    "status": {
      "const": "passed"
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "source_refs": {
      "$ref": "#/$defs/sourceRefs"
    },
    "packet": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "intake_manifest_sha256",
        "build_receipt_sha256"
      ],
      "properties": {
        "intake_manifest_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "build_receipt_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sha256",
        "file_name",
        "executable_sha256",
        "tree_sha256",
        "tree_file_count"
      ],
      "properties": {
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "file_name": {
          "const": "OPL-Windows-WSL2-Validation-v6.zip"
        },
        "executable_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "tree_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "tree_file_count": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "vm": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identity",
        "host_platform",
        "vm_name",
        "vm_id",
        "powered_off_readback",
        "final_state"
      ],
      "properties": {
        "identity": {
          "$ref": "#/$defs/vmIdentity"
        },
        "host_platform": {
          "const": "windows_hyperv"
        },
        "vm_name": {
          "const": "OPL-V6-WSL2-01"
        },
        "vm_id": {
          "$ref": "#/$defs/uuid"
        },
        "powered_off_readback": {
          "const": true
        },
        "final_state": {
          "const": "Off"
        }
      }
    },
    "writer_lease": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "receipt_sha256",
        "platform_owner_task_id",
        "executor_task_id",
        "lease_id",
        "issued_at",
        "expires_at"
      ],
      "properties": {
        "receipt_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "platform_owner_task_id": {
          "$ref": "#/$defs/uuid",
          "not": { "const": "019f9bc5-8707-78b2-b221-5453d9d9b855" }
        },
        "executor_task_id": {
          "$ref": "#/$defs/uuid",
          "not": { "const": "019f9bc5-8707-78b2-b221-5453d9d9b855" }
        },
        "lease_id": {
          "type": "string",
          "minLength": 3,
          "maxLength": 160
        },
        "issued_at": {
          "type": "string",
          "format": "date-time"
        },
        "expires_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "phase_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stopped",
        "running",
        "restart_persistence"
      ],
      "properties": {
        "stopped": {
          "$ref": "#/$defs/phaseEvidence"
        },
        "running": {
          "$ref": "#/$defs/phaseEvidence"
        },
        "restart_persistence": {
          "$ref": "#/$defs/phaseEvidence"
        }
      }
    },
    "resource_cleanup": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "guest_process_count",
        "guest_wsl_process_count",
        "guest_listener_count",
        "guest_writer_count",
        "host_process_count",
        "host_listener_count",
        "host_writer_count",
        "active_writer_lease_count",
        "status"
      ],
      "properties": {
        "guest_process_count": { "const": 0 },
        "guest_wsl_process_count": { "const": 0 },
        "guest_listener_count": { "const": 0 },
        "guest_writer_count": { "const": 0 },
        "host_process_count": { "const": 0 },
        "host_listener_count": { "const": 0 },
        "host_writer_count": { "const": 0 },
        "active_writer_lease_count": { "const": 0 },
        "status": { "const": "passed" }
      }
    },
    "writer_release": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "receipt_id",
        "released_at",
        "receipt_sha256",
        "process_count",
        "listener_count",
        "writer_count"
      ],
      "properties": {
        "status": {
          "const": "released"
        },
        "receipt_id": {
          "type": "string",
          "minLength": 3,
          "maxLength": 160
        },
        "released_at": {
          "type": "string",
          "format": "date-time"
        },
        "receipt_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "process_count": { "const": 0 },
        "listener_count": { "const": 0 },
        "writer_count": { "const": 0 }
      }
    },
    "capability_outcome": {
      "const": "visible_status_projection_passed_capabilities_remain_unverified"
    },
    "error": {
      "type": "null"
    }
  },
  "$defs": {
    "sourceRefs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "app_sha",
        "shell_sha",
        "framework_sha",
        "framework_tree_sha",
        "framework_cli_blob_git_sha",
        "framework_cli_blob_sha256"
      ],
      "properties": {
        "app_sha": {
          "$ref": "#/$defs/gitSha"
        },
        "shell_sha": {
          "$ref": "#/$defs/gitSha"
        },
        "framework_sha": {
          "$ref": "#/$defs/gitSha"
        },
        "framework_tree_sha": {
          "$ref": "#/$defs/gitSha"
        },
        "framework_cli_blob_git_sha": {
          "$ref": "#/$defs/gitSha"
        },
        "framework_cli_blob_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "gitSha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "vmIdentity": {
      "type": "string",
      "pattern": "^hyperv-vmid:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "phaseEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "receipt_sha256",
        "screenshot_sha256",
        "run_id",
        "tree_sha256",
        "tree_file_count",
        "build_receipt_sha256"
      ],
      "properties": {
        "receipt_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "screenshot_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "run_id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{2,80}$"
        },
        "tree_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "tree_file_count": {
          "type": "integer",
          "minimum": 1
        },
        "build_receipt_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    }
  }
}
