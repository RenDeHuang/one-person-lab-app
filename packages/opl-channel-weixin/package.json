{
  "name": "@one-person-lab/opl-channel-weixin",
  "version": "0.1.1",
  "private": true,
  "description": "Weixin iLink ChannelProvider capability package for OPL.",
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "files": [
    "dist/src",
    ".codex-plugin/plugin.json",
    "opl-package.json",
    "LICENSE",
    "NOTICE",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test dist/tests/*.test.js",
    "validate:manifests": "node scripts/validate-manifests.mjs",
    "verify": "npm run typecheck && npm test && npm run validate:manifests"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "Apache-2.0",
  "devDependencies": {
    "@types/node": "^24.3.0",
    "typescript": "^5.9.2"
  }
}
