{
  "name": "one-person-lab-app",
  "version": "1.9.25",
  "private": true,
  "type": "module",
  "description": "One Person Lab App product repository.",
  "license": "Apache-2.0",
  "scripts": {
    "postinstall": "node --experimental-strip-types scripts/validate-active-shell.ts --quick",
    "verify": "scripts/verify.sh",
    "ensure:shell": "node --experimental-strip-types scripts/ensure-active-shell.ts",
    "install:shell": "node --experimental-strip-types scripts/run-active-shell-command.ts bun install --frozen-lockfile",
    "start": "node --experimental-strip-types scripts/run-active-shell-command.ts bun run start",
    "start:multi": "node --experimental-strip-types scripts/run-active-shell-command.ts bun run start:multi",
    "webui": "node --experimental-strip-types scripts/run-active-shell-command.ts bun run webui",
    "package": "node --experimental-strip-types scripts/prepare-standard-release-payload.ts && node --experimental-strip-types scripts/run-active-shell-command.ts bun run package",
    "build": "node --experimental-strip-types scripts/prepare-standard-release-payload.ts && node --experimental-strip-types scripts/run-active-shell-command.ts bun run build",
    "build-mac": "node --experimental-strip-types scripts/prepare-standard-release-payload.ts && node --experimental-strip-types scripts/run-active-shell-command.ts bun run build-mac",
    "build-mac:arm64": "node --experimental-strip-types scripts/prepare-standard-release-payload.ts && node --experimental-strip-types scripts/run-active-shell-command.ts bun run build-mac:arm64",
    "build-mac:x64": "node --experimental-strip-types scripts/prepare-standard-release-payload.ts && node --experimental-strip-types scripts/run-active-shell-command.ts bun run build-mac:x64",
    "build-win": "node --experimental-strip-types scripts/prepare-standard-release-payload.ts && node --experimental-strip-types scripts/run-active-shell-command.ts bun run build-win",
    "build-deb": "node --experimental-strip-types scripts/prepare-standard-release-payload.ts && node --experimental-strip-types scripts/run-active-shell-command.ts bun run build-deb",
    "i18n:types": "node --experimental-strip-types scripts/run-active-shell-command.ts bun run i18n:types",
    "i18n:check": "node --experimental-strip-types scripts/run-active-shell-command.ts node scripts/check-i18n.js",
    "test": "node --experimental-strip-types scripts/run-active-shell-tests.ts",
    "test:coverage": "node --experimental-strip-types scripts/run-active-shell-command.ts bun run test:coverage",
    "test:contract": "node --experimental-strip-types scripts/run-active-shell-command.ts bun run test:contract",
    "test:e2e": "node --experimental-strip-types scripts/run-active-shell-command.ts bun run test:e2e",
    "test:packaged:bun": "node --experimental-strip-types scripts/run-active-shell-command.ts bun run validate:opl-package",
    "test:opl-first-run-vm": "node --experimental-strip-types scripts/run-active-shell-command.ts bun run test:opl-first-run-vm",
    "test:opl-first-run-vm:tart": "node --experimental-strip-types scripts/run-active-shell-command.ts bun run test:opl-first-run-vm:tart",
    "lint": "node --experimental-strip-types scripts/run-active-shell-command.ts bun run lint",
    "hygiene": "node --experimental-strip-types scripts/run-active-shell-command.ts bun run hygiene",
    "format": "node --experimental-strip-types scripts/run-active-shell-command.ts bun run format",
    "format:check": "node --experimental-strip-types scripts/run-active-shell-command.ts bun run format:check",
    "validate:packaged-runtime": "node --experimental-strip-types scripts/run-active-shell-command.ts bun run validate:packaged-runtime",
    "validate:opl-package": "node --experimental-strip-types scripts/run-active-shell-command.ts bun run validate:opl-package",
    "validate:app-root-boundary": "node --experimental-strip-types scripts/app-root-boundary.ts",
    "validate:active-shell": "node --experimental-strip-types scripts/validate-active-shell.ts",
    "validate:agent-installation": "node --experimental-strip-types scripts/validate-agent-installation-contract.ts",
    "validate:shell-candidates": "node --experimental-strip-types scripts/validate-shell-candidates.ts",
    "validate:gui-shell": "node --experimental-strip-types scripts/validate-active-shell.ts && node --experimental-strip-types scripts/prepare-standard-release-payload.ts && node --experimental-strip-types scripts/run-active-shell-command.ts bun run package",
    "validate:release-boundary": "node --experimental-strip-types scripts/validate-release-boundary.ts",
    "homebrew:tap:plan": "node --experimental-strip-types scripts/update-homebrew-tap.ts",
    "validate:homebrew-tap": "node --experimental-strip-types scripts/update-homebrew-tap.ts --self-check",
    "test:release-boundary": "node --experimental-strip-types --test tests/release/*.test.ts",
    "hygiene:fallow": "npx --yes fallow@latest --root . --no-cache --production",
    "docs:macos-guide": "npm run docs:macos-guide:html && npm run docs:macos-guide:slides && npm run docs:macos-guide:pdf",
    "docs:macos-guide:html": "node --experimental-strip-types scripts/build-user-guide-html.ts",
    "docs:macos-guide:pdf": "node --experimental-strip-types scripts/build-user-guide-pdf.ts",
    "docs:macos-guide:slides": "node --experimental-strip-types scripts/build-user-guide-slides.ts",
    "release:prepare-standard": "node --experimental-strip-types scripts/prepare-standard-release-payload.ts",
    "release:preflight": "node --experimental-strip-types scripts/validate-release-preflight.ts",
    "release:plan": "node --experimental-strip-types scripts/plan-release-candidate.ts",
    "release:closeout": "node --experimental-strip-types scripts/closeout-release-run.ts",
    "release:readiness-summary": "node --experimental-strip-types scripts/summarize-release-readiness.ts",
    "release:candidate-record": "node --experimental-strip-types scripts/write-release-candidate-record.ts",
    "release:candidate-record:validate": "node --experimental-strip-types scripts/validate-release-candidate-record.ts --promote-ready",
    "release:candidate-record:status": "node --experimental-strip-types scripts/validate-release-candidate-record.ts --status",
    "release:collect-evidence": "node --experimental-strip-types scripts/collect-release-evidence.ts",
    "release:evidence:manifest": "node --experimental-strip-types scripts/write-release-evidence-manifest.ts",
    "release:evidence:validate": "node --experimental-strip-types scripts/validate-release-evidence-bundle.ts",
    "prepare-release-assets": "node --experimental-strip-types scripts/prepare-release-assets.ts",
    "validate-release": "node --experimental-strip-types scripts/validate-release.ts",
    "verify-remote-release": "node --experimental-strip-types scripts/verify-remote-release-assets.ts",
    "verify:full-runtime-native-trust": "node --experimental-strip-types scripts/verify-full-runtime-native-trust.ts",
    "release:cleanup-drafts": "node --experimental-strip-types scripts/cleanup-draft-release-candidates.ts",
    "release:cleanup-webui-ghcr": "node --experimental-strip-types scripts/cleanup-webui-ghcr-versions.ts",
    "release:notes": "node --experimental-strip-types scripts/generate-release-notes.ts",
    "release:full:size": "node --experimental-strip-types scripts/analyze-full-package-size.ts",
    "release:full": "node --experimental-strip-types scripts/build-full-first-install-package.ts",
    "release:publish": "node --experimental-strip-types scripts/publish-release.ts"
  }
}
